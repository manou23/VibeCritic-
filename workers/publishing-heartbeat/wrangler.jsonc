{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibecritic-publishing-heartbeat",
  "main": "src/index.js",
  "compatibility_date": "2026-11-19",
  "triggers": {
    "crons": ["15 7,10,13,16,19 * * *"]
  }
}

