{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibecritic-ai-review-limiter",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_REVIEW_LIMITER",
        "class_name": "AiReviewLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AiReviewLimiter"]
    }
  ]
}
