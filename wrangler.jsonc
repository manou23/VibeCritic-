{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibecritic",
  "compatibility_date": "2026-11-13",
  "pages_build_output_dir": "./dist",
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_REVIEW_LIMITER",
        "class_name": "AiReviewLimiter",
        "script_name": "vibecritic-ai-review-limiter"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "ENTERTAINMENT_DB",
      "database_name": "entertainment-db",
      "database_id": "ec7b1c8f-c1e1-4f18-823c-de51ba468399"
    }
  ]
}
