{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "originalTitle": {
      "type": "string"
    },
    "storyScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "visualsScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "soundScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "pacingScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "platforms": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gameStores": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "headline": {
      "type": "string"
    },
    "hook": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "verdict": {
      "type": "string"
    },
    "reviewVersion": {
      "type": "number"
    },
    "type": {
      "type": "string",
      "enum": [
        "game",
        "movie",
        "series"
      ]
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "releaseDate": {
      "type": "string"
    },
    "poster": {
      "type": "string"
    },
    "backdrop": {
      "type": "string"
    },
    "youtubeVideoId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{11}$"
    },
    "youtubeVideoTitle": {
      "type": "string"
    },
    "externalVideoUrl": {
      "type": "string",
      "format": "uri"
    },
    "externalVideoTitle": {
      "type": "string"
    },
    "score": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10
    },
    "reviewMode": {
      "default": "review",
      "type": "string",
      "enum": [
        "review",
        "preview",
        "limited"
      ]
    },
    "sourceName": {
      "type": "string"
    },
    "sourceVoteCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sourceRatingScale": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "metacriticScore": {
      "type": "number",
      "minimum": 0
    },
    "cast": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "crew": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "watchProviders": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "watchProviderUrl": {
      "type": "string",
      "format": "uri"
    },
    "pros": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "genres": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "creator": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "sourceRating": {
      "type": "number"
    },
    "sourceId": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string"
    },
    "aiGenerated": {
      "default": true,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "headline",
    "summary",
    "type",
    "date",
    "pros",
    "cons",
    "sourceId"
  ]
}