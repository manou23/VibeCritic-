---
import '../styles/global.css';
import { SITE_NAME, SITE_DESC, url } from '../consts';
const { title = SITE_NAME, description = SITE_DESC } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="description" content={description} /><meta name="theme-color" content="#f3f0e8" />
<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} />
<title>{title} | {SITE_NAME}</title>
</head>
<body>
<header class="site-header">
<div class="wrap site-nav">
<a href={url('')} class="brand" aria-label="VibeCritic الصفحة الرئيسية"><span>Vibe</span><span class="brand-accent">Critic</span><small>THE REVIEW JOURNAL</small></a>
<nav class="site-links" aria-label="التنقل الرئيسي">
<a href={url('')}>الرئيسية</a><a href={url('category/game/')}>الألعاب</a><a href={url('category/movie/')}>الأفلام</a><a href={url('category/series/')}>المسلسلات</a>
</nav>
<button id="theme-toggle" aria-label="تبديل المظهر" class="theme-toggle" type="button">◐</button>
</div>
</header>
<main><slot /></main>
<footer class="site-footer">
<div class="wrap">
<p>© {new Date().getFullYear()} {SITE_NAME}. نراجع بوضوح، ونترك القرار لك.</p>
<p>بيانات الأفلام والمسلسلات مقدمة عبر <a href="https://www.themoviedb.org/" target="_blank" rel="noreferrer">TMDb</a>. هذا المنتج يستخدم TMDb API لكنه غير معتمد أو مصادق عليه من TMDb.</p>
<p>بيانات الألعاب مقدمة عبر <a href="https://www.igdb.com/" target="_blank" rel="noreferrer">IGDB</a>.</p>
</div>
</footer>
<script is:inline>
const btn=document.getElementById('theme-toggle');
const saved=localStorage.getItem('vc-theme');
if(saved==='dark'){document.documentElement.classList.add('dark-mode');}
btn?.addEventListener('click',()=>{document.documentElement.classList.toggle('dark-mode');localStorage.setItem('vc-theme',document.documentElement.classList.contains('dark-mode')?'dark':'light')});
</script>
</body></html>
