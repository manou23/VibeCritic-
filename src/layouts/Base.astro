---
import '../styles/global.css';
import PagefindConfig from 'astro-pagefind/components/PagefindConfig.astro';
import { SITE_NAME, SITE_DESC, url } from '../consts';
const {
  title = SITE_NAME,
  description = SITE_DESC,
  image = '',
  pageType = 'website',
  publishedAt = '',
  noindex = false,
  keywords = [],
  structuredData: pageStructuredData = null,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const rawTitle = `${title} | ${SITE_NAME}`;
const pageTitle = rawTitle.length > 60 ? `${String(title).slice(0, 46).trimEnd()}… | ${SITE_NAME}` : rawTitle;
const metaDescription = String(description).replace(/\s+/g, ' ').trim().slice(0, 152).trimEnd() + (String(description).trim().length > 152 ? '…' : '');
const metaKeywords = Array.isArray(keywords) ? [...new Set(keywords.map((word) => String(word).replace(/[<>\"']/g, '').replace(/\s+/g, ' ').trim()).filter(Boolean))].slice(0, 20).join(', ') : '';
const structuredData = pageStructuredData || (pageType === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      mainEntityOfPage: canonical,
      ...(image ? { image: [image] } : {}),
      ...(publishedAt ? { datePublished: publishedAt } : {}),
      publisher: { '@type': 'Organization', name: SITE_NAME },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE_NAME,
      url: Astro.site?.href || canonical,
      inLanguage: 'ar',
    });
const safeJson = (value) => JSON.stringify(value).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<link rel="preconnect" href="https://image.tmdb.org" crossorigin />
<link rel="preconnect" href="https://images.igdb.com" crossorigin />
<link rel="preconnect" href="https://media.rawg.io" crossorigin />
<script is:inline>try{if(localStorage.getItem("vc-theme")==="dark")document.documentElement.classList.add("dark-mode")}catch{}</script>
<meta name="description" content={metaDescription} />
{metaKeywords && <meta name="keywords" content={metaKeywords} />}
<meta name="theme-color" content="#f3f0e8" />
<meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
<link rel="canonical" href={canonical} />
<meta property="og:locale" content="ar_DZ" />
<meta property="og:type" content={pageType === 'article' ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={metaDescription} />
{image && <><meta property="og:image" content={image} /><meta property="og:image:alt" content={title} /></>}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={metaDescription} />
{image && <meta name="twitter:image" content={image} />}
<title>{pageTitle}</title>
<script type="application/ld+json" set:html={safeJson(structuredData)}></script>
</head>
<body>
<a class="skip-link" href="#main-content">تجاوز إلى المحتوى</a>
<header class="site-header">
 <div class="wrap site-nav">
  <a href={url('')} class="brand" aria-label="VibeCritic الصفحة الرئيسية"><span>Vibe</span><span class="brand-accent">Critic</span><small>THE ENTERTAINMENT GUIDE</small></a>
  <button class="menu-toggle" id="menu-toggle" type="button" aria-label="فتح القائمة" aria-expanded="false" aria-controls="primary-navigation"><span></span><span></span><span></span></button>
  <nav class="site-links" id="primary-navigation" aria-label="التنقل الرئيسي">
   <a href={url('')}>الرئيسية</a><a href={url('category/game/')}>الألعاب</a><a href={url('category/movie/')}>الأفلام</a><a href={url('category/series/')}>المسلسلات</a><a href={url('ai-review/')}>المراجع الذكي</a>
  </nav>
  <button class="header-search" id="site-search-open" type="button" aria-haspopup="dialog" aria-controls="site-search-dialog"><span aria-hidden="true">⌕</span><span class="header-search-label">بحث</span></button>
  <button id="theme-toggle" class="theme-toggle" type="button" aria-label="تبديل المظهر" aria-pressed="false">◐</button>
 </div>
</header>
<dialog class="site-search-dialog" id="site-search-dialog" aria-labelledby="site-search-title">
 <div class="site-search-panel">
  <div class="site-search-heading">
   <div><p class="catalog-eyebrow">VIBECRITIC SEARCH</p><h2 id="site-search-title">ابحث في مكتبة VibeCritic</h2></div>
   <button class="site-search-close" id="site-search-close" type="button" aria-label="إغلاق البحث">×</button>
  </div>
  <p class="site-search-hint">بحث فوري في نصوص وعناوين جميع المراجعات المنشورة.</p>
  <PagefindConfig />
  <pagefind-searchbox placeholder="ابحث عن لعبة أو فيلم أو مسلسل..." max-results="12" hide-shortcut></pagefind-searchbox>
 </div>
</dialog>

<main id="main-content" data-pagefind-body><slot /></main>
<footer class="site-footer">
 <div class="wrap footer-inner">
  <a href={url('')} class="footer-brand">Vibe<span>Critic</span></a>
  <p>© {new Date().getFullYear()} {SITE_NAME}. نراجع بوضوح، ونترك القرار لك.</p>
  <details class="footer-sources">
   <summary>مصدر البيانات</summary>
   <p>بيانات الأفلام والمسلسلات مقدمة عبر <a href="https://www.themoviedb.org/" target="_blank" rel="noopener noreferrer">TMDb</a>. هذا المنتج يستخدم TMDb API لكنه غير معتمد أو مصادق عليه من TMDb.</p>
   <p>بيانات الألعاب مقدمة عبر <a href="https://rawg.io/" target="_blank" rel="noopener noreferrer">RAWG</a>، وقد يُستخدم <a href="https://www.igdb.com/" target="_blank" rel="noopener noreferrer">IGDB</a> كمصدر احتياطي.</p>
  </details>
 </div>
</footer>
<script>
const menuButton = document.getElementById('menu-toggle');
const primaryNavigation = document.getElementById('primary-navigation');
const closeMenu = () => {
  primaryNavigation?.classList.remove('is-open');
  menuButton?.setAttribute('aria-expanded', 'false');
  menuButton?.setAttribute('aria-label', 'فتح القائمة');
};
menuButton?.addEventListener('click', () => {
  const open = primaryNavigation?.classList.toggle('is-open') ?? false;
  menuButton.setAttribute('aria-expanded', String(open));
  menuButton.setAttribute('aria-label', open ? 'إغلاق القائمة' : 'فتح القائمة');
});
primaryNavigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
document.addEventListener('click', (event) => {
  if (event.target instanceof Node && !primaryNavigation?.contains(event.target) && !menuButton?.contains(event.target)) closeMenu();
});

const themeButton = document.getElementById('theme-toggle');
try {
  const savedTheme = localStorage.getItem('vc-theme');
  document.documentElement.classList.toggle('dark-mode', savedTheme !== 'light');
} catch {}
const updateThemeButton = () => {
  const dark = document.documentElement.classList.contains('dark-mode');
  themeButton?.setAttribute('aria-pressed', String(dark));
  themeButton?.setAttribute('aria-label', dark ? 'التبديل إلى الوضع الفاتح' : 'التبديل إلى الوضع المظلم');
  document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#0d0f12' : '#f3f0e8');
  if (themeButton) themeButton.textContent = dark ? '☀' : '☾';
};
updateThemeButton();
themeButton?.addEventListener('click', () => {
  const dark = document.documentElement.classList.toggle('dark-mode');
  try { localStorage.setItem('vc-theme', dark ? 'dark' : 'light'); } catch {}
  updateThemeButton();
});

const searchDialog = document.getElementById('site-search-dialog');
const searchOpen = document.getElementById('site-search-open');
const searchClose = document.getElementById('site-search-close');
searchOpen?.addEventListener('click', () => {
  if (searchDialog instanceof HTMLDialogElement && !searchDialog.open) searchDialog.showModal();
});
searchClose?.addEventListener('click', () => {
  if (searchDialog instanceof HTMLDialogElement) searchDialog.close();
});
searchDialog?.addEventListener('click', (event) => {
  if (event.target === searchDialog && searchDialog instanceof HTMLDialogElement) searchDialog.close();
});</script>
</body>
</html>
