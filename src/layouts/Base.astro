---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import PagefindConfig from 'astro-pagefind/components/PagefindConfig.astro';
import { SITE_NAME, SITE_DESC, url } from '../consts';
const {
  title = SITE_NAME,
  description = SITE_DESC,
  image = '',
  pageType = 'website',
  publishedAt = '',
  articleSection = '',
  noindex = false,
  keywords = [],
  structuredData: pageStructuredData = null,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const isHomePage = Astro.url.pathname === '/';
const currentPath = Astro.url.pathname.replace(/\/+$/, '/') || '/';
const navIsCurrent = (path) => path === '/' ? currentPath === '/' : currentPath === path || currentPath.startsWith(path);
const rawTitle = isHomePage ? `${SITE_NAME} | ${title}` : `${title} | ${SITE_NAME}`;
const pageTitle = rawTitle.length > 60 ? `${String(title).slice(0, 46).trimEnd()}… | ${SITE_NAME}` : rawTitle;
const metaDescription = String(description).replace(/\s+/g, ' ').trim().slice(0, 152).trimEnd() + (String(description).trim().length > 152 ? '…' : '');
const metaKeywords = Array.isArray(keywords) ? [...new Set(keywords.map((word) => String(word).replace(/[<>\"']/g, '').replace(/\s+/g, ' ').trim()).filter(Boolean))].slice(0, 20).join(', ') : '';
const siteUrl = Astro.site?.href || new URL('/', canonical).href;
const organizationId = new URL('/#organization', siteUrl).href;
const websiteId = new URL('/#website', siteUrl).href;
const { ['@context']: _pageSchemaContext, ...providedPageSchema } = pageStructuredData || {};
const pageNode = pageStructuredData
  ? { ...providedPageSchema, '@id': pageStructuredData['@id'] || `${canonical}#review` }
  : {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      name: title,
      description: metaDescription,
      url: canonical,
      isPartOf: { '@id': websiteId },
      inLanguage: 'ar',
      ...(image ? { primaryImageOfPage: image } : {}),
    };
const breadcrumbItems = [{ name: 'الرئيسية', item: new URL('/', siteUrl).href }];
if (!isHomePage) {
  if (currentPath.startsWith('/magazine/') && currentPath !== '/magazine/') {
    breadcrumbItems.push({ name: 'المجلة', item: new URL('/magazine/', siteUrl).href });
  } else if (currentPath.startsWith('/reviews/')) {
    const reviewCategory = ({ 'لعبة': ['game', 'الألعاب'], 'فيلم': ['movie', 'الأفلام'], 'مسلسل': ['series', 'المسلسلات'] })[articleSection];
    if (reviewCategory) {
      breadcrumbItems.push({
        name: reviewCategory[1],
        item: new URL(`/category/${reviewCategory[0]}/`, siteUrl).href,
      });
    }
  }
  breadcrumbItems.push({ name: title, item: canonical });
}
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: SITE_NAME,
      url: siteUrl,
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: SITE_NAME,
      alternateName: ['Vibe Critic'],
      description: SITE_DESC,
      url: siteUrl,
      inLanguage: 'ar',
      publisher: { '@id': organizationId },
    },
    pageNode,
    ...(breadcrumbItems.length > 1 ? [{
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: breadcrumbItems.map((crumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.name,
        item: crumb.item,
      })),
    }] : []),
  ],
};
const safeJson = (value) => JSON.stringify(value).replace(/</g, '\\u003c');
const searchReviews = await getCollection('reviews');
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<link rel="preconnect" href="https://image.tmdb.org" crossorigin />
<link rel="preconnect" href="https://images.igdb.com" crossorigin />
<link rel="preconnect" href="https://media.rawg.io" crossorigin />
<script is:inline>try{const savedTheme=localStorage.getItem("vc-theme");document.documentElement.classList.toggle("dark-mode",savedTheme!=="light")}catch{document.documentElement.classList.add("dark-mode")}</script>
<meta name="description" content={metaDescription} />
<meta name="application-name" content="VibeCritic" />
{metaKeywords && <meta name="keywords" content={metaKeywords} />}
<meta name="theme-color" content="#f3f0e8" />
<meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
<link rel="icon" type="image/png" sizes="96x96" href={url('favicon-96.png')} />
<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
<link rel="apple-touch-icon" sizes="180x180" href={url('apple-touch-icon.png')} />
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title="VibeCritic RSS" href={url('rss.xml')} />
<meta property="og:locale" content="ar_DZ" />
<meta property="og:type" content={pageType === 'article' ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:url" content={canonical} />
{pageType === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt} />}
{pageType === 'article' && articleSection && <meta property="article:section" content={articleSection} />}
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={metaDescription} />
{image && <><meta property="og:image" content={image} /><meta property="og:image:alt" content={title} /></>}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={metaDescription} />
{image && <meta name="twitter:image" content={image} />}
<meta name="google-adsense-account" content="ca-pub-8292052707705243" />
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8292052707705243" crossorigin="anonymous"></script>
<title>{pageTitle}</title>
<script type="application/ld+json" set:html={safeJson(structuredData)}></script>
<!-- Google Analytics 4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-D3CS5WFPFY"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){window.dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-D3CS5WFPFY');
</script>
</head>
<body>
<a class="skip-link" href="#main-content">تجاوز إلى المحتوى</a>
<header class="site-header">
 <div class="wrap site-nav">
  <a href={url('')} class="brand" aria-label="VibeCritic الصفحة الرئيسية"><span class="brand-copy"><svg class="vc-signature" viewBox="0 0 112 58" role="img" aria-label="VibeCritic"><defs><linearGradient id="vc-mark-gradient" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="var(--vc-text)"/><stop offset="1" stop-color="var(--vc-accent)"/></linearGradient></defs><text class="vc-wordmark" x="56" y="34" text-anchor="middle" textLength="99" lengthAdjust="spacingAndGlyphs" ><tspan fill="url(#vc-mark-gradient)">Vibe</tspan><tspan fill="var(--vc-accent)">Critic</tspan></text><g class="vc-orbit-system"><ellipse class="vc-orbit" cx="56" cy="29" rx="49" ry="22" fill="none"/><circle class="vc-orbit-point" cx="105" cy="29" r="2.1"/></g><circle class="vc-impact-ring" cx="56" cy="29" r="8" fill="none"/><g class="vc-symbol"><path class="vc-mark-v" d="M7 10h13l15 34 15-34h13L40 53H30z" fill="url(#vc-mark-gradient)"/><path class="vc-mark-c" d="M94 15C87 8 79 5 69 5 51 5 40 17 40 31s11 26 29 26c10 0 18-3 25-10l-9-8c-4 4-9 6-15 6-10 0-17-6-17-14s7-14 17-14c6 0 11 2 15 6z" fill="var(--vc-accent)"/><path class="vc-mark-star" d="M87 0l4 9 9 4-9 4-4 9-4-9-9-4 9-4z" fill="var(--vc-accent)"/><g class="vc-mark-shards" fill="var(--vc-accent)"><path d="M8 4l5 2-3 6z"/><path d="M103 32l7 2-6 5z"/><path d="M19 49l5 4-7 2z"/></g></g></svg><small>REAL TAKES. HONEST REVIEWS.</small></span></a>
  <button class="menu-toggle" id="menu-toggle" type="button" aria-label="فتح القائمة" aria-expanded="false" aria-controls="primary-navigation"><span></span><span></span><span></span></button>
  <nav class="site-links" id="primary-navigation" aria-label="التنقل الرئيسي">
   <a href={url('')} aria-current={navIsCurrent('/') ? 'page' : undefined}>الرئيسية</a><a href={url('catalog/')} aria-current={navIsCurrent('/catalog/') ? 'page' : undefined}>الكتالوج</a><a href={url('category/game/')} aria-current={navIsCurrent('/category/game/') ? 'page' : undefined}>الألعاب</a><a href={url('category/movie/')} aria-current={navIsCurrent('/category/movie/') ? 'page' : undefined}>الأفلام</a><a href={url('category/series/')} aria-current={navIsCurrent('/category/series/') ? 'page' : undefined}>المسلسلات</a><a href={url('magazine/')} aria-current={navIsCurrent('/magazine/') ? 'page' : undefined}>المجلة</a><a href={url('ai-review/')} aria-current={navIsCurrent('/ai-review/') ? 'page' : undefined}>المراجع الذكي</a>
  </nav>
  <button class="header-search" id="site-search-open" type="button" aria-haspopup="dialog" aria-controls="site-search-dialog"><span aria-hidden="true">⌕</span><span class="header-search-label">بحث</span></button>
  <button id="theme-toggle" class="theme-toggle" type="button" aria-label="تبديل المظهر" aria-pressed="false">◐</button>
 </div>
</header>
<dialog class="site-search-dialog" id="site-search-dialog" aria-labelledby="site-search-title">
 <div class="site-search-panel">
  <div class="site-search-heading">
   <div><p class="catalog-eyebrow">VIBECRITIC SEARCH</p><h2 id="site-search-title">ابحث في مكتبة VibeCritic</h2></div>
   <button class="site-search-close" id="site-search-close" type="button" aria-label="إغلاق البحث">×</button>
  </div>
  <p class="site-search-hint">بحث عربي ذكي يدعم اختلاف الألف والهمزة والتاء المربوطة والتشكيل، مع اقتراحات فورية.</p>
  <PagefindConfig />
  <div class="site-search-enhanced">
   <label for="normalized-site-search">عنوان العمل أو كلمة من المراجعة</label>
   <input id="normalized-site-search" type="search" list="normalized-site-suggestions" placeholder="مثال: إنتَرستيلر أو Minecraft" autocomplete="off"/>
   <datalist id="normalized-site-suggestions">{searchReviews.map(entry=><option value={entry.data.title}/>)}{searchReviews.filter(entry=>entry.data.originalTitle).map(entry=><option value={entry.data.originalTitle}/>)}</datalist>
   <div id="normalized-site-results" class="site-search-results" aria-live="polite"><p>ابدأ الكتابة لعرض المراجعات المطابقة.</p></div>
   <div class="site-search-index" hidden>{searchReviews.map(entry=><i data-site-search-entry data-title={entry.data.title} data-search={[entry.data.title,entry.data.originalTitle,entry.data.headline,entry.data.summary,...(entry.data.tags||[]),...(entry.data.genres||[])].filter(Boolean).join(' ')} data-href={url('reviews/'+entry.id+'/')} data-summary={entry.data.summary} data-type={entry.data.type}/>)}</div>
  </div>
 </div>
</dialog>

<main id="main-content" data-pagefind-body><slot /></main>
<footer class="site-footer">
 <div class="wrap footer-inner">
  <a href={url('')} class="footer-brand" aria-label="VibeCritic الصفحة الرئيسية"><span class="footer-brand-copy"><svg class="vc-signature" viewBox="0 0 112 58" role="img" aria-label="VibeCritic"><defs><linearGradient id="vc-mark-gradient" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="var(--vc-text)"/><stop offset="1" stop-color="var(--vc-accent)"/></linearGradient></defs><text class="vc-wordmark" x="56" y="34" text-anchor="middle" textLength="99" lengthAdjust="spacingAndGlyphs" ><tspan fill="url(#vc-mark-gradient)">Vibe</tspan><tspan fill="var(--vc-accent)">Critic</tspan></text><g class="vc-orbit-system"><ellipse class="vc-orbit" cx="56" cy="29" rx="49" ry="22" fill="none"/><circle class="vc-orbit-point" cx="105" cy="29" r="2.1"/></g><circle class="vc-impact-ring" cx="56" cy="29" r="8" fill="none"/><g class="vc-symbol"><path class="vc-mark-v" d="M7 10h13l15 34 15-34h13L40 53H30z" fill="url(#vc-mark-gradient)"/><path class="vc-mark-c" d="M94 15C87 8 79 5 69 5 51 5 40 17 40 31s11 26 29 26c10 0 18-3 25-10l-9-8c-4 4-9 6-15 6-10 0-17-6-17-14s7-14 17-14c6 0 11 2 15 6z" fill="var(--vc-accent)"/><path class="vc-mark-star" d="M87 0l4 9 9 4-9 4-4 9-4-9-9-4 9-4z" fill="var(--vc-accent)"/><g class="vc-mark-shards" fill="var(--vc-accent)"><path d="M8 4l5 2-3 6z"/><path d="M103 32l7 2-6 5z"/><path d="M19 49l5 4-7 2z"/></g></g></svg><small>REAL TAKES. HONEST REVIEWS.</small></span></a>
  <p>© {new Date().getFullYear()} {SITE_NAME}. نراجع بوضوح، ونترك القرار لك.</p>
  <nav class="footer-legal-links" aria-label="معلومات الموقع"><a href={url('about/')}>من نحن</a><a href={url('privacy/')}>سياسة الخصوصية</a><a href={url('contact/')}>اتصل بنا</a><a href={url('rss.xml')}>RSS</a></nav>
  <details class="footer-sources">
   <summary>مصدر البيانات</summary>
   <p>بيانات الأفلام والمسلسلات مقدمة عبر <a href="https://www.themoviedb.org/" target="_blank" rel="noopener noreferrer">TMDb</a>. هذا المنتج يستخدم TMDb API لكنه غير معتمد أو مصادق عليه من TMDb.</p>
   <p>بيانات الألعاب مقدمة عبر <a href="https://rawg.io/" target="_blank" rel="noopener noreferrer">RAWG</a>، وقد يُستخدم <a href="https://www.igdb.com/" target="_blank" rel="noopener noreferrer">IGDB</a> كمصدر احتياطي.</p>
  </details>
 </div>
</footer>
<script>
const menuButton = document.getElementById('menu-toggle');
const primaryNavigation = document.getElementById('primary-navigation');
const closeMenu = () => {
  primaryNavigation?.classList.remove('is-open');
  menuButton?.setAttribute('aria-expanded', 'false');
  menuButton?.setAttribute('aria-label', 'فتح القائمة');
};
menuButton?.addEventListener('click', () => {
  const open = primaryNavigation?.classList.toggle('is-open') ?? false;
  menuButton.setAttribute('aria-expanded', String(open));
  menuButton.setAttribute('aria-label', open ? 'إغلاق القائمة' : 'فتح القائمة');
});
primaryNavigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
document.addEventListener('keydown', (event) => {
  if (event.key !== 'Escape') return;
  const wasOpen = primaryNavigation?.classList.contains('is-open');
  closeMenu();
  if (wasOpen) menuButton?.focus();
});
document.addEventListener('click', (event) => {
  if (event.target instanceof Node && !primaryNavigation?.contains(event.target) && !menuButton?.contains(event.target)) closeMenu();
});

const themeButton = document.getElementById('theme-toggle');
try {
  const savedTheme = localStorage.getItem('vc-theme');
  document.documentElement.classList.toggle('dark-mode', savedTheme !== 'light');
} catch {}
const updateThemeButton = () => {
  const dark = document.documentElement.classList.contains('dark-mode');
  themeButton?.setAttribute('aria-pressed', String(dark));
  themeButton?.setAttribute('aria-label', dark ? 'التبديل إلى الوضع الفاتح' : 'التبديل إلى الوضع المظلم');
  document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#0d0f12' : '#f3f0e8');
  if (themeButton) themeButton.textContent = dark ? '☀' : '☾';
};
updateThemeButton();
themeButton?.addEventListener('click', () => {
  const dark = document.documentElement.classList.toggle('dark-mode');
  try { localStorage.setItem('vc-theme', dark ? 'dark' : 'light'); } catch {}
  updateThemeButton();
});

const searchDialog = document.getElementById('site-search-dialog');
const searchOpen = document.getElementById('site-search-open');
const searchClose = document.getElementById('site-search-close');
searchOpen?.addEventListener('click', () => {
  if (searchDialog instanceof HTMLDialogElement && !searchDialog.open) { searchDialog.showModal(); requestAnimationFrame(() => document.getElementById('normalized-site-search')?.focus({ preventScroll: true })); }
});
searchDialog?.addEventListener('close', () => searchOpen?.focus());
searchClose?.addEventListener('click', () => {
  if (searchDialog instanceof HTMLDialogElement) searchDialog.close();
});
searchDialog?.addEventListener('click', (event) => {
  if (event.target === searchDialog && searchDialog instanceof HTMLDialogElement) searchDialog.close();
});

const normalizedSearchInput=document.getElementById('normalized-site-search');
const normalizedSearchResults=document.getElementById('normalized-site-results');
const normalizedSearchEntries=[...document.querySelectorAll<HTMLElement>('[data-site-search-entry]')].map(entry=>({title:entry.dataset.title||'',search:entry.dataset.search||entry.dataset.title||'',href:entry.dataset.href||'',summary:entry.dataset.summary||'',type:entry.dataset.type||''}));
const normalizeArabicSearch=(value:string)=>String(value||'').toLocaleLowerCase('ar').normalize('NFKD').replace(/\p{M}/gu,'').replace(/[أإآٱ]/g,'ا').replace(/ة/g,'ه').replace(/ى/g,'ي').replace(/ؤ/g,'و').replace(/ئ/g,'ي').replace(/[^\p{L}\p{N}\s]/gu,' ').trim().replace(/\s+/g,' ');
normalizedSearchInput?.addEventListener('input',()=>{
 if(!normalizedSearchResults||!(normalizedSearchInput instanceof HTMLInputElement))return;
 const query=normalizeArabicSearch(normalizedSearchInput.value);
 normalizedSearchResults.replaceChildren();
 if(!query){const hint=document.createElement('p');hint.textContent='ابدأ الكتابة لعرض المراجعات المطابقة.';normalizedSearchResults.append(hint);return;}
 const matches=normalizedSearchEntries.filter(item=>normalizeArabicSearch(item.search).includes(query)).slice(0,10);
 if(!matches.length){const empty=document.createElement('p');empty.textContent='لا توجد مراجعات مطابقة. جرّب كتابة جزء آخر من الاسم.';normalizedSearchResults.append(empty);return;}
 for(const item of matches){const link=document.createElement('a');link.className='site-search-result';link.href=item.href;const title=document.createElement('strong');title.textContent=item.title;const summary=document.createElement('span');summary.textContent=item.summary;link.append(title,summary);normalizedSearchResults.append(link);}
});</script>
</body>
</html>
