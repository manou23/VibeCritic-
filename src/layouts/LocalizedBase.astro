---
import '../styles/global.css';
import { LOCALE_META, type Locale } from '../i18n/config';
import { getCollection } from 'astro:content';
const { locale } = Astro.props as { locale: Locale };
const meta = LOCALE_META[locale];
const localizedReviews = (await getCollection('reviews', ({ data }) => data.locale === locale)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const copy = {
  en: { home:'Home', games:'Games · Arabic', movies:'Movies · Arabic', series:'Series · Arabic', search:'Search', title:'VibeCritic search', note:'Search the current Arabic review library.', placeholder:'Search games, films or series...', intro:'The VibeCritic experience, now expanding globally.', sources:'Data sources', footer:'Honest reviews. Your decision.' },
  fr: { home:'Accueil', games:'Jeux · arabe', movies:'Films · arabe', series:'Séries · arabe', search:'Recherche', title:'Recherche VibeCritic', note:'Recherchez dans la bibliothèque actuelle de critiques en arabe.', placeholder:'Rechercher jeux, films ou séries...', intro:'L’expérience VibeCritic s’ouvre progressivement au monde.', sources:'Sources des données', footer:'Des critiques honnêtes. À vous de choisir.' },
}[locale];
const home = locale === 'en' ? '/en/' : '/fr/';
---
<!doctype html>
<html lang={meta.htmlLang} dir={meta.direction}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<meta name="description" content={locale === 'en' ? 'Discover games, films and series with VibeCritic. English edition coming soon.' : 'Découvrez jeux, films et séries avec VibeCritic. Édition française bientôt disponible.'} />
<meta name="robots" content="index,follow" />
<link rel="canonical" href={new URL(home, Astro.site).href} />
<meta property="og:locale" content={meta.ogLocale} />
<meta property="og:site_name" content="VibeCritic" />
<title>{locale === 'en' ? 'VibeCritic | English' : 'VibeCritic | Français'}</title>
<script is:inline>try{const savedTheme=localStorage.getItem("vc-theme");document.documentElement.classList.toggle("dark-mode",savedTheme!=="light")}catch{document.documentElement.classList.add("dark-mode")}</script>
</head>
<body>
<header class="site-header"><div class="wrap site-nav">
<a href={home} class="brand" aria-label="VibeCritic"><span>Vibe</span><span class="brand-accent">Critic</span><small>THE ENTERTAINMENT GUIDE</small></a>
<nav class="site-links" aria-label="Main navigation">
<a href={home}>{copy.home}</a><a href="/category/game/">{copy.games}</a><a href="/category/movie/">{copy.movies}</a><a href="/category/series/">{copy.series}</a>
</nav>
<details class="language-picker"><summary aria-label="Language">🌐 <span>{locale.toUpperCase()}</span></summary><div class="language-options"><a href="/" lang="ar">العربية</a><a href="/en/" lang="en">English</a><a href="/fr/" lang="fr">Français</a></div></details>
</div></header>
<main id="main-content" class="wrap localized-landing">
<p class="catalog-eyebrow">VIBECRITIC / {locale.toUpperCase()} EDITION</p>
<h1>{locale === 'en' ? 'A sharper perspective on entertainment.' : 'Un regard plus juste sur le divertissement.'}</h1>
<p class="localized-lead">{copy.intro}</p>
<div class="localized-notice">
<strong>{locale === 'en' ? 'The first translated reviews are now available.' : 'Les premières critiques traduites sont disponibles.'}</strong>
<p>{locale === 'en' ? 'This pilot collection includes one game, one film and one series. Each translation preserves the original VibeCritic score and editorial position. The full Arabic library remains available.' : 'Cette collection pilote comprend un jeu, un film et une série. Chaque traduction conserve la note et le point de vue éditorial de la version arabe. La bibliothèque arabe complète reste accessible.'}</p>
<a class="localized-cta" href="/">{locale === 'en' ? 'Explore the Arabic edition' : 'Découvrir l’édition arabe'} ↗</a>
</div>
<section class="localized-pilot">
  <h2>{locale === 'en' ? 'Pilot reviews' : 'Critiques pilotes'}</h2>
  <div class="localized-review-grid">
    {localizedReviews.map((review) => <a href={`/${locale}/reviews/${review.id.replace(/^(en|fr)\\//, '')}/`} class="localized-review-card">
      {review.data.poster && <img src={review.data.poster} alt="" loading="lazy" />}
      <span>{review.data.type === 'game' ? (locale === 'en' ? 'GAME' : 'JEU') : review.data.type === 'movie' ? (locale === 'en' ? 'FILM' : 'FILM') : (locale === 'en' ? 'SERIES' : 'SÉRIE')}</span>
      <strong>{review.data.title}</strong>
      <small>{review.data.score.toFixed(1)} / 10 · {locale === 'en' ? 'Read review' : 'Lire la critique'} ↗</small>
    </a>)}
  </div>
</section>
<section class="localized-categories">
<h2>{locale === 'en' ? 'Explore the library' : 'Explorer la bibliothèque'}</h2>
<div class="localized-category-grid">
<a href="/category/movie/"><span>◉</span><strong>{locale === 'en' ? 'Movies' : 'Films'}</strong><small>{locale === 'en' ? 'Arabic reviews' : 'Critiques en arabe'}</small></a>
<a href="/category/series/"><span>▣</span><strong>{locale === 'en' ? 'Series' : 'Séries'}</strong><small>{locale === 'en' ? 'Arabic reviews' : 'Critiques en arabe'}</small></a>
<a href="/category/game/"><span>✦</span><strong>{locale === 'en' ? 'Games' : 'Jeux'}</strong><small>{locale === 'en' ? 'Arabic reviews' : 'Critiques en arabe'}</small></a>
</div>
</section>
</main>
<footer class="site-footer"><div class="wrap footer-inner"><a href={home} class="footer-brand">Vibe<span>Critic</span></a><p>© {new Date().getFullYear()} VibeCritic. {copy.footer}</p></div></footer>
</body>
</html>
<style>
.localized-landing{padding:clamp(64px,10vw,120px) 0 50px;min-height:70vh}
.localized-landing>.catalog-eyebrow{letter-spacing:.18em}
.localized-landing h1{max-width:900px;font-size:clamp(42px,7vw,78px);line-height:1.04;letter-spacing:-.05em;margin:18px 0}
.localized-lead{font-size:clamp(17px,2vw,22px);color:var(--vc-muted);line-height:1.7;max-width:680px}
.localized-notice{max-width:760px;margin:42px 0;padding:clamp(24px,5vw,42px);border:1px solid var(--vc-border);background:var(--vc-surface);border-radius:18px;line-height:1.8}
.localized-notice>strong{font-size:20px}.localized-notice p{color:var(--vc-muted);line-height:1.9}
.localized-cta{display:inline-flex;margin-top:10px;padding:12px 18px;background:var(--vc-accent);color:white;font-weight:800;border-radius:8px}
.localized-pilot{max-width:1000px;margin:50px 0}.localized-pilot h2,.localized-categories h2{font-size:24px}
.localized-review-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.localized-review-card{display:flex;flex-direction:column;gap:9px;padding:14px;border:1px solid var(--vc-border);background:var(--vc-surface);border-radius:12px;min-width:0}
.localized-review-card img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:8px}
.localized-review-card>span{font-size:10px;letter-spacing:.12em;color:var(--vc-accent);font-weight:850}
.localized-review-card strong{font-size:17px;line-height:1.4}
.localized-review-card small{color:var(--vc-muted)}
.localized-category-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.localized-category-grid a{display:flex;flex-direction:column;gap:9px;padding:22px;border:1px solid var(--vc-border);background:var(--vc-surface);border-radius:12px}
.localized-category-grid a>span{font-size:25px;color:var(--vc-accent)}.localized-category-grid small{color:var(--vc-muted)}
.language-picker{position:relative;font-size:12px;font-weight:800;z-index:60}
.language-picker summary{list-style:none;cursor:pointer;border:1px solid var(--vc-border);border-radius:999px;padding:10px 12px}
.language-picker summary::-webkit-details-marker{display:none}
.language-options{position:absolute;top:calc(100% + 8px);inset-inline-end:0;min-width:130px;padding:7px;background:var(--vc-surface);border:1px solid var(--vc-border);border-radius:10px;box-shadow:0 12px 30px #0002}
.language-options a{display:block;padding:9px 11px;border-radius:6px}.language-options a:hover{background:var(--vc-surface-muted)}
@media(max-width:700px){.localized-review-grid{grid-template-columns:1fr}.localized-category-grid{grid-template-columns:1fr}.site-nav{gap:10px;flex-wrap:wrap;padding:12px 0}.site-links{order:3;width:100%;justify-content:center;flex-wrap:wrap}.brand small{display:none}}
</style>
