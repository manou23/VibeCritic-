---
import {getCollection} from 'astro:content';import RawgLayout from '../layouts/RawgLayout.astro';import GameCard from '../components/GameCard.astro';import {releaseTimestamp} from '../lib/ui';
const all=await getCollection('reviews');const sorted=[...all].sort((a,b)=>releaseTimestamp(b.data.releaseDate,b.data.date)-releaseTimestamp(a.data.releaseDate,a.data.date));
const types=[['all','الكل'],['game','ألعاب'],['movie','أفلام'],['series','مسلسلات']];
---
<RawgLayout title="اكتشف الألعاب والأفلام والمسلسلات" description="مكتبة VibeCritic للألعاب والأفلام والمسلسلات: اكتشف الجديد، ابحث وصفِّ النتائج وقارن التقييمات النقدية.">
<header class="rawg-page-heading"><div><p class="rawg-eyebrow"><i></i> THE ENTERTAINMENT DATABASE</p><h1>الجديد والرائج</h1><p>كل ما يستحق وقتك. ومراجعات تقول رأيها بصراحة.</p></div><span class="rawg-heading-mark">VC<span> / 01</span></span></header>
<div class="rawg-filter-bar"><div class="rawg-chips" role="group" aria-label="نوع العمل">{types.map(([v,l])=><button type="button" data-type={v} class="rawg-chip">{l}</button>)}</div><label class="rawg-sort-label" for="sort">ترتيب حسب</label><select id="sort" aria-label="ترتيب الأعمال"><option value="date">الأحدث</option><option value="score">الأعلى تقييماً</option></select></div>
<div class="rawg-results-line"><span id="result-count">{sorted.length} عمل</span><span>NO HYPE. JUST GOOD PICKS.</span></div>
<section id="grid" class="rawg-grid" aria-label="مكتبة الأعمال">{sorted.map(r=><GameCard r={r}/>)}</section>
<p id="empty" class="rawg-empty" hidden>لا توجد نتائج. جرّب كلمة بحث أخرى أو اختر «الكل».</p>
<style>
.rawg-page-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;padding:16px 0 25px;border-bottom:1px solid #ffffff14}.rawg-eyebrow{display:flex;align-items:center;gap:9px;margin:0 0 12px;color:#8cdb6b;font-size:10px;font-weight:900;letter-spacing:1.7px}.rawg-eyebrow i{width:7px;height:7px;border-radius:50%;background:#8cdb6b;box-shadow:0 0 13px #8cdb6b}.rawg-page-heading h1{margin:0;color:#f7f7f4;font-size:clamp(32px,5vw,55px);font-weight:950;letter-spacing:-1.7px;line-height:1.2}.rawg-page-heading>div>p:last-child{margin:10px 0 0;color:#92928c;font-size:13px;line-height:1.8}.rawg-heading-mark{color:#8cdb6b;font-size:28px;font-weight:1000}.rawg-heading-mark span{color:#65655f;font-size:11px}
.rawg-filter-bar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:20px 0 14px}.rawg-chips{display:flex;gap:7px;flex-wrap:wrap}.rawg-chip{min-height:38px;padding:0 16px;border:1px solid #ffffff16;border-radius:8px;background:#222;color:#aaa;font:inherit;font-size:12px;font-weight:800;cursor:pointer;transition:background .2s,color .2s}.rawg-chip:hover{border-color:#6dc849;color:white}.rawg-chip.is-active{border-color:#6dc849;background:#6dc849;color:#10130d}.rawg-sort-label{margin-inline-start:auto;color:#888;font-size:11px}.rawg-filter-bar select{min-height:38px;padding:0 12px;border:1px solid #ffffff18;border-radius:8px;background:#222;color:#eee;font:inherit;font-size:12px}.rawg-results-line{display:flex;justify-content:space-between;gap:12px;margin:12px 0;color:#777;font-size:10px}.rawg-results-line span:first-child{color:#aaa;font-weight:800}
.rawg-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:25px 16px}.rawg-empty{padding:70px 15px;text-align:center;color:#888}.rawg-game-card{min-width:0}.rawg-game-card-link{display:block;overflow:hidden;border:1px solid #ffffff0d;border-radius:12px;background:#202020;transition:transform .25s,border-color .25s,box-shadow .25s}.rawg-game-card-link:hover{transform:translateY(-5px);border-color:#ffffff25;box-shadow:0 18px 38px #0007}.rawg-game-art{position:relative;overflow:hidden;aspect-ratio:16/10;background:#292929}.rawg-game-art>img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .55s,filter .3s}.rawg-game-card-link:hover .rawg-game-art>img{transform:scale(1.06);filter:brightness(.52)}.rawg-game-no-art{display:grid;place-items:center;width:100%;height:100%;color:#8cdb6b;font-size:60px}.rawg-game-kind{position:absolute;top:12px;right:12px;padding:5px 9px;border:1px solid #ffffff26;border-radius:6px;background:#151515d9;color:#eee;font-size:10px;font-weight:800}.rawg-game-score{position:absolute;left:12px;top:12px;display:flex;align-items:baseline;gap:2px;padding:5px 8px;border:1px solid;border-radius:6px;background:#151515e8;font-size:14px;font-weight:950}.rawg-game-score small{font-size:8px;color:#aaa}.rawg-game-score-muted{color:#aaa;border-color:#ffffff25;font-size:10px}.rawg-game-hover{position:absolute;inset:auto 0 0;display:flex;flex-direction:column;gap:10px;padding:18px 15px 14px;color:white;opacity:0;transform:translateY(9px);transition:opacity .25s,transform .25s;font-size:11px;line-height:1.8}.rawg-game-hover span{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.rawg-game-hover b{color:#9be47c}.rawg-game-card-link:hover .rawg-game-hover,.rawg-game-card-link:focus-visible .rawg-game-hover{opacity:1;transform:translateY(0)}.rawg-game-copy{padding:12px 13px 14px}.rawg-game-meta{display:flex;justify-content:space-between;gap:8px;color:#82827c;font-size:9px}.rawg-game-meta time{white-space:nowrap}.rawg-game-copy h2{margin:8px 0 4px;color:#f2f2ed;font-size:15px;font-weight:900;line-height:1.55}.rawg-game-copy>p{margin:0;color:#777;font-size:10px}
@media(max-width:1100px){.rawg-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:700px){.rawg-page-heading{padding-top:5px}.rawg-heading-mark{display:none}.rawg-filter-bar{gap:8px}.rawg-chip{min-height:35px;padding-inline:12px;font-size:11px}.rawg-sort-label{margin-inline-start:0}.rawg-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 10px}.rawg-game-copy{padding:10px}.rawg-game-copy h2{font-size:13px}.rawg-game-meta{font-size:8px}.rawg-game-hover{display:none}}@media(prefers-reduced-motion:reduce){.rawg-game-card-link,.rawg-game-art>img,.rawg-game-hover{transition:none}}
</style>
<script>
const params=new URLSearchParams(location.search);let type=params.get('type')??'all';
const q=document.querySelector<HTMLInputElement>('#q'),sort=document.querySelector<HTMLSelectElement>('#sort'),grid=document.querySelector<HTMLElement>('#grid'),empty=document.querySelector<HTMLElement>('#empty'),count=document.querySelector<HTMLElement>('#result-count');
const chips=[...document.querySelectorAll<HTMLButtonElement>('.rawg-chip')];const cards=grid?[...grid.children] as HTMLElement[]:[];
if(q)q.value=params.get('q')??'';if(sort)sort.value=params.get('sort')==='score'?'score':'date';
function apply(){if(!grid||!empty||!sort)return;const term=(q?.value||'').trim().toLocaleLowerCase('ar'),key=sort.value==='score'?'score':'date';cards.sort((a,b)=>Number(b.dataset[key]||0)-Number(a.dataset[key]||0)).forEach(c=>grid.append(c));let n=0;cards.forEach(c=>{const ok=(type==='all'||c.dataset.type===type)&&(!term||(c.dataset.title||'').includes(term));c.hidden=!ok;if(ok)n++;});empty.hidden=n>0;if(count)count.textContent=n.toLocaleString('ar-DZ')+' عمل';chips.forEach(b=>{const active=b.dataset.type===type;b.classList.toggle('is-active',active);b.setAttribute('aria-pressed',String(active));});}
chips.forEach(b=>b.addEventListener('click',()=>{type=b.dataset.type||'all';apply();}));q?.addEventListener('input',apply);q?.form?.addEventListener('submit',e=>{e.preventDefault();const next=new URL(location.href);if(q.value.trim())next.searchParams.set('q',q.value.trim());else next.searchParams.delete('q');if(type!=='all')next.searchParams.set('type',type);else next.searchParams.delete('type');if(sort?.value==='score')next.searchParams.set('sort','score');else next.searchParams.delete('sort');location.href=next.pathname+next.search;});sort?.addEventListener('change',apply);apply();
</script>
</RawgLayout>
