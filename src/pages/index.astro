---
import Base from '../layouts/Base.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { getCollection } from 'astro:content';
import { url, TYPE_PLURAL, optimizeImage } from '../consts';
import trending from '../data/trending.json';
const reviews=(await getCollection('reviews')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const byType={game:reviews.filter(x=>x.data.type==='game'),series:reviews.filter(x=>x.data.type==='series'),movie:reviews.filter(x=>x.data.type==='movie')};
// اعرض الترندات الموثوقة حتى عندما لم تُنشر مراجعة VibeCritic للعمل بعد.
const trendReviews=trending.filter(item=>['مرتفع','متوسط'].includes(item.trendConfidence)).map(item=>{
 const review=reviews.find(entry=>entry.data.type===item.type&&entry.data.sourceId===item.sourceId);
 return {...item,title:review?.data.title||item.title,summary:review?.data.summary||item.summary,poster:optimizeImage(item.poster),backdrop:optimizeImage(item.backdrop||item.poster,'backdrop'),review,href:review?url(`reviews/${review.id}/`):item.sourceUrl,external:!review};
}).filter(item=>item.href).slice(0,9);
const spotlight=trendReviews[0]||null;
const todayInAlgeria=new Intl.DateTimeFormat('en-CA',{timeZone:'Africa/Algiers'}).format(new Date());
const isUpcomingReview=review=>{
 const releaseDate=String(review.data.releaseDate||'').slice(0,10);
 return /^\d{4}-\d{2}-\d{2}$/.test(releaseDate)&&releaseDate>todayInAlgeria;
};
const topRated=[...reviews].filter(review=>review.data.score>0&&!isUpcomingReview(review)&&review.data.reviewMode!=='preview').sort((a,b)=>b.data.score-a.data.score).slice(0,8);
const upcoming=reviews.filter(isUpcomingReview).sort((a,b)=>String(a.data.releaseDate||'').localeCompare(String(b.data.releaseDate||''))).slice(0,8);
---
<Base title="اكتشف عالم الترفيه" description="اكتشف أحدث الأفلام والمسلسلات والألعاب، تابع الترندات العالمية واقرأ مراجعات VibeCritic." image={spotlight?.backdrop || spotlight?.poster}>
<section class="wrap discovery-hero spotlight-slider" aria-label="أبرز الترندات">
 <div class="spotlight-backdrops" aria-hidden="true">
  <img class="spotlight-image is-active" src={spotlight?.backdrop||spotlight?.poster||''} alt="" fetchpriority="high" loading="eager" decoding="async"/>
  <img class="spotlight-image" alt="" loading="lazy" decoding="async"/>
 </div>
 <div class="discovery-shade"></div>
 <div class="discovery-content spotlight-copy" aria-live="polite">
  <p class="discovery-kicker"><span></span> VIBECRITIC / مؤشرات الرواج</p>
  <p class="spotlight-category">{spotlight?.type==='game'?'ترند الألعاب':spotlight?.type==='series'?'ترند المسلسلات':'ترند الأفلام'} · {spotlight?.source||'TRENDING'}</p>
  <h1 class="spotlight-title">{spotlight?.title||'أبرز مؤشرات الرواج'}</h1>
  <p class="discovery-description spotlight-description">{spotlight?.summary||'اكتشف الأعمال التي تسجل مؤشرات شعبية موثوقة لدى مصادر البيانات.'}</p>
  <div class="discovery-actions">
   {spotlight&&<a class="discovery-primary spotlight-link" href={spotlight.href} target={spotlight.external?"_blank":undefined} rel={spotlight.external?"noopener noreferrer":undefined}>{spotlight.external?"اكتشف العمل":"اقرأ المراجعة"} <span>↗</span></a>}
   <a class="discovery-secondary" href="#trending">كل الترندات</a>
  </div>
 </div>
 <div class="spotlight-controls">
  <button type="button" class="spotlight-prev" aria-label="الترند السابق" disabled={trendReviews.length < 2}>‹</button>
  <span class="discovery-index"><strong class="spotlight-count">01</strong><span>من <b class="spotlight-total">{String(Math.max(1,trendReviews.length)).padStart(2,'0')}</b> ترندات</span></span>
  <button type="button" class="spotlight-next" aria-label="الترند التالي" disabled={trendReviews.length < 2}>›</button>
 </div>
 <div class="spotlight-progress" aria-hidden="true"><span></span></div>
 <div class="spotlight-data" hidden>
  {trendReviews.map(item=><i data-title={item.title} data-summary={item.summary||''} data-backdrop={item.backdrop||item.poster||''} data-poster={item.poster||''} data-type={item.type} data-source={item.source||''} data-href={item.href} data-external={String(item.external)}></i>)}
 </div>
</section>
<aside class="wrap ai-review-promo" data-expires="2026-11-19T23:59:59+01:00" aria-label="جرّب المراجع الذكي">
 <div class="ai-review-promo-copy">
  <span class="ai-review-promo-badge">ميزة جديدة · لفترة محدودة</span><small class="ai-review-promo-expiry">تنتهي في 19 نوفمبر 2026</small>
  <p class="ai-review-promo-kicker">MEET YOUR AI CRITIC</p>
  <h2>رأيك القادم يبدأ من هنا!</h2>
  <p>اكتشف مراجعة ذكية لفيلمك أو مسلسلك أو لعبتك المفضلة، مع تقييم وتحليل ونقاط القوة والضعف في ثوانٍ.</p>
  <a class="ai-review-promo-cta" href="/ai-review/">جرّب المراجع الذكي <span aria-hidden="true">↗</span></a>
 </div>
 <div class="ai-review-promo-art" aria-hidden="true">
  <div class="ai-review-promo-orbit"></div>
  <div class="ai-review-promo-score"><strong>AI</strong><span>REVIEW</span></div>
  <span class="ai-review-promo-spark spark-one">✦</span>
  <span class="ai-review-promo-spark spark-two">✧</span>
 </div>
</aside>
<section class="wrap catalog-section" id="top-rated">
 <div class="catalog-heading"><div><p class="catalog-eyebrow">EDITOR'S HIGHEST SCORES</p><h2>الأعلى تقييماً</h2><p>الأعمال التي حصلت على أعلى درجات VibeCritic التحريرية</p></div><a href="#all-reviews" class="catalog-more">كل المراجعات <span>←</span></a></div>
 {topRated.length>0?<div class="catalog-rail">{topRated.map(review=><ReviewCard review={review}/>)}</div>:<div class="catalog-empty">ستظهر هنا الأعمال بعد اكتمال مراجعاتها وتقييمها.</div>}
</section>
<section class="wrap catalog-section" id="coming-soon">
 <div class="catalog-heading"><div><p class="catalog-eyebrow">ADVANCE READINGS</p><h2>قراءات استباقية</h2><p>مواد تمهيدية للأعمال التي لم تصدر بعد، وليست مراجعات نهائية</p></div></div>
 {upcoming.length>0?<div class="catalog-rail">{upcoming.map(review=><ReviewCard review={review}/>)}</div>:<div class="catalog-empty">لا توجد قراءات استباقية منشورة حالياً. لن نضيف عملاً قادماً دون بيانات كافية.</div>}
</section>
{(['game','series','movie'] as const).map(type=><section class="wrap catalog-section type-section">
 <div class="catalog-heading"><div><p class="catalog-eyebrow">{type==='game'?'PLAY YOUR NEXT':type==='series'?'BINGE YOUR NEXT':'YOUR NEXT MOVIE'}</p><h2>{type==='game'?'أحدث الألعاب':type==='series'?'أحدث المسلسلات':'أحدث الأفلام'}</h2><p>اكتشف جديد قسم {TYPE_PLURAL[type]} ومراجعاته</p></div><a href={url(`category/${type}/`)} class="catalog-more">عرض الكل <span>←</span></a></div>
 {byType[type].length>0?<div class="catalog-rail">{byType[type].slice(0,8).map(review=><ReviewCard review={review}/>)}</div>:<div class="catalog-empty">نعمل على إثراء قسم {TYPE_PLURAL[type]} بمحتوى جديد ومتوازن.</div>}
</section>)}
<section class="wrap catalog-section" id="all-reviews">
 <div class="catalog-heading"><div><p class="catalog-eyebrow">THE WHOLE LIBRARY</p><h2>استكشف المكتبة</h2><p>بحث نصي سريع في جميع مراجعات الألعاب والأفلام والمسلسلات</p></div><span class="catalog-total">{reviews.length} مراجعة</span></div>
 <pagefind-searchbox placeholder="ابحث عن لعبة أو فيلم أو مسلسل..." max-results="15" hide-shortcut></pagefind-searchbox>
</section>
</Base>

<script>
const hero=document.querySelector<HTMLElement>('.spotlight-slider');
if(hero){
 const data=[...hero.querySelectorAll<HTMLElement>('.spotlight-data i')].map(el=>({...el.dataset}));
 const images=[...hero.querySelectorAll<HTMLImageElement>('.spotlight-image')];
 const title=hero.querySelector<HTMLElement>('.spotlight-title');
 const summary=hero.querySelector<HTMLElement>('.spotlight-description');
 const category=hero.querySelector<HTMLElement>('.spotlight-category');
 const link=hero.querySelector<HTMLAnchorElement>('.spotlight-link');
 const count=hero.querySelector<HTMLElement>('.spotlight-count');
 const progress=hero.querySelector<HTMLElement>('.spotlight-progress span');
 const prev=hero.querySelector<HTMLButtonElement>('.spotlight-prev');
 const next=hero.querySelector<HTMLButtonElement>('.spotlight-next');
 let current=0,activeImage=0,timer:number|undefined,textTimer:number|undefined;
 const duration=7000;
 const labels:Record<string,string>={game:'ترند الألعاب',series:'ترند المسلسلات',movie:'ترند الأفلام'};
 const reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 function show(index:number){
  if(!data.length)return;
  current=(index+data.length)%data.length;
  const target=current;
  const item=data[target];
  const nextImage=1-activeImage;
  const src=item.backdrop||item.poster||'';
  if(src){
   images[nextImage].onload=null;
   images[nextImage].removeAttribute('src');
   let activated=false;
   const activateImage=()=>{
    if(activated||current!==target||!images[nextImage].naturalWidth)return;
    activated=true;
    images[nextImage].onload=null;
    images[nextImage].classList.add('is-active');
    images[activeImage].classList.remove('is-active');
    activeImage=nextImage;
   };
   images[nextImage].onload=activateImage;
   images[nextImage].src=src;
   if(images[nextImage].complete)activateImage();
  }
  hero.querySelector('.spotlight-copy')?.classList.add('is-changing');
  if(textTimer)window.clearTimeout(textTimer);
  textTimer=window.setTimeout(()=>{
   if(current!==target)return;
   if(title)title.textContent=item.title||'ترند عالمي';
   if(summary)summary.textContent=item.summary||'هذا العمل ضمن أبرز الأعمال وفق مؤشرات الشعبية المتاحة.';
   if(category)category.textContent=(labels[item.type]||'ترند عالمي')+' · '+(item.source||'TRENDING');
   if(link){link.href=item.href;if(item.external==='true'){link.target='_blank';link.rel='noopener noreferrer';link.textContent='اكتشف العمل ↗';}else{link.removeAttribute('target');link.removeAttribute('rel');link.textContent='اقرأ المراجعة ↗';}}
   if(count)count.textContent=String(current+1).padStart(2,'0');
   hero.querySelector('.spotlight-copy')?.classList.remove('is-changing');
  },reduced?0:220);
  if(progress)progress.style.width=((current+1)/data.length*100)+'%';
 }
 function stop(){if(timer){window.clearInterval(timer);timer=undefined;}}
 function start(){stop();if(data.length<2||reduced)return;timer=window.setInterval(()=>show(current+1),duration);}
 prev?.addEventListener('click',()=>{show(current-1);start();});
 next?.addEventListener('click',()=>{show(current+1);start();});
 hero.addEventListener('mouseenter',stop);
 hero.addEventListener('mouseleave',start);
 hero.addEventListener('focusin',stop);
 hero.addEventListener('focusout',(event)=>{if(!(event.relatedTarget instanceof Node)||!hero.contains(event.relatedTarget))start();});
 document.addEventListener('visibilitychange',()=>document.hidden?stop():start());
 if(data.length>1)start();
}

const aiPromo=document.querySelector<HTMLElement>('.ai-review-promo');
if(aiPromo){
 const expires=Date.parse(aiPromo.dataset.expires||'');
 if(!Number.isFinite(expires)||Date.now()>=expires)aiPromo.remove();
}
</script>
