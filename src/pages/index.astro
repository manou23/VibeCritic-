---
import Base from '../layouts/Base.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { getCollection } from 'astro:content';
import { url, TYPE_PLURAL } from '../consts';
import trending from '../data/trending.json';
const reviews=(await getCollection('reviews')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const byType={game:reviews.filter(x=>x.data.type==='game'),series:reviews.filter(x=>x.data.type==='series'),movie:reviews.filter(x=>x.data.type==='movie')};
const trendReviews=trending.slice(0,5).map(item=>{
 const review=reviews.find(entry=>entry.data.type===item.type&&entry.data.sourceId===item.sourceId);
 return {...item,review,href:review?url(`reviews/${review.id}/`):item.sourceUrl};
});
const spotlight=trendReviews[0]|| (reviews[0]?{title:reviews[0].data.title,summary:reviews[0].data.summary,backdrop:reviews[0].data.backdrop,poster:reviews[0].data.poster,href:url(`reviews/${reviews[0].id}/`),type:reviews[0].data.type,source:'VibeCritic'}:null);
const latest=reviews.slice(0,12);
---
<Base title="اكتشف عالم الترفيه" description="اكتشف أحدث الأفلام والمسلسلات والألعاب، تابع الترندات العالمية واقرأ مراجعات VibeCritic.">
<section class="wrap discovery-hero">
 {spotlight?.backdrop&&<img class="discovery-backdrop" src={spotlight.backdrop} alt="" fetchpriority="high"/>}
 <div class="discovery-shade"></div>
 <div class="discovery-content">
  <p class="discovery-kicker"><span></span> VIBECRITIC ORIGINAL / اكتشف الآن</p>
  <h1>{spotlight?.title||'كل ما يستحق المشاهدة واللعب'}</h1>
  <p class="discovery-description">{spotlight?.summary||'وجهتك لاكتشاف أحدث الألعاب والأفلام والمسلسلات ومتابعة أكثر الأعمال رواجاً.'}</p>
  <div class="discovery-actions">
   {spotlight?.href&&<a class="discovery-primary" href={spotlight.href}>اكتشف التفاصيل <span>↗</span></a>}
   <a class="discovery-secondary" href="#trending">استكشف الأكثر رواجاً</a>
  </div>
 </div>
 <div class="discovery-index"><strong>01</strong><span>اختيار VibeCritic</span></div>
</section>
<section class="wrap catalog-section" id="trending">
 <div class="catalog-heading"><div><p class="catalog-eyebrow">WHAT'S POPULAR</p><h2>الرائج الآن</h2><p>الأعمال التي يتحدث عنها الجميع حول العالم</p></div><a href="#new-releases" class="catalog-more">اكتشف الجديد <span>←</span></a></div>
 {trendReviews.length>0?<div class="catalog-rail trend-rail">
 {trendReviews.map((item,i)=><a class="catalog-poster-card trend-poster-card" href={item.href} target={item.review?undefined:'_blank'} rel={item.review?undefined:'noreferrer'}>
  <div class="catalog-poster">{item.poster?<img src={item.poster} alt={item.title} loading="lazy"/>:<div class="poster-fallback">V/C</div>}<span class="catalog-rank">{String(i+1).padStart(2,'0')}</span></div>
  <div class="catalog-poster-info"><span>{item.type==='game'?'لعبة':item.type==='series'?'مسلسل':'فيلم'} · {item.source}</span><h3>{item.title}</h3><small>{item.review?'اقرأ مراجعة VibeCritic':'اكتشف العمل'} ↗</small></div>
 </a>)}
 </div>:<div class="catalog-empty">سيظهر ترتيب الترندات العالمي هنا بعد أول تحديث تلقائي.</div>}
</section>
<section class="wrap catalog-section" id="new-releases">
 <div class="catalog-heading"><div><p class="catalog-eyebrow">JUST ADDED</p><h2>أحدث الإضافات</h2><p>آخر الأعمال التي وصلت إلى مكتبة VibeCritic</p></div><a href="#all-reviews" class="catalog-more">كل المراجعات <span>←</span></a></div>
 {latest.length>0?<div class="catalog-rail">{latest.map(review=><ReviewCard review={review}/>)}</div>:<div class="catalog-empty">المكتبة في بداية انطلاقتها. ستظهر الإضافات الجديدة هنا.</div>}
</section>
{(['game','series','movie'] as const).map(type=><section class="wrap catalog-section type-section">
 <div class="catalog-heading"><div><p class="catalog-eyebrow">{type==='game'?'PLAY YOUR NEXT':type==='series'?'BINGE YOUR NEXT':'YOUR NEXT MOVIE'}</p><h2>{type==='game'?'أحدث الألعاب':type==='series'?'أحدث المسلسلات':'أحدث الأفلام'}</h2><p>اكتشف جديد قسم {TYPE_PLURAL[type]} ومراجعاته</p></div><a href={url(`category/${type}/`)} class="catalog-more">عرض الكل <span>←</span></a></div>
 {byType[type].length>0?<div class="catalog-rail">{byType[type].slice(0,8).map(review=><ReviewCard review={review}/>)}</div>:<div class="catalog-empty">نعمل على إثراء قسم {TYPE_PLURAL[type]} بمحتوى جديد ومتوازن.</div>}
</section>)}
<section class="wrap catalog-section" id="all-reviews">
 <div class="catalog-heading"><div><p class="catalog-eyebrow">THE WHOLE LIBRARY</p><h2>استكشف المكتبة</h2><p>ابحث في جميع مراجعات الألعاب والأفلام والمسلسلات</p></div><span class="catalog-total">{reviews.length} مراجعة</span></div>
 <input id="review-search" class="catalog-search" placeholder="ابحث عن عنوان لعبة أو فيلم أو مسلسل..." aria-label="ابحث في المراجعات"/>
 <div id="review-grid" class="catalog-rail">{reviews.map(review=><div data-search={`${review.data.title} ${review.data.headline} ${review.data.tags.join(' ')}`}><ReviewCard review={review}/></div>)}</div>
 <p id="empty-search" class="catalog-empty" hidden>لا توجد نتائج مطابقة لبحثك.</p>
</section>
<script>
const input=document.querySelector<HTMLInputElement>('#review-search');
const cards=[...document.querySelectorAll<HTMLElement>('#review-grid [data-search]')];
const empty=document.querySelector<HTMLElement>('#empty-search');
input?.addEventListener('input',()=>{const q=input.value.toLowerCase().trim();let count=0;cards.forEach(card=>{const show=card.dataset.search?.toLowerCase().includes(q)??false;card.hidden=!show;if(show)count++;});if(empty)empty.hidden=count!==0||!q;});
</script>
</Base>
