---
import Base from '../layouts/Base.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { getCollection } from 'astro:content';
import { url, TYPE_PLURAL, optimizeImage } from '../consts';
import trending from '../data/trending.json';
const reviews=(await getCollection('reviews')).sort((a,b)=>(b.data.publishedAt??b.data.date).valueOf()-(a.data.publishedAt??a.data.date).valueOf());
const byType={game:reviews.filter(x=>x.data.type==='game'),series:reviews.filter(x=>x.data.type==='series'),movie:reviews.filter(x=>x.data.type==='movie')};
// اعرض الترندات الموثوقة حتى عندما لم تُنشر مراجعة VibeCritic للعمل بعد.
const gta6Preview=reviews.find(review=>review.data.sourceId==='gta-vi-2026');
const trendReviews=[
 ...(gta6Preview?[{id:'gta-vi-2026',sourceId:'gta-vi-2026',type:'game',title:gta6Preview.data.title,summary:gta6Preview.data.summary,poster:optimizeImage(gta6Preview.data.poster),backdrop:optimizeImage(gta6Preview.data.backdrop||gta6Preview.data.poster,'backdrop'),source:'قراءة استباقية',review:gta6Preview,href:url(`reviews/${gta6Preview.id}/`),external:false,preview:true}]:[]),
 ...trending.filter(item=>item.sourceId!=='gta-vi-2026'&&['مرتفع','متوسط'].includes(item.trendConfidence)).map(item=>{
  const review=reviews.find(entry=>entry.data.type===item.type&&entry.data.sourceId===item.sourceId);
  return {...item,title:review?.data.title||item.title,summary:review?.data.summary||item.summary,poster:optimizeImage(item.poster),backdrop:optimizeImage(item.backdrop||item.poster,'backdrop'),review,href:review?url(`reviews/${review.id}/`):item.sourceUrl,external:!review,preview:false};
 }).filter(item=>item.href)
].slice(0,9);
const spotlight=trendReviews[0]||null;
const todayInAlgeria=new Intl.DateTimeFormat('en-CA',{timeZone:'Africa/Algiers'}).format(new Date());
const isUpcomingReview=review=>{
 const releaseDate=String(review.data.releaseDate||'').slice(0,10);
 return /^\d{4}-\d{2}-\d{2}$/.test(releaseDate)&&releaseDate>todayInAlgeria;
};
// ترتيب الأعلى تقييماً يعتمد حصراً على متوسط تحريري موزون للأبعاد الأربعة، لا على الدرجة الإجمالية الخام وحدها.
const editorialScore=(review)=> {
 const d=review.data;
 const parts=[d.storyScore,d.visualsScore,d.soundScore,d.pacingScore];
 if(parts.some(value=>typeof value!=='number'||!Number.isFinite(value)||value<0||value>10))return null;
 return Math.round((d.storyScore*.30+d.visualsScore*.25+d.soundScore*.20+d.pacingScore*.25)*10)/10;
};
const topRated=reviews
 .filter(review=>!isUpcomingReview(review)&&review.data.reviewMode==='review'&&editorialScore(review)!==null)
 .map(review=>({...review,data:{...review.data,score:editorialScore(review)}}))
 .sort((a,b)=>b.data.score-a.data.score)
 .slice(0,8);
const upcoming=reviews.filter(isUpcomingReview).sort((a,b)=>String(a.data.releaseDate||'').localeCompare(String(b.data.releaseDate||''))).slice(0,8);
// أحدث المراجعات المنشورة، مع استبعاد القراءات الاستباقية للأعمال التي لم تصدر بعد.
const latestReviews=reviews.filter(review=>!isUpcomingReview(review)&&review.data.reviewMode!=='preview').slice(0,8);
---
<Base title="اكتشف عالم الترفيه" description="اكتشف أحدث الأفلام والمسلسلات والألعاب، تابع الترندات العالمية واقرأ مراجعات VibeCritic." image={spotlight?.backdrop || spotlight?.poster}>
<section class="wrap discovery-hero spotlight-slider" aria-label="أبرز الترندات">
 <div class="spotlight-backdrops" aria-hidden="true">
  <img class="spotlight-image is-active" src={spotlight?.backdrop||spotlight?.poster||''} alt="" fetchpriority="high" loading="eager" decoding="async"/>
  <img class="spotlight-image" alt="" loading="lazy" decoding="async"/>
 </div>
 <div class="discovery-shade"></div>
 <div class="discovery-content spotlight-copy" aria-live="polite">
  <p class="discovery-kicker"><span></span> VIBECRITIC / مؤشرات الرواج</p>
  <p class="spotlight-category">{spotlight?.type==='game'?'ترند الألعاب':spotlight?.type==='series'?'ترند المسلسلات':'ترند الأفلام'} · {spotlight?.source||'TRENDING'}</p>
  <h1 class="spotlight-title">{spotlight?.title||'أبرز مؤشرات الرواج'}</h1>
  <p class="discovery-description spotlight-description">{spotlight?.summary||'اكتشف الأعمال التي تسجل مؤشرات شعبية موثوقة لدى مصادر البيانات.'}</p>
  <div class="discovery-actions">
   {spotlight&&<a class="discovery-primary spotlight-link" href={spotlight.href} target={spotlight.external?"_blank":undefined} rel={spotlight.external?"noopener noreferrer":undefined}>{spotlight.external?"اكتشف العمل":"اقرأ المراجعة"} <span>↗</span></a>}
   <a class="discovery-secondary" href="#trending">كل الترندات</a>
  </div>
 </div>
 <div class="spotlight-controls">
  <button type="button" class="spotlight-prev" aria-label="الترند السابق" disabled={trendReviews.length < 2}>‹</button>
  <span class="discovery-index"><strong class="spotlight-count">01</strong><span>من <b class="spotlight-total">{String(Math.max(1,trendReviews.length)).padStart(2,'0')}</b> ترندات</span></span>
  <button type="button" class="spotlight-next" aria-label="الترند التالي" disabled={trendReviews.length < 2}>›</button>
  <button type="button" class="spotlight-pause" aria-label="إيقاف التبديل التلقائي" aria-pressed="false" disabled={trendReviews.length < 2}>Ⅱ</button>
 </div>
 <div class="spotlight-progress" aria-hidden="true"><span></span></div>
 <div class="spotlight-data" hidden>
  {trendReviews.map(item=><i data-title={item.title} data-summary={item.summary||''} data-backdrop={item.backdrop||item.poster||''} data-poster={item.poster||''} data-type={item.type} data-source={item.source||''} data-href={item.href} data-external={String(item.external)} data-preview={String(item.preview||false)}></i>)}
 </div>
</section>
<section class="wrap home-discovery-shortcuts" aria-labelledby="home-discovery-title">
 <div class="home-discovery-heading">
  <div>
   <p class="catalog-eyebrow">CHOOSE YOUR NEXT WORLD</p>
   <h2 id="home-discovery-title">من أين تحب أن تبدأ؟</h2>
   <p>انتقل مباشرة إلى عالمك المفضل واكتشف أحدث المراجعات.</p>
  </div>
  <a href="/magazine/" class="home-discovery-all">اكتشف المجلة <span aria-hidden="true">←</span></a>
 </div>
 <nav class="home-discovery-grid" aria-label="استكشف أقسام VibeCritic">
  <a class="home-discovery-card home-discovery-games" href={url('category/game/')}>
   <span class="home-discovery-icon" aria-hidden="true">🎮</span>
   <span class="home-discovery-copy"><strong>الألعاب</strong><small>تقييمات وتجارب وأحدث الإصدارات</small></span>
   <span class="home-discovery-arrow" aria-hidden="true">↗</span>
  </a>
  <a class="home-discovery-card home-discovery-series" href={url('category/series/')}>
   <span class="home-discovery-icon" aria-hidden="true">▣</span>
   <span class="home-discovery-copy"><strong>المسلسلات</strong><small>تابع قصصاً تستحق المشاهدة</small></span>
   <span class="home-discovery-arrow" aria-hidden="true">↗</span>
  </a>
  <a class="home-discovery-card home-discovery-movies" href={url('category/movie/')}>
   <span class="home-discovery-icon" aria-hidden="true">▶</span>
   <span class="home-discovery-copy"><strong>الأفلام</strong><small>اكتشف ما يستحق وقتك على الشاشة</small></span>
   <span class="home-discovery-arrow" aria-hidden="true">↗</span>
  </a>
  <a class="home-discovery-card home-discovery-magazine" href={url('magazine/')}>
   <span class="home-discovery-icon" aria-hidden="true">✦</span>
   <span class="home-discovery-copy"><strong>المجلة</strong><small>ترشيحات وقوائم واكتشافات جديدة</small></span>
   <span class="home-discovery-arrow" aria-hidden="true">↗</span>
  </a>
 </nav>
</section>
<aside class="wrap ai-review-promo" data-expires="2026-11-19T23:59:59+01:00" aria-label="جرّب المراجع الذكي">
 <div class="ai-review-promo-copy">
  <span class="ai-review-promo-badge">ميزة جديدة · لفترة محدودة</span><small class="ai-review-promo-expiry">تنتهي في 19 نوفمبر 2026</small>
  <p class="ai-review-promo-kicker">MEET YOUR AI CRITIC</p>
  <h2>رأيك القادم يبدأ من هنا!</h2>
  <p>اكتشف مراجعة ذكية لفيلمك أو مسلسلك أو لعبتك المفضلة، مع تقييم وتحليل ونقاط القوة والضعف في ثوانٍ.</p>
  <a class="ai-review-promo-cta" href="/ai-review/">جرّب المراجع الذكي <span aria-hidden="true">↗</span></a>
 </div>
 <div class="ai-review-promo-art" aria-hidden="true">
  <div class="ai-review-promo-orbit"></div>
  <div class="ai-review-promo-score"><strong>AI</strong><span>REVIEW</span></div>
  <span class="ai-review-promo-spark spark-one">✦</span>
  <span class="ai-review-promo-spark spark-two">✧</span>
 </div>
</aside>
<section class="wrap catalog-section home-latest-section" id="latest-reviews">
 <div class="catalog-heading">
  <div><p class="catalog-eyebrow">FRESH FROM VIBECRITIC</p><h2>وصل حديثاً</h2><p>أحدث ما نشرناه من مراجعات الألعاب والأفلام والمسلسلات، مرتبة حسب تاريخ النشر.</p></div>
  <a href={url('catalog/')} class="catalog-more">تصفّح المكتبة <span>←</span></a>
 </div>
 {latestReviews.length>0?<div class="catalog-rail">{latestReviews.map(review=><ReviewCard review={review}/>)}</div>:<div class="catalog-empty">ستظهر هنا أحدث المراجعات فور نشرها.</div>}
</section>
<section class="wrap catalog-section" id="top-rated">
 <div class="catalog-heading"><div><p class="catalog-eyebrow">EDITOR'S HIGHEST SCORES</p><h2>الأعلى تقييماً</h2><p>الأعمال التي حصلت على أعلى درجات VibeCritic التحريرية</p></div><a href="#all-reviews" class="catalog-more">كل المراجعات <span>←</span></a></div>
 {topRated.length>0?<div class="catalog-rail">{topRated.map(review=><ReviewCard review={review}/>)}</div>:<div class="catalog-empty">ستظهر هنا الأعمال بعد اكتمال مراجعاتها وتقييمها.</div>}
</section>
<section class="wrap catalog-section" id="coming-soon">
 <div class="catalog-heading"><div><p class="catalog-eyebrow">ADVANCE READINGS</p><h2>قراءات استباقية</h2><p>مواد تمهيدية للأعمال التي لم تصدر بعد، وليست مراجعات نهائية</p></div></div>
 {upcoming.length>0?<div class="catalog-rail">{upcoming.map(review=><ReviewCard review={review}/>)}</div>:<div class="catalog-empty">لا توجد قراءات استباقية منشورة حالياً. لن نضيف عملاً قادماً دون بيانات كافية.</div>}
</section>
{(['game','series','movie'] as const).map(type=><section class="wrap catalog-section type-section">
 <div class="catalog-heading"><div><p class="catalog-eyebrow">{type==='game'?'PLAY YOUR NEXT':type==='series'?'BINGE YOUR NEXT':'YOUR NEXT MOVIE'}</p><h2>{type==='game'?'أحدث الألعاب':type==='series'?'أحدث المسلسلات':'أحدث الأفلام'}</h2><p>اكتشف جديد قسم {TYPE_PLURAL[type]} ومراجعاته</p></div><a href={url(`category/${type}/`)} class="catalog-more">عرض الكل <span>←</span></a></div>
 {byType[type].length>0?<div class="catalog-rail">{byType[type].slice(0,8).map(review=><ReviewCard review={review}/>)}</div>:<div class="catalog-empty">نعمل على إثراء قسم {TYPE_PLURAL[type]} بمحتوى جديد ومتوازن.</div>}
</section>)}
<section class="wrap catalog-section" id="all-reviews">
 <div class="catalog-heading"><div><p class="catalog-eyebrow">THE WHOLE LIBRARY</p><h2>استكشف المكتبة</h2><p>بحث نصي سريع في جميع مراجعات الألعاب والأفلام والمسلسلات</p></div><span class="catalog-total">{reviews.length} مراجعة</span></div>
 <pagefind-searchbox placeholder="ابحث عن لعبة أو فيلم أو مسلسل..." max-results="15" hide-shortcut></pagefind-searchbox>
</section>
</Base>

<script>
const hero=document.querySelector<HTMLElement>('.spotlight-slider');
if(hero){
 const data=[...hero.querySelectorAll<HTMLElement>('.spotlight-data i')].map(el=>({...el.dataset}));
 const images=[...hero.querySelectorAll<HTMLImageElement>('.spotlight-image')];
 const title=hero.querySelector<HTMLElement>('.spotlight-title');
 const summary=hero.querySelector<HTMLElement>('.spotlight-description');
 const category=hero.querySelector<HTMLElement>('.spotlight-category');
 const link=hero.querySelector<HTMLAnchorElement>('.spotlight-link');
 const count=hero.querySelector<HTMLElement>('.spotlight-count');
 const progress=hero.querySelector<HTMLElement>('.spotlight-progress span');
 const prev=hero.querySelector<HTMLButtonElement>('.spotlight-prev');
 const next=hero.querySelector<HTMLButtonElement>('.spotlight-next');
 const pause=hero.querySelector<HTMLButtonElement>('.spotlight-pause');
 let current=0,activeImage=0,timer:number|undefined,textTimer:number|undefined,paused=false,temporarilyStopped=false;
 const duration=7000;
 const labels:Record<string,string>={game:'ترند الألعاب',series:'ترند المسلسلات',movie:'ترند الأفلام'};
 const reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 function show(index:number){
  if(!data.length)return;
  current=(index+data.length)%data.length;
  const target=current;
  const item=data[target];
  const nextImage=1-activeImage;
  const src=item.backdrop||item.poster||'';
  if(src){
   images[nextImage].onload=null;
   images[nextImage].removeAttribute('src');
   let activated=false;
   const activateImage=()=>{
    if(activated||current!==target||!images[nextImage].naturalWidth)return;
    activated=true;
    images[nextImage].onload=null;
    images[nextImage].classList.add('is-active');
    images[activeImage].classList.remove('is-active');
    activeImage=nextImage;
   };
   images[nextImage].onload=activateImage;
   images[nextImage].src=src;
   if(images[nextImage].complete)activateImage();
  }
  hero.querySelector('.spotlight-copy')?.classList.add('is-changing');
  if(textTimer)window.clearTimeout(textTimer);
  textTimer=window.setTimeout(()=>{
   if(current!==target)return;
   if(title)title.textContent=item.title||'ترند عالمي';
   if(summary)summary.textContent=item.summary||'هذا العمل ضمن أبرز الأعمال وفق مؤشرات الشعبية المتاحة.';
   if(category)category.textContent=(labels[item.type]||'ترند عالمي')+' · '+(item.source||'TRENDING');
   if(link){link.href=item.href;if(item.external==='true'){link.target='_blank';link.rel='noopener noreferrer';link.textContent='اكتشف العمل ↗';}else{link.removeAttribute('target');link.removeAttribute('rel');link.textContent=item.preview==='true'?'اقرأ التحليل الاستباقي ↗':'اقرأ المراجعة ↗';}}
   if(count)count.textContent=String(current+1).padStart(2,'0');
   hero.querySelector('.spotlight-copy')?.classList.remove('is-changing');
  },reduced?0:220);
  if(progress)progress.style.width=((current+1)/data.length*100)+'%';
 }
 function stop(){if(timer){window.clearInterval(timer);timer=undefined;}}
 function start(){stop();if(data.length<2||reduced||paused||temporarilyStopped)return;timer=window.setInterval(()=>show(current+1),duration);}
 function syncPauseButton(){if(!pause)return;pause.textContent=paused?'▶':'Ⅱ';pause.setAttribute('aria-label',paused?'استئناف التبديل التلقائي':'إيقاف التبديل التلقائي');pause.setAttribute('aria-pressed',String(paused));}
 prev?.addEventListener('click',()=>{show(current-1);start();});
 next?.addEventListener('click',()=>{show(current+1);start();});
 pause?.addEventListener('click',()=>{paused=!paused;syncPauseButton();paused?stop():start();});
 hero.addEventListener('mouseenter',()=>{temporarilyStopped=true;stop();});
 hero.addEventListener('mouseleave',()=>{temporarilyStopped=false;start();});
 hero.addEventListener('focusin',()=>{temporarilyStopped=true;stop();});
 hero.addEventListener('focusout',(event)=>{if(!(event.relatedTarget instanceof Node)||!hero.contains(event.relatedTarget)){temporarilyStopped=false;start();}});
 document.addEventListener('visibilitychange',()=>document.hidden?stop():start());
 syncPauseButton();
 if(data.length>1)start();
}

const aiPromo=document.querySelector<HTMLElement>('.ai-review-promo');
if(aiPromo){
 const expires=Date.parse(aiPromo.dataset.expires||'');
 if(!Number.isFinite(expires)||Date.now()>=expires)aiPromo.remove();
}
</script>

<style>
.home-discovery-shortcuts{padding:30px 0 12px}
.home-discovery-heading{display:flex;align-items:end;justify-content:space-between;gap:18px;margin-bottom:17px}
.home-discovery-heading h2{margin:6px 0 5px;font-size:clamp(22px,3vw,30px);font-weight:950;letter-spacing:-.7px}
.home-discovery-heading>div>p:last-child{margin:0;color:var(--vc-muted);font-size:12px;line-height:1.8}
.home-discovery-all{flex:0 0 auto;color:var(--vc-accent-deep);font-size:12px;font-weight:900}
.home-discovery-all span{display:inline-block;margin-right:5px;transition:transform .2s}
.home-discovery-all:hover span{transform:translateX(-4px)}
.home-discovery-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:11px}
.home-discovery-card{position:relative;display:flex;align-items:center;gap:12px;min-width:0;min-height:94px;padding:15px 13px;background:var(--vc-surface);border:1px solid var(--vc-card-border);border-radius:12px;transition:transform .2s,border-color .2s,background .2s}
.home-discovery-card:hover{transform:translateY(-3px);border-color:var(--vc-accent);background:var(--vc-surface-muted)}
.home-discovery-icon{display:grid;place-items:center;flex:0 0 43px;width:43px;height:43px;border-radius:11px;background:var(--vc-surface-muted);font-size:21px;color:var(--vc-accent)}
.home-discovery-copy{display:flex;flex-direction:column;gap:4px;min-width:0}
.home-discovery-copy strong{font-size:14px;font-weight:950}
.home-discovery-copy small{color:var(--vc-muted);font-size:10px;line-height:1.6}
.home-discovery-arrow{margin-inline-start:auto;align-self:flex-start;color:var(--vc-accent);font-size:15px}
.home-discovery-card:focus-visible,.home-discovery-all:focus-visible{outline:2px solid var(--vc-accent);outline-offset:3px}
@media(max-width:850px){.home-discovery-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:480px){.home-discovery-shortcuts{padding-top:22px}.home-discovery-heading{align-items:start}.home-discovery-heading h2{font-size:21px}.home-discovery-heading>div>p:last-child{font-size:11px}.home-discovery-all{font-size:11px;white-space:nowrap;margin-top:22px}.home-discovery-grid{gap:8px}.home-discovery-card{min-height:82px;padding:11px 9px;gap:9px;border-radius:10px}.home-discovery-icon{flex-basis:36px;width:36px;height:36px;font-size:18px}.home-discovery-copy strong{font-size:13px}.home-discovery-copy small{font-size:9px}.home-discovery-arrow{font-size:13px}}
@media(prefers-reduced-motion:reduce){.home-discovery-card,.home-discovery-all span{transition:none}}
</style>

<style>
.home-latest-section{position:relative}
.home-latest-section .catalog-heading{align-items:end}
.home-latest-section .catalog-eyebrow{color:var(--vc-accent-deep)}
.home-latest-section .catalog-more{white-space:nowrap}
@media(max-width:480px){.home-latest-section .catalog-heading{gap:10px}.home-latest-section .catalog-heading>div>p:last-child{max-width:260px;line-height:1.8}.home-latest-section .catalog-more{font-size:10px}}
</style>



