---
import '../styles/home-hybrid-v2.css';
import Base from '../layouts/Base.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { getCollection } from 'astro:content';
import { url, TYPE_PLURAL, optimizeImage } from '../consts';
import trending from '../data/trending.json';

const reviews=(await getCollection('reviews')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const byType={game:reviews.filter(x=>x.data.type==='game'),series:reviews.filter(x=>x.data.type==='series'),movie:reviews.filter(x=>x.data.type==='movie')};
const todayInAlgeria=new Intl.DateTimeFormat('en-CA',{timeZone:'Africa/Algiers'}).format(new Date());
const isUpcomingReview=review=>{
 const releaseDate=String(review.data.releaseDate||'').slice(0,10);
 return /^\d{4}-\d{2}-\d{2}$/.test(releaseDate)&&releaseDate>todayInAlgeria;
};
const topRated=[...reviews].filter(review=>review.data.score>0&&!isUpcomingReview(review)&&review.data.reviewMode==='review').sort((a,b)=>b.data.score-a.data.score).slice(0,8);
const upcoming=reviews.filter(isUpcomingReview).sort((a,b)=>String(a.data.releaseDate||'').localeCompare(String(b.data.releaseDate||''))).slice(0,8);
const trendReviews=trending.filter(item=>['مرتفع','متوسط'].includes(item.trendConfidence)).flatMap(item=>{
 const review=reviews.find(entry=>entry.data.type===item.type&&entry.data.sourceId===item.sourceId);
 if(!review)return [];
 return [{...item,review,title:review.data.title,summary:review.data.summary,poster:optimizeImage(review.data.poster||item.poster),backdrop:optimizeImage(review.data.backdrop||item.backdrop||item.poster,'backdrop'),href:url(`reviews/${review.id}/`)}];
}).slice(0,10);
const spotlight=trendReviews[0]||(topRated[0]?{...topRated[0].data,id:topRated[0].id,review:topRated[0],type:topRated[0].data.type,title:topRated[0].data.title,summary:topRated[0].data.summary,poster:optimizeImage(topRated[0].data.poster),backdrop:optimizeImage(topRated[0].data.backdrop||topRated[0].data.poster,'backdrop'),href:url('reviews/'+topRated[0].id+'/')}:null);
const featured=topRated.filter(item=>item.id!==(spotlight?.review?.id||spotlight?.id)).slice(0,3);
---
<Base title="اكتشف عالم الترفيه" description="اكتشف أحدث الأفلام والمسلسلات والألعاب، تابع الترندات العالمية واقرأ مراجعات VibeCritic." image={spotlight?.backdrop || spotlight?.poster}>
<div class="vc-home">
 <section class="wrap vc-intro">
  <div><span class="vc-overline">VIBECRITIC · ENTERTAINMENT, WITHOUT THE NOISE</span><h1>اكتشف ما يستحق<br/><em>وقتك فعلاً.</em></h1><p>مراجعات مستقلة للألعاب والأفلام والمسلسلات. رأي واضح، أدلة، ودرجات لا تجامل.</p></div>
  <div class="vc-intro-meta"><strong>{reviews.length.toLocaleString('ar-DZ')}</strong><span>مراجعة منشورة</span><a href="#library">استكشف المكتبة <b>←</b></a></div>
 </section>

 {spotlight&&<section class="wrap vc-feature-layout" aria-label="اختيار المحررين والترندات">
  <a class="vc-feature-main" href={spotlight.href} style={`--feature-image:url('${spotlight.backdrop||spotlight.poster}')`}>
   <img src={spotlight.backdrop||spotlight.poster} alt="" fetchpriority="high"/>
   <span class="vc-feature-shade"></span>
   <div class="vc-feature-copy"><span class="vc-chip">● يتصدر المشهد · {spotlight.type==='game'?'ألعاب':spotlight.type==='series'?'مسلسلات':'أفلام'}</span><p>الأكثر رواجاً الآن</p><h2>{spotlight.title}</h2><p class="vc-feature-summary">{spotlight.summary}</p><span class="vc-feature-cta">اقرأ مراجعة VibeCritic <b>←</b></span></div>
  </a>
  <aside class="vc-feature-side">
   <div class="vc-side-heading"><span>اختيارات تستحق وقتك</span><a href="#top-rated">الأعلى تقييماً ↗</a></div>
   {featured.map((review,i)=><a class="vc-side-item" href={url(`reviews/${review.id}/`)}><span class="vc-side-number">0{i+1}</span>{review.data.poster&&<img src={optimizeImage(review.data.poster)} alt="" loading="lazy"/>}<span class="vc-side-text"><small>{review.data.type==='game'?'لعبة':review.data.type==='series'?'مسلسل':'فيلم'}</small><strong>{review.data.title}</strong><span>{review.data.reviewMode==='review'?review.data.score.toFixed(1)+'/10':'قراءة استباقية'}</span></span></a>)}
   <a class="vc-side-all" href="#library">تصفّح كل المراجعات <b>←</b></a>
  </aside>
 </section>}

 <nav class="wrap vc-category-nav" aria-label="تصفح الأقسام">
  <a href={url('category/game/')}><span>🎮</span><strong>الألعاب</strong><small>{byType.game.length} مراجعة</small></a>
  <a href={url('category/movie/')}><span>🎬</span><strong>الأفلام</strong><small>{byType.movie.length} مراجعة</small></a>
  <a href={url('category/series/')}><span>📺</span><strong>المسلسلات</strong><small>{byType.series.length} مراجعة</small></a>
 </nav>

 <section class="wrap vc-section" id="trending">
  <div class="vc-section-head"><div><span class="vc-overline">WHAT PEOPLE ARE WATCHING & PLAYING</span><h2>في دائرة الاهتمام</h2><p>الأعمال الرائجة التي نملك لها مراجعة منشورة على VibeCritic</p></div><span class="vc-section-mark">TRENDING / 01</span></div>
  {trendReviews.length>0?<div class="vc-trend-grid">{trendReviews.slice(0,4).map((item,i)=><a class:list={["vc-trend-tile",{"vc-trend-wide":i===0}]} href={item.href}><img src={item.backdrop||item.poster} alt="" loading="lazy"/><span class="vc-trend-overlay"></span><span class="vc-trend-rank">TREND 0{i+1}</span><span class="vc-trend-title"><small>{item.type==='game'?'لعبة':item.type==='series'?'مسلسل':'فيلم'}</small><strong>{item.title}</strong><em>اقرأ المراجعة ←</em></span></a>)}</div>:<div class="vc-empty">ستظهر الترندات هنا عند توفر مراجعات داخلية موثقة لها.</div>}
 </section>

 <section class="wrap vc-section" id="top-rated">
  <div class="vc-section-head"><div><span class="vc-overline">EDITORIAL PICKS · SCORED WITH EVIDENCE</span><h2>الأعلى تقييماً</h2><p>درجات VibeCritic التحريرية للأعمال التي خضعت لمراجعة فعلية</p></div><a class="vc-text-link" href="#library">كل المكتبة ←</a></div>
  {topRated.length>0?<div class="vc-card-grid">{topRated.slice(0,4).map(review=><ReviewCard review={review}/>)}</div>:<div class="vc-empty">ستظهر هنا الأعمال بعد اكتمال مراجعاتها وتقييمها.</div>}
 </section>

 <section class="wrap vc-section vc-promo">
  <div><span class="vc-overline">MEET YOUR AI CRITIC</span><h2>رأيك القادم يبدأ من هنا.</h2><p>اكتشف مراجعة ذكية لفيلمك أو مسلسلك أو لعبتك المفضلة، مع تحليل ونقاط القوة والضعف.</p><a href={url('ai-review/')}>جرّب المراجع الذكي <b>←</b></a></div><div class="vc-promo-orbit"><strong>AI</strong><span>REVIEW</span></div>
 </section>

 {(['game','movie','series'] as const).map((type,i)=><section class="wrap vc-section vc-type-section">
  <div class="vc-section-head"><div><span class="vc-overline">{type==='game'?'PLAY YOUR NEXT':type==='movie'?'YOUR NEXT MOVIE':'NEXT BINGE'}</span><h2>{type==='game'?'أحدث الألعاب':type==='movie'?'أحدث الأفلام':'أحدث المسلسلات'}</h2><p>آخر ما نُشر في قسم {TYPE_PLURAL[type]}</p></div><a class="vc-text-link" href={url(`category/${type}/`)}>عرض القسم ←</a></div>
  {byType[type].length>0?<div class="vc-card-grid">{byType[type].slice(0,4).map(review=><ReviewCard review={review}/>)}</div>:<div class="vc-empty">نعمل على إثراء هذا القسم بمحتوى جديد.</div>}
 </section>)}

 <section class="wrap vc-section" id="coming-soon">
  <div class="vc-section-head"><div><span class="vc-overline">BEFORE THE RELEASE</span><h2>قراءات استباقية</h2><p>مواد تمهيدية وليست مراجعات نهائية أو درجات مكتملة</p></div></div>
  {upcoming.length>0?<div class="vc-card-grid">{upcoming.slice(0,4).map(review=><ReviewCard review={review}/>)}</div>:<div class="vc-empty">لا توجد قراءات استباقية منشورة حالياً.</div>}
 </section>

 <section class="wrap vc-section vc-library" id="library">
  <div class="vc-section-head"><div><span class="vc-overline">THE WHOLE LIBRARY</span><h2>ابحث في مكتبتنا</h2><p>اعثر على مراجعتك القادمة بسرعة</p></div><span class="vc-library-count">{reviews.length} مراجعة</span></div>
  <pagefind-searchbox placeholder="ابحث عن لعبة أو فيلم أو مسلسل..." max-results="15" hide-shortcut></pagefind-searchbox>
  <div class="vc-library-links"><a href={url('catalog/')}>فتح الكتالوج الكامل ↗</a><a href="#top-rated">العودة إلى الأعلى ↑</a></div>
 </section>
</div>
</Base>
