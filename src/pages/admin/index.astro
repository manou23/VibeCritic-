---
export const prerender = true;
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow"><title>إدارة VibeCritic</title>
<style>
:root{color-scheme:dark;--bg:#090b10;--panel:#121722;--panel2:#171f2c;--line:#273244;--text:#f4f6fa;--muted:#9aa8bb;--gold:#f4a62a;--green:#31c48d;--red:#f16b72;--blue:#70a9ff}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 85% 0,#252033 0,transparent 34%),var(--bg);color:var(--text);font:15px/1.65 system-ui,-apple-system,"Segoe UI",sans-serif}button,input,select{font:inherit}button{cursor:pointer;min-height:44px;border:1px solid var(--line);border-radius:12px;padding:9px 15px;background:var(--panel2);color:var(--text)}button.primary{background:var(--gold);color:#17120a;border-color:var(--gold);font-weight:800}button:disabled{opacity:.45;cursor:not-allowed}.shell{max-width:1240px;margin:auto;padding:22px}.top{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:22px}.brand{display:flex;gap:12px;align-items:center}.mark{width:44px;height:44px;border-radius:14px;background:linear-gradient(135deg,#ffbd55,#d87912);display:grid;place-items:center;color:#17120a;font-weight:1000;font-size:20px}.eyebrow{font-size:12px;color:var(--gold);letter-spacing:.1em}.muted{color:var(--muted)}h1{font-size:clamp(22px,4vw,32px);margin:0}h2{font-size:18px;margin:0 0 14px}.statusline{display:flex;gap:9px;align-items:center;color:var(--muted);font-size:13px}.dot{width:9px;height:9px;border-radius:50%;background:var(--green);display:inline-block}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px;margin:18px 0}.card{background:linear-gradient(145deg,var(--panel),#10151e);border:1px solid var(--line);border-radius:18px;padding:18px;min-width:0}.metric{font-size:29px;font-weight:850;line-height:1.2;margin:8px 0}.metric-label{color:var(--muted);font-size:13px}.layout{display:grid;grid-template-columns:1.15fr .85fr;gap:14px}.section{margin-top:14px}.row{display:flex;justify-content:space-between;gap:12px;align-items:center}.tag{display:inline-flex;border:1px solid var(--line);border-radius:99px;padding:3px 9px;font-size:12px;color:var(--muted)}.tag.ok{color:var(--green);border-color:#27654f}.tag.bad{color:var(--red);border-color:#66363b}.tag.warn{color:var(--gold);border-color:#6c5028}.bar{height:8px;border-radius:9px;background:#263244;overflow:hidden;margin:12px 0}.bar span{display:block;height:100%;background:linear-gradient(90deg,#e88d21,#ffd16b)}.field{display:grid;gap:6px;margin:12px 0}.field label{font-size:13px;color:var(--muted)}input,select{width:100%;min-height:44px;background:#0c1119;color:var(--text);border:1px solid var(--line);border-radius:10px;padding:9px 11px}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:14px}.list{display:grid;gap:9px}.item{padding:12px 0;border-bottom:1px solid var(--line)}.item:last-child{border:0}.item-title{font-weight:700;overflow-wrap:anywhere}.small{font-size:12px;color:var(--muted)}.error{color:#ff9ca2;white-space:pre-wrap;font-size:13px}.success{color:var(--green)}.notice{border:1px solid #69502b;background:#241d12;color:#f3cf92;border-radius:12px;padding:12px;margin:12px 0}.hidden{display:none!important}.empty{padding:24px;text-align:center;color:var(--muted)}a{color:var(--blue)}@media(max-width:850px){.grid{grid-template-columns:repeat(2,1fr)}.layout{grid-template-columns:1fr}}@media(max-width:480px){.shell{padding:14px}.top{align-items:flex-start}.formgrid{grid-template-columns:1fr}.metric{font-size:25px}}
</style></head>
<body><main class="shell">
<header class="top"><div class="brand"><div class="mark">V</div><div><div class="eyebrow">VIBECRITIC / CONTROL ROOM</div><h1>مركز إدارة الموقع</h1><div class="statusline"><span class="dot"></span> لوحة مراقبة الناشر V2</div></div></div><button id="refresh">تحديث البيانات ↻</button></header>
<div id="notice" class="notice">جارٍ التحقق من صلاحية الإدارة والاتصال بالناشر...</div>
<section class="grid">
<div class="card"><div class="metric-label">المقالات المنشورة</div><div class="metric" id="published">—</div><div class="small">وفق آخر حالة محفوظة</div></div>
<div class="card"><div class="metric-label">المقالات المتروكة</div><div class="metric" id="abandoned">—</div><div class="small">تحتاج مراجعة سبب الرفض</div></div>
<div class="card"><div class="metric-label">المهام النشطة</div><div class="metric" id="activeCount">—</div><div class="small">قيد البحث أو الكتابة أو الانتظار</div></div>
<div class="card"><div class="metric-label">آخر تحديث للحالة</div><div class="metric" id="freshness">—</div><div class="small" id="freshnessDetail">—</div></div>
</section>
<div class="layout">
<section class="card"><div class="row"><h2>حالة دورة النشر</h2><span id="activeStatus" class="tag">غير معروف</span></div><div class="item"><div class="item-title" id="activeTitle">لا توجد بيانات بعد</div><div class="small" id="activeMeta">—</div><div class="bar"><span id="progress" style="width:0%"></span></div><div class="small" id="activeError"></div></div><div class="row"><span class="muted">توزيع الحالات</span><span id="jobTotal" class="tag">0 مهمة</span></div><div id="counts" class="list"></div></section>
<section class="card"><h2>إعدادات الناشر الآلي</h2><div class="notice">تُطبق الإعدادات على محرك V2 عند نقاط الفحص المجدولة. جدول GitHub الأساسي يبقى كل 15 دقيقة لضمان عدم تفويت نافذة التشغيل.</div><div class="field"><label for="enabled">حالة الناشر</label><select id="enabled"><option value="true">مفعّل</option><option value="false">متوقف مؤقتاً</option></select></div><div class="field"><label for="interval">الفاصل بين بدايات المقالات</label><select id="interval"><option value="30">30 دقيقة</option><option value="45">45 دقيقة</option><option value="60">ساعة</option><option value="90">ساعة ونصف</option><option value="120">ساعتان</option><option value="180">3 ساعات</option></select></div><div class="formgrid"><div class="field"><label for="start">بداية نافذة التشغيل</label><input id="start" type="time" value="00:00"></div><div class="field"><label for="end">نهاية نافذة التشغيل</label><input id="end" type="time" value="23:59"></div></div><div class="field"><label for="timezone">المنطقة الزمنية</label><select id="timezone"><option value="Africa/Algiers">الجزائر (Africa/Algiers)</option><option value="Europe/Paris">باريس</option><option value="UTC">UTC</option></select></div><div class="actions"><button id="save" class="primary">حفظ الإعدادات</button><button id="run">تشغيل دورة الآن</button></div><div id="settingsMessage" class="small" aria-live="polite"></div></section>
</div>
<section class="card section"><div class="row"><h2>آخر تشغيلات GitHub Actions</h2><a href="https://github.com/manou23/VibeCritic-/actions/workflows/publishing-v2-schedule.yml" target="_blank" rel="noreferrer">فتح سجل GitHub ↗</a></div><div id="runs" class="list"><div class="empty">جارٍ التحميل...</div></div></section>
<section class="card section"><h2>الأخطاء والتنبيهات الأخيرة</h2><div id="errors" class="list"><div class="empty">جارٍ التحميل...</div></div></section>
<footer class="small" style="text-align:center;padding:22px 0">VibeCritic Admin · لا تعرض هذه الصفحة مفاتيح API أو أسرار المستودع.</footer>
</main>
<script type="module">
const $=id=>document.getElementById(id);let current=null;
const date=v=>v?new Date(v).toLocaleString("ar-DZ",{dateStyle:"medium",timeStyle:"short"}):"غير متوفر";
const ago=v=>{if(!v)return"غير معروف";const m=Math.max(0,Math.floor((Date.now()-new Date(v).getTime())/60000));return m<60?"قبل "+m+" دقيقة":"قبل "+Math.floor(m/60)+" ساعة"};
const statusName=s=>({queued:"في الانتظار",researching:"جمع المصادر",writing:"كتابة المقال",waiting:"انتظار إعادة المحاولة","quality-check":"فحص الجودة",ready:"جاهز للنشر",published:"منشور",abandoned:"متروك",rejected:"مرفوض"}[s]||s||"غير معروف");
function message(text,error=false){$("notice").textContent=text;$("notice").className=error?"notice error":"notice";}
async function request(method="GET",body){const r=await fetch("/api/admin",{method,headers:{"content-type":"application/json"},body:body?JSON.stringify(body):undefined,credentials:"same-origin"});const data=await r.json().catch(()=>({error:"استجابة غير مفهومة"}));if(!r.ok)throw Error(data.error||("HTTP "+r.status));return data;}
function render(data){
 current=data;const s=data.state||{},c=s.counts||{},active=s.active;
 $("published").textContent=s.published??0;$("abandoned").textContent=s.abandoned??0;
 $("activeCount").textContent=Object.entries(c).filter(([k])=>["queued","researching","writing","waiting","quality-check","ready"].includes(k)).reduce((n,[,v])=>n+v,0);
 $("freshness").textContent=ago(s.updatedAt);$("freshnessDetail").textContent=date(s.updatedAt);$("jobTotal").textContent=(s.total||0)+" مهمة";
 $("activeTitle").textContent=active?.title||"لا توجد مهمة نشطة";
 $("activeMeta").textContent=active?statusName(active.status)+" · المرحلة "+(active.stage||0)+"/3 · آخر محاولة: "+date(active.nextAttemptAt||s.updatedAt):"الطابور لا يحتوي حالياً على مهمة نشطة";
 $("activeStatus").textContent=active?statusName(active.status):"خامل";$("activeStatus").className="tag "+(active?.status==="waiting"?"warn":active?"ok":"");
 $("activeError").textContent=active?.lastError||"";$("progress").style.width=active?Math.min(100,(Number(active.stage||0)/3)*100)+"%":"0%";
 $("counts").innerHTML=Object.entries(c).map(([k,v])=>'<div class="row small"><span>'+statusName(k)+'</span><b>'+v+'</b></div>').join("")||'<div class="empty">لا توجد مهام مسجلة</div>';
 const st=data.settings||{};$("enabled").value=String(st.enabled!==false);$("interval").value=String(st.intervalMinutes||30);$("start").value=st.startTime||"00:00";$("end").value=st.endTime||"23:59";$("timezone").value=st.timezone||"Africa/Algiers";
 $("runs").innerHTML=(data.runs||[]).map(r=>'<div class="item row"><div><div class="item-title">'+(r.name||"V2 schedule")+' · #'+(r.run_number||r.id)+'</div><div class="small">'+r.event+' · '+date(r.created_at)+'</div></div><div style="text-align:left"><span class="tag '+(r.conclusion==="success"?"ok":r.conclusion?"bad":"warn")+'">'+(r.status==="in_progress"?"قيد التنفيذ":r.conclusion||r.status)+'</span><div class="small"><a href="'+r.html_url+'" target="_blank" rel="noreferrer">تفاصيل التشغيل ↗</a></div></div></div>').join("")||'<div class="empty">لا توجد تشغيلات حديثة.</div>';
 $("errors").innerHTML=(s.errors||[]).map(e=>'<div class="item"><div class="row"><div class="item-title">'+(e.title||e.key)+'</div><span class="tag '+(e.status==="waiting"?"warn":"bad")+'">'+statusName(e.status)+'</span></div><div class="small">'+e.key+' · '+date(e.updatedAt)+' · المرحلة '+(e.stage||0)+'/3</div><div class="error">'+e.lastError+'</div></div>').join("")||'<div class="empty">لا توجد أخطاء مسجلة في الحالة الحالية.</div>';
 const stale=s.updatedAt&&Date.now()-new Date(s.updatedAt).getTime()>45*60*1000;
 message("تم الاتصال بالمستودع "+data.repository+". "+(stale?"تحذير: بيانات الناشر قديمة؛ آخر تحديث "+ago(s.updatedAt):"بيانات الحالة متاحة وحديثة نسبياً."),!!stale);
}
async function refresh(){$("refresh").disabled=true;try{render(await request());}catch(e){message(e.message,true);}finally{$("refresh").disabled=false;}}
$("refresh").addEventListener("click",refresh);
$("save").addEventListener("click",async()=>{const btn=$("save");btn.disabled=true;$("settingsMessage").textContent="جارٍ حفظ الإعدادات في GitHub...";try{const data=await request("POST",{action:"settings",settings:{enabled:$("enabled").value==="true",intervalMinutes:Number($("interval").value),startTime:$("start").value,endTime:$("end").value,timezone:$("timezone").value}});$("settingsMessage").textContent="تم حفظ الإعدادات في "+(data.commit||"المستودع")+". ستطبقها نقاط الفحص المجدولة القادمة.";$("settingsMessage").className="small success";await refresh();}catch(e){$("settingsMessage").textContent=e.message;$("settingsMessage").className="small error";}finally{btn.disabled=false;}});
$("run").addEventListener("click",async()=>{if(!confirm("هل تريد إرسال طلب تشغيل فوري إلى GitHub Actions؟"))return;const btn=$("run");btn.disabled=true;try{const data=await request("POST",{action:"run-now"});$("settingsMessage").textContent=data.message;$("settingsMessage").className="small success";setTimeout(refresh,5000);}catch(e){$("settingsMessage").textContent=e.message;$("settingsMessage").className="small error";}finally{btn.disabled=false;}});
refresh();setInterval(refresh,60000);
</script></body></html>