---
import Base from '../layouts/Base.astro';
---
<Base title="كتالوج الأفلام والمسلسلات" description="اكتشف وابحث في كتالوج VibeCritic للأفلام والمسلسلات، مع بيانات TMDB وتفاصيل الطاقم والتصنيفات.">
<section class="wrap catalog-page">
  <header class="catalog-hero">
    <p class="catalog-eyebrow">THE ENTERTAINMENT DATABASE</p>
    <h1>اكتشف عملك القادم</h1>
    <p>مكتبة متجددة للأفلام والمسلسلات، ببحث عربي ومرشحات دقيقة وبيانات موثقة.</p>
  </header>
  <form id="catalog-filters" class="catalog-filters">
    <label class="catalog-search-label" for="catalog-query">ابحث عن فيلم أو مسلسل</label>
    <input id="catalog-query" name="q" type="search" placeholder="اسم العمل بالعربية أو بلغته الأصلية..." autocomplete="off"/>
    <div class="catalog-filter-row">
      <label>النوع<select name="type"><option value="">الكل</option><option value="movie">أفلام</option><option value="tv">مسلسلات</option></select></label>
      <label>التصنيف<select name="genre" id="catalog-genre"><option value="">كل التصنيفات</option></select></label>
      <label>سنة الإصدار<input name="year" type="number" min="1888" max="2100" inputmode="numeric" placeholder="مثلاً 2024"/></label>
      <label>الترتيب<select name="sort"><option value="popular">الأكثر رواجاً</option><option value="rating">الأعلى تقييماً</option><option value="newest">الأحدث</option><option value="title">الاسم</option></select></label>
    </div>
    <div class="catalog-filter-actions"><button type="submit" class="catalog-submit">ابحث في الكتالوج</button><button type="reset" class="catalog-reset">إعادة ضبط</button><span id="catalog-count" aria-live="polite"></span></div>
  </form>
  <div id="catalog-status" class="catalog-status" role="status" aria-live="polite">جارٍ تحميل الكتالوج...</div>
  <div id="catalog-results" class="catalog-results"></div>
  <nav class="catalog-pagination" aria-label="صفحات الكتالوج"><button id="catalog-prev" type="button" disabled>السابق</button><span id="catalog-page-label">1</span><button id="catalog-next" type="button" disabled>التالي</button></nav>
  <aside class="tmdb-attribution"><strong>TMDB</strong><span>يستخدم هذا المنتج واجهة TMDB API، لكنه غير معتمد أو مصادق عليه من TMDB.</span><a href="https://www.themoviedb.org/" target="_blank" rel="noopener noreferrer">The Movie Database</a></aside>
</section>
<dialog id="catalog-detail" class="catalog-detail" aria-labelledby="catalog-detail-title"><button type="button" id="catalog-detail-close" class="catalog-detail-close" aria-label="إغلاق النافذة">×</button><div id="catalog-detail-content"><div class="detail-loading" role="status">جارٍ تجهيز تفاصيل العمل...</div></div></dialog>
</Base>

<style>
.catalog-page{padding:54px 0 70px}.catalog-hero{padding:30px 0 34px;border-bottom:1px solid var(--vc-border)}.catalog-hero h1{font-size:clamp(32px,5vw,54px);font-weight:950;margin:10px 0}.catalog-hero>p:last-child{color:var(--vc-muted);line-height:1.9;margin:0;max-width:650px}
.catalog-filters{margin:28px 0 22px;padding:22px;background:var(--vc-surface-muted);border:1px solid var(--vc-border)}.catalog-search-label,.catalog-filter-row label{display:flex;flex-direction:column;gap:8px;font-size:12px;font-weight:850}.catalog-filters input,.catalog-filters select{min-height:45px;padding:0 12px;border:1px solid var(--vc-border);border-radius:5px;background:var(--vc-surface);color:var(--vc-text);font:inherit;min-width:0}.catalog-filters input:focus,.catalog-filters select:focus{outline:2px solid var(--vc-accent);outline-offset:1px}
.catalog-filter-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:16px}.catalog-filter-actions{display:flex;align-items:center;gap:12px;margin-top:17px;flex-wrap:wrap}.catalog-submit,.catalog-reset,.catalog-pagination button{min-height:42px;padding:0 18px;border:1px solid var(--vc-border);font:inherit;font-size:12px;font-weight:900;cursor:pointer}.catalog-submit{background:var(--vc-accent);color:white;border-color:var(--vc-accent)}.catalog-reset,.catalog-pagination button{background:var(--vc-surface);color:var(--vc-text)}.catalog-filter-actions span{margin-inline-start:auto;color:var(--vc-muted);font-size:12px}
.catalog-status{padding:18px 0;color:var(--vc-muted);font-size:13px}.catalog-results{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:20px 13px}.catalog-item{min-width:0;border:1px solid var(--vc-card-border);background:var(--vc-surface);text-align:right;cursor:pointer;padding:0;color:inherit;font:inherit;transition:transform .2s,box-shadow .2s}.catalog-item:hover{transform:translateY(-4px);box-shadow:0 12px 28px #0002}.catalog-poster{display:block;width:100%;aspect-ratio:2/3;object-fit:cover;background:var(--vc-surface-muted)}.catalog-poster-fallback{display:grid;place-items:center;aspect-ratio:2/3;padding:12px;background:var(--vc-surface-muted);font-size:13px;font-weight:900;text-align:center}.catalog-item-copy{display:block;padding:10px}.catalog-item-title{display:block;font-size:13px;font-weight:900;line-height:1.7}.catalog-item-meta{display:block;margin-top:6px;color:var(--vc-muted);font-size:10px;line-height:1.7}
.catalog-pagination{display:flex;align-items:center;justify-content:center;gap:18px;margin:30px 0}.catalog-pagination button:disabled{opacity:.4;cursor:not-allowed}.tmdb-attribution{display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap;border-top:1px solid var(--vc-border);padding:22px 0;color:var(--vc-muted);font-size:11px;text-align:center}.tmdb-attribution strong{font-size:19px;letter-spacing:-1px;color:#01b4e4}.tmdb-attribution a{color:var(--vc-accent-deep);text-decoration:underline}
.catalog-detail{position:relative;width:min(1040px,calc(100% - 28px));max-width:1040px;max-height:92vh;overflow:auto;padding:0;border:1px solid #ffffff20;border-radius:24px;background:var(--vc-surface);color:var(--vc-text);box-shadow:0 34px 110px #000b;scrollbar-width:thin}.catalog-detail::backdrop{background:rgba(3,5,9,.86);backdrop-filter:blur(12px)}.catalog-detail-close{position:sticky;z-index:10;top:14px;float:left;margin:14px 0 -54px 14px;width:42px;height:42px;display:grid;place-items:center;border:1px solid #ffffff55;border-radius:50%;background:rgba(9,12,17,.72);color:#fff;font-size:27px;line-height:1;cursor:pointer;backdrop-filter:blur(12px);transition:transform .2s,background .2s}.catalog-detail-close:hover{background:var(--vc-accent);transform:rotate(90deg)}.catalog-detail-hero{position:relative;isolation:isolate;min-height:330px;display:flex;align-items:flex-end;overflow:hidden;background:#111923}.catalog-detail-backdrop{position:absolute;z-index:-2;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 35%;opacity:.72}.catalog-detail-hero::before{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(0deg,var(--vc-surface) 0%,rgba(10,13,18,.82) 22%,rgba(10,13,18,.22) 100%),linear-gradient(90deg,rgba(5,8,12,.58),transparent 75%)}.catalog-detail-hero-copy{width:100%;padding:70px 42px 36px;color:#fff}.catalog-detail-kicker{display:inline-flex;align-items:center;gap:8px;margin:0 0 14px;padding:7px 12px;border:1px solid #ffffff55;border-radius:999px;background:#0a0d12a8;color:#fff;font-size:11px;font-weight:900;letter-spacing:.04em;backdrop-filter:blur(8px)}.catalog-detail-hero h2{max-width:760px;margin:0 0 14px;color:#fff;font-size:clamp(30px,5vw,52px);font-weight:1000;line-height:1.2;text-shadow:0 4px 24px #0008}.catalog-detail-original{margin:0 0 18px;color:#ffffffc9;font-size:14px;direction:ltr;text-align:right}.catalog-detail-hero-meta{display:flex;align-items:center;flex-wrap:wrap;gap:9px}.catalog-detail-hero-meta span{padding:7px 11px;border:1px solid #ffffff45;border-radius:8px;background:#080b10a6;color:#fff;font-size:12px;font-weight:800;backdrop-filter:blur(6px)}.catalog-detail-rating{display:inline-flex;align-items:center;gap:9px;margin:0;padding:7px 12px;border:1px solid #f4bd5a77;border-radius:9px;background:#17130cdd;color:#fff;font-size:12px;font-weight:900}.catalog-detail-rating strong{color:#ffc65c;font-size:21px;line-height:1}.catalog-detail-main{display:grid;grid-template-columns:240px minmax(0,1fr);gap:34px;padding:0 42px 38px;direction:rtl;align-items:start}.catalog-detail-poster-wrap{position:relative;margin-top:-34px;z-index:2}.catalog-detail-poster{display:block;width:100%;aspect-ratio:2/3;object-fit:cover;border:1px solid #ffffff24;border-radius:15px;background:var(--vc-surface-muted);box-shadow:0 18px 48px #0007}.catalog-detail-poster-placeholder{display:grid;place-items:center;aspect-ratio:2/3;border-radius:15px;background:var(--vc-surface-muted);color:var(--vc-muted);font-size:48px}.catalog-detail-info{min-width:0;padding-top:22px}.catalog-detail-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:0 0 24px}.catalog-detail-fact{min-width:0;padding:13px 14px;border:1px solid var(--vc-border);border-radius:12px;background:var(--vc-surface-muted)}.catalog-detail-fact span{display:block;margin-bottom:5px;color:var(--vc-muted);font-size:10px;font-weight:800}.catalog-detail-fact strong{display:block;overflow-wrap:anywhere;color:var(--vc-text);font-size:13px;font-weight:900}.catalog-detail-section{margin-top:22px}.catalog-detail-section-title{display:flex;align-items:center;gap:9px;margin:0 0 10px;font-size:16px;font-weight:950}.catalog-detail-section-title::before{content:"";width:4px;height:19px;border-radius:4px;background:var(--vc-accent)}.catalog-detail-overview{margin:0;color:var(--vc-muted);font-size:14px;line-height:2.1}.catalog-detail-people{display:flex;flex-wrap:wrap;gap:8px}.catalog-detail-person{display:flex;flex-direction:column;gap:3px;max-width:190px;padding:9px 12px;border:1px solid var(--vc-border);border-radius:10px;background:var(--vc-surface-muted)}.catalog-detail-person strong{font-size:12px;color:var(--vc-text)}.catalog-detail-person span{font-size:10px;color:var(--vc-muted)}.catalog-detail-empty{padding:55px 20px;text-align:center;color:var(--vc-muted);font-weight:800}.catalog-detail[aria-busy=true] .catalog-detail-empty::after{content:"";display:block;width:24px;height:24px;margin:15px auto 0;border:3px solid var(--vc-border);border-top-color:var(--vc-accent);border-radius:50%;animation:catalog-spin .8s linear infinite}@keyframes catalog-spin{to{transform:rotate(360deg)}}.catalog-detail[open]{animation:detail-enter .24s ease-out}@keyframes detail-enter{from{opacity:0;transform:translateY(14px) scale(.985)}to{opacity:1;transform:translateY(0) scale(1)}}@media(max-width:700px){.catalog-detail{width:calc(100% - 14px);max-height:94vh;border-radius:18px}.catalog-detail-hero{min-height:270px}.catalog-detail-hero-copy{padding:62px 20px 25px}.catalog-detail-hero h2{font-size:30px}.catalog-detail-main{grid-template-columns:112px minmax(0,1fr);gap:16px;padding:0 18px 26px}.catalog-detail-poster-wrap{margin-top:-22px}.catalog-detail-info{padding-top:14px}.catalog-detail-facts{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.catalog-detail-fact{padding:10px}.catalog-detail-fact strong{font-size:11px}.catalog-detail-overview{font-size:12px}.catalog-detail-section-title{font-size:14px}.catalog-detail-close{top:8px;margin:8px 0 -48px 8px;width:38px;height:38px}}@media(max-width:420px){.catalog-detail-main{grid-template-columns:1fr}.catalog-detail-poster-wrap{margin-top:-20px;width:112px}.catalog-detail-info{padding-top:0}.catalog-detail-facts{grid-template-columns:repeat(2,minmax(0,1fr))}.catalog-detail-hero{min-height:250px}.catalog-detail-hero h2{font-size:25px}}@media(prefers-reduced-motion:reduce){.catalog-detail[open]{animation:none}.catalog-detail-close{transition:none}.catalog-detail[aria-busy=true] .catalog-detail-empty::after{animation:none}}
@media(max-width:900px){.catalog-results{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:600px){.catalog-page{padding-top:30px}.catalog-filters{padding:14px}.catalog-filter-row{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.catalog-results{grid-template-columns:repeat(3,minmax(0,1fr));gap:13px 8px}.catalog-item-title{font-size:11px}.catalog-item-copy{padding:8px}}

/* Refined editorial typography and reading rhythm for the work details dialog */
.catalog-detail-hero-copy{max-width:1180px;margin-inline:auto;text-align:right}
.catalog-detail-kicker{margin-bottom:16px;line-height:1.5}
.catalog-detail-hero h2{max-width:720px;margin:0 0 12px;line-height:1.32;letter-spacing:-.025em;text-wrap:balance;overflow-wrap:anywhere}
.catalog-detail-original{margin:0 0 20px;line-height:1.7;letter-spacing:.01em}
.catalog-detail-hero-meta{gap:8px 10px;max-width:780px}
.catalog-detail-hero-meta span{display:inline-flex;align-items:center;min-height:34px;line-height:1.5;white-space:normal}
.catalog-detail-rating{min-height:42px;line-height:1.4}
.catalog-detail-main{gap:clamp(24px,3.5vw,42px)}
.catalog-detail-info{padding-top:18px}
.catalog-detail-facts{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:0 0 28px}
.catalog-detail-fact{min-height:72px;padding:12px 15px;display:flex;flex-direction:column;justify-content:center;gap:5px}
.catalog-detail-fact span{margin:0;font-size:11px;line-height:1.5}
.catalog-detail-fact strong{font-size:13px;line-height:1.65;overflow-wrap:anywhere}
.catalog-detail-section{margin-top:26px;padding-top:20px;border-top:1px solid var(--vc-border)}
.catalog-detail-section-title{margin:0 0 13px;font-size:16px;line-height:1.6}
.catalog-detail-overview{max-width:78ch;font-size:14px;line-height:2.15;text-align:justify;text-justify:inter-word;overflow-wrap:anywhere}
.catalog-detail-people{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
.catalog-detail-person{max-width:none;min-width:0;min-height:62px;padding:10px 13px;justify-content:center;gap:5px}
.catalog-detail-person strong{font-size:12px;line-height:1.65;overflow-wrap:anywhere}
.catalog-detail-person span{font-size:11px;line-height:1.55;overflow-wrap:anywhere}
@media(max-width:700px){
 .catalog-detail-hero-copy{padding:62px 20px 25px}
 .catalog-detail-hero h2{font-size:clamp(25px,6vw,32px);line-height:1.38}
 .catalog-detail-hero-meta{gap:7px}
 .catalog-detail-main{gap:18px}
 .catalog-detail-info{padding-top:10px}
 .catalog-detail-facts{gap:8px;margin-bottom:22px}
 .catalog-detail-fact{min-height:66px;padding:9px 11px}
 .catalog-detail-section{margin-top:21px;padding-top:16px}
 .catalog-detail-overview{font-size:13px;line-height:2;text-align:right}
 .catalog-detail-people{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:420px){
 .catalog-detail-facts{grid-template-columns:repeat(2,minmax(0,1fr))}
 .catalog-detail-people{grid-template-columns:1fr}
 .catalog-detail-person{min-height:56px}
 .catalog-detail-hero-meta span{font-size:11px;padding:6px 9px}
}

/* Larger artwork and a vivid frame that gives the text a clear visual focus */
.catalog-detail-hero{min-height:390px}
.catalog-detail-main{grid-template-columns:minmax(270px,330px) minmax(0,1fr);gap:30px;padding-inline:36px}
.catalog-detail-poster-wrap{margin-top:-48px}
.catalog-detail-poster{border:3px solid var(--vc-accent);border-radius:18px;box-shadow:0 0 0 5px color-mix(in srgb,var(--vc-accent) 20%,transparent),0 22px 55px #0009}
.catalog-detail-info{position:relative;margin-top:18px;padding:24px;border:2px solid var(--vc-accent);border-radius:18px;background:linear-gradient(145deg,color-mix(in srgb,var(--vc-accent) 12%,var(--vc-surface)),var(--vc-surface) 58%);box-shadow:0 12px 34px color-mix(in srgb,var(--vc-accent) 15%,transparent),inset 0 0 24px color-mix(in srgb,var(--vc-accent) 5%,transparent)}
.catalog-detail-info::before{content:"";position:absolute;top:-2px;right:22px;width:74px;height:4px;border-radius:0 0 6px 6px;background:var(--vc-accent);box-shadow:0 0 16px color-mix(in srgb,var(--vc-accent) 65%,transparent)}
.catalog-detail-fact{border-color:color-mix(in srgb,var(--vc-accent) 30%,var(--vc-border));background:color-mix(in srgb,var(--vc-accent) 6%,var(--vc-surface))}
.catalog-detail-section{border-top-color:color-mix(in srgb,var(--vc-accent) 30%,var(--vc-border))}
.catalog-detail-section-title::before{width:5px;height:23px;box-shadow:0 0 12px color-mix(in srgb,var(--vc-accent) 55%,transparent)}
.catalog-detail-overview{color:var(--vc-text);font-size:14px;line-height:2.2}
.catalog-detail-person{border-color:color-mix(in srgb,var(--vc-accent) 28%,var(--vc-border));background:color-mix(in srgb,var(--vc-accent) 6%,var(--vc-surface))}
@media(max-width:700px){
 .catalog-detail-hero{min-height:310px}
 .catalog-detail-main{grid-template-columns:180px minmax(0,1fr);gap:16px;padding-inline:16px}
 .catalog-detail-poster-wrap{margin-top:-30px}
 .catalog-detail-info{margin-top:12px;padding:16px;border-radius:15px}
 .catalog-detail-overview{font-size:13px;line-height:2.05}
}
@media(max-width:420px){
 .catalog-detail-main{grid-template-columns:1fr;justify-items:center}
 .catalog-detail-poster-wrap{width:min( min(72vw,250px),100%);margin-top:-28px}
 .catalog-detail-poster{width:100%}
 .catalog-detail-info{width:100%;margin-top:18px;padding:18px}
}

/* Catalog-first visual refresh: cards, filters, and the work-details window */
.catalog-page{max-width:1320px}
.catalog-hero{
  position:relative;
  isolation:isolate;
  overflow:hidden;
  padding:clamp(30px,5vw,58px) clamp(18px,3vw,34px);
  border:1px solid var(--vc-border);
  border-radius:20px;
  background:radial-gradient(ellipse at 8% 10%,color-mix(in srgb,var(--vc-accent) 19%,transparent),transparent 48%),linear-gradient(135deg,var(--vc-surface-muted),var(--vc-surface));
}
.catalog-hero::after{
  content:"VC";
  position:absolute;
  z-index:-1;
  left:3%;
  bottom:-.38em;
  color:color-mix(in srgb,var(--vc-accent) 8%,transparent);
  font-size:clamp(100px,19vw,230px);
  line-height:1;
  font-weight:1000;
  letter-spacing:-.1em;
  pointer-events:none;
}
.catalog-eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--vc-accent-deep);font-size:10px;font-weight:950;letter-spacing:.16em}
.catalog-eyebrow::before{content:"";width:24px;height:2px;background:var(--vc-accent)}
.catalog-hero h1{position:relative;font-size:clamp(34px,5vw,58px);line-height:1.2;letter-spacing:-.04em}
.catalog-hero>p:last-child{position:relative;font-size:14px}
.catalog-filters{
  position:relative;
  margin:24px 0 18px;
  padding:clamp(16px,2.5vw,25px);
  border-radius:16px;
  box-shadow:0 12px 32px #20180f0a;
}
.catalog-search-label{margin-bottom:8px}
.catalog-filters input,.catalog-filters select{border-radius:10px;transition:border-color .18s,box-shadow .18s}
.catalog-filters input:focus,.catalog-filters select:focus{border-color:var(--vc-accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--vc-accent) 15%,transparent);outline:0}
.catalog-submit,.catalog-reset,.catalog-pagination button{border-radius:10px;transition:transform .18s,box-shadow .18s,background .18s}
.catalog-submit:hover{transform:translateY(-2px);box-shadow:0 7px 18px color-mix(in srgb,var(--vc-accent) 25%,transparent)}
.catalog-reset:hover,.catalog-pagination button:not(:disabled):hover{border-color:var(--vc-accent);color:var(--vc-accent-deep)}
.catalog-status{min-height:48px;display:flex;align-items:center;gap:9px;padding:13px 2px;font-size:12px}
.catalog-status[aria-busy=true]::before{content:"";width:15px;height:15px;flex:0 0 15px;border:2px solid var(--vc-border);border-top-color:var(--vc-accent);border-radius:50%;animation:catalog-spin .8s linear infinite}
.catalog-results{grid-template-columns:repeat(6,minmax(0,1fr));gap:22px 15px}
.catalog-item{
  position:relative;
  display:flex;
  flex-direction:column;
  overflow:hidden;
  border:1px solid var(--vc-border);
  border-radius:13px;
  background:var(--vc-surface);
  box-shadow:0 5px 18px #1c160d08;
  transition:transform .22s,border-color .22s,box-shadow .22s;
}
.catalog-item:hover,.catalog-item:focus-visible{
  transform:translateY(-5px);
  border-color:var(--vc-accent);
  box-shadow:0 15px 30px #17120d1c;
  outline:none;
}
.catalog-poster-frame{position:relative;display:block;overflow:hidden;aspect-ratio:2/3;background:var(--vc-surface-muted)}
.catalog-poster{width:100%;height:100%;aspect-ratio:auto;object-fit:cover;transition:transform .45s}
.catalog-item:hover .catalog-poster{transform:scale(1.045)}
.catalog-poster-fallback{width:100%;height:100%;min-height:100%;display:grid;place-items:center;padding:12px;background:linear-gradient(145deg,var(--vc-surface-muted),var(--vc-border));font-size:13px;font-weight:900;text-align:center}
.catalog-rating-chip{
  position:absolute;top:9px;right:9px;z-index:2;
  display:inline-flex;align-items:center;gap:4px;
  padding:6px 8px;border:1px solid #ffffff45;border-radius:8px;
  background:#10151bdc;color:#ffd078;font-size:11px;font-weight:950;
  box-shadow:0 3px 12px #0003;backdrop-filter:blur(8px);
}
.catalog-open-hint{
  position:absolute;inset:auto 8px 8px;z-index:2;
  padding:8px 6px;border:1px solid #ffffff35;border-radius:8px;
  background:#10151bd9;color:#fff;text-align:center;font-size:10px;font-weight:900;
  opacity:0;transform:translateY(5px);transition:opacity .2s,transform .2s;
}
.catalog-item:hover .catalog-open-hint,.catalog-item:focus-visible .catalog-open-hint{opacity:1;transform:translateY(0)}
.catalog-item-copy{flex:1;padding:11px 11px 12px}
