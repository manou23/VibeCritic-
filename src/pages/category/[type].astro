---
import Base from '../../layouts/Base.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import { getCollection } from 'astro:content';
import { TYPE_LABEL, TYPE_PLURAL, type ReviewType } from '../../consts';
export function getStaticPaths(){return ['game','movie','series'].map(type=>({params:{type}}));}
const type=Astro.params.type as ReviewType;
const all=await getCollection('reviews',({data})=>data.type===type);
const reviews=all.sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title={TYPE_PLURAL[type]}>
<section class="container py-12"><p class="text-sm text-violet-300">التصنيفات</p><h1 class="mt-2 text-4xl font-black">{TYPE_PLURAL[type]}</h1><p class="mt-3 text-zinc-400">كل مراجعات {TYPE_PLURAL[type]} في مكان واحد.</p>
{reviews.length?<div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">{reviews.map(review=><ReviewCard review={review}/>)}</div>:<div class="glass mt-8 rounded-2xl p-10 text-center"><p class="text-lg font-bold">لا توجد مراجعات منشورة بعد</p><p class="mt-2 text-zinc-400">ستظهر مراجعات {TYPE_LABEL[type]} هنا عند توفرها.</p></div>}
</section>
</Base>
