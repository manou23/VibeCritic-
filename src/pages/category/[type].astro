---
import Base from '../../layouts/Base.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import { getCollection } from 'astro:content';
import { TYPE_LABEL, TYPE_PLURAL, type ReviewType, url, optimizeImage } from '../../consts';
export function getStaticPaths(){return ['game','movie','series'].map(type=>({params:{type}}));}
const type=Astro.params.type as ReviewType;
const all=await getCollection('reviews',({data})=>data.type===type);
const reviews=all.sort((a,b)=>(b.data.publishedAt??b.data.date).valueOf()-(a.data.publishedAt??a.data.date).valueOf());
const normalizeArabic=value=>String(value||'').toLocaleLowerCase('ar').normalize('NFKD').replace(/\p{M}/gu,'').replace(/[أإآٱ]/g,'ا').replace(/ة/g,'ه').replace(/ى/g,'ي').replace(/ؤ/g,'و').replace(/ئ/g,'ي').replace(/[^\p{L}\p{N}\s]/gu,' ').trim().replace(/\s+/g,' ');
const featured=reviews[0];
const years=[...new Set(reviews.map(review=>review.data.releaseDate ? Number(review.data.releaseDate.slice(0,4)) : review.data.date.getFullYear()))].filter(Number.isFinite).sort((a,b)=>b-a);
const genres=[...new Set(reviews.flatMap(review=>review.data.genres||[]))].sort((a,b)=>a.localeCompare(b,'ar'));
const platforms=[...new Set(reviews.flatMap(review=>review.data.platforms||[]))].sort((a,b)=>a.localeCompare(b,'ar'));
const copy={game:{en:'GAMES & INTERACTIVE',title:'اكتشف عالم الألعاب',desc:'إصدارات جديدة، تجارب تستحق وقتك، ومراجعات تساعدك تختار لعبتك القادمة.'},series:{en:'SERIES & TV',title:'اكتشف عالم المسلسلات',desc:'تابع أحدث المسلسلات، الأعمال الرائجة، والمراجعات قبل أن تبدأ المشاهدة.'},movie:{en:'MOVIES & CINEMA',title:'اكتشف عالم الأفلام',desc:'أحدث الأفلام، اختيارات السهرة، ومراجعات صريحة بلا حرق.'}}[type];
---
<Base title={TYPE_PLURAL[type]} description={copy.desc} image={optimizeImage(featured?.data.backdrop || featured?.data.poster, 'backdrop')} noindex={reviews.length === 0}>
<section class="wrap category-discovery">
 {featured?.data.backdrop&&<img src={optimizeImage(featured.data.backdrop, 'backdrop')} alt="" class="category-backdrop" loading="eager" fetchpriority="high" decoding="async"/>}
 <div class="category-overlay"></div>
 <div class="category-discovery-copy"><p class="catalog-eyebrow">{copy.en}</p><h1>{copy.title}</h1><p>{copy.desc}</p><div class="category-stat"><strong>{reviews.length}</strong><span>مراجعة منشورة في {TYPE_PLURAL[type]}</span></div></div>
</section>
<section class="wrap catalog-section">
 <div class="catalog-heading"><div><p class="catalog-eyebrow">LATEST REVIEWS</p><h2>مكتبة {TYPE_PLURAL[type]}</h2><p>ابحث وصفِّ النتائج ورتّبها حسب ما يهمك</p></div><span class="catalog-total" id="category-result-count" aria-live="polite">{reviews.length} مراجعة</span></div>
 {reviews.length>0&&<div class="category-filters" aria-label="تصفية المراجعات">
  <label class="category-filter-field">بحث
   <input id="review-search" type="search" list="review-title-suggestions" placeholder="اسم العمل أو العنوان..." autocomplete="off" aria-describedby="review-search-help"/><datalist id="review-title-suggestions">{reviews.map(review=><option value={review.data.title}/>)}{reviews.filter(review=>review.data.originalTitle).map(review=><option value={review.data.originalTitle}/>)}</datalist><span id="review-search-help" class="category-search-help">يدعم اختلاف الألف والهمزة والتاء المربوطة والتشكيل</span>
  </label>
  <label class="category-filter-field">النوع
   <select id="review-genre"><option value="all">كل التصنيفات</option>{genres.map(genre=><option value={genre.toLowerCase()}>{genre}</option>)}</select>
  </label>
  {type==='game'&&<label class="category-filter-field">المنصة
   <select id="review-platform"><option value="all">كل المنصات</option>{platforms.map(platform=><option value={platform.toLowerCase()}>{platform}</option>)}</select>
  </label>}
  <label class="category-filter-field">السنة
   <select id="review-year"><option value="all">كل السنوات</option>{years.map(year=><option value={year}>{year}</option>)}</select>
  </label>
  <label class="category-filter-field">الحد الأدنى للدرجة
   <select id="review-min-score"><option value="0">كل الدرجات</option><option value="6">6 / 10 فأعلى</option><option value="7">7 / 10 فأعلى</option><option value="8">8 / 10 فأعلى</option><option value="9">9 / 10 فأعلى</option></select>
  </label>
  <label class="category-filter-field">الترتيب
   <select id="review-sort"><option value="newest">الأحدث أولاً</option><option value="highest">الأعلى تقييماً</option><option value="lowest">الأقل تقييماً</option></select>
  </label>
 </div>}
 {reviews.length?<div class="category-review-grid" id="category-review-grid">{reviews.map(review=><div class="category-review-item" data-title={normalizeArabic([review.data.title,review.data.originalTitle,review.data.headline,...(review.data.tags||[]),...(review.data.genres||[])].join(' '))} data-year={review.data.releaseDate?.slice(0,4)||String(review.data.date.getFullYear())} data-score={review.data.score} data-rated={review.data.reviewMode==='review'} data-date={(review.data.publishedAt??review.data.date).toISOString()} data-genres={(review.data.genres||[]).join('|').toLowerCase()} data-platforms={(review.data.platforms||[]).join('|').toLowerCase()}><ReviewCard review={review}/></div>)}</div>:<div class="catalog-empty">قسم {TYPE_PLURAL[type]} قيد الإثراء. ستظهر هنا الأعمال الجديدة ومراجعاتها تلقائياً.</div>}
 <div class="catalog-empty" id="category-filter-empty" hidden>لا توجد مراجعات تطابق خيارات التصفية الحالية.</div>
 <nav class="category-pagination" id="category-pagination" aria-label="صفحات المراجعات" hidden></nav>
</section>
{type === 'movie' && <section class="wrap curated-links" aria-label="تصنيفات الأفلام الدقيقة"><h2>استكشف حسب النوع</h2><a href={url('collections/horror-films/')}>أفلام الرعب <span>←</span></a></section>}
{type === 'game' && <section class="wrap curated-links" aria-label="تصنيفات الألعاب الدقيقة"><h2>استكشف حسب المنصة</h2><a href={url('collections/android-games/')}>ألعاب أندرويد <span>←</span></a></section>}
<section class="wrap category-switcher">
 <a href={url('category/game/')} class={type==='game'?'active':''}>الألعاب</a><a href={url('category/series/')} class={type==='series'?'active':''}>المسلسلات</a><a href={url('category/movie/')} class={type==='movie'?'active':''}>الأفلام</a>
</section>
</Base>

<script>
const grid=document.querySelector<HTMLElement>('#category-review-grid');
if(grid){
 const cards=[...grid.querySelectorAll<HTMLElement>('.category-review-item')];
 const search=document.querySelector<HTMLInputElement>('#review-search');
 const genre=document.querySelector<HTMLSelectElement>('#review-genre');
 const platform=document.querySelector<HTMLSelectElement>('#review-platform');
 const year=document.querySelector<HTMLSelectElement>('#review-year');
 const minScore=document.querySelector<HTMLSelectElement>('#review-min-score');
 const sort=document.querySelector<HTMLSelectElement>('#review-sort');
 const count=document.querySelector<HTMLElement>('#category-result-count');
 const empty=document.querySelector<HTMLElement>('#category-filter-empty');
 const pagination=document.querySelector<HTMLElement>('#category-pagination');
 const pageSize=20;
 let currentPage=Math.max(1,Number(new URLSearchParams(location.search).get('page'))||1);
 let matchingCards:HTMLElement[]=[];
 const normalize=value=>String(value||'').toLocaleLowerCase('ar').normalize('NFKD').replace(/\p{M}/gu,'').replace(/[أإآٱ]/g,'ا').replace(/ة/g,'ه').replace(/ى/g,'ي').replace(/ؤ/g,'و').replace(/ئ/g,'ي').replace(/[^\p{L}\p{N}\s]/gu,' ').trim().replace(/\s+/g,' ');
 const renderPagination=(totalPages:number)=>{
  if(!pagination)return;
  pagination.replaceChildren();
  pagination.hidden=totalPages<=1;
  if(totalPages<=1)return;
  const addButton=(label:string,page:number,disabled=false,active=false)=>{
   const button=document.createElement('button');
   button.type='button';button.textContent=label;button.disabled=disabled;
   if(active){button.className='is-active';button.setAttribute('aria-current','page');}
   button.addEventListener('click',()=>{currentPage=page;renderPage();grid.scrollIntoView({behavior:'smooth',block:'start'});});
   pagination.append(button);
  };
  addButton('السابق',currentPage-1,currentPage===1);
  const pages=new Set<number>([1,totalPages,currentPage-1,currentPage,currentPage+1]);
  const ordered=[...pages].filter(page=>page>=1&&page<=totalPages).sort((a,b)=>a-b);
  let previous=0;
  for(const page of ordered){
   if(previous&&page-previous>1){const dots=document.createElement('span');dots.className='category-page-dots';dots.textContent='…';pagination.append(dots);}
   addButton(String(page),page,false,page===currentPage);
   previous=page;
  }
  addButton('التالي',currentPage+1,currentPage===totalPages);
 };
 const renderPage=()=>{
  const totalPages=Math.max(1,Math.ceil(matchingCards.length/pageSize));
  currentPage=Math.min(Math.max(1,currentPage),totalPages);
  const first=(currentPage-1)*pageSize;
  const visible=new Set(matchingCards.slice(first,first+pageSize));
  cards.forEach(card=>{card.hidden=!visible.has(card);});
  if(count)count.textContent=matchingCards.length+' من '+cards.length+' مراجعة · الصفحة '+currentPage+' من '+totalPages;
  if(empty)empty.hidden=matchingCards.length!==0;
  renderPagination(totalPages);
  const url=new URL(location.href);
  if(currentPage===1)url.searchParams.delete('page');else url.searchParams.set('page',String(currentPage));
  history.replaceState({},'',url);
 };
 const update=(resetPage=true)=>{
  const term=normalize(search?.value||'');
  const selectedGenre=genre?.value||'all';
  const selectedPlatform=platform?.value||'all';
  const selectedYear=year?.value||'all';
  const minimum=Number(minScore?.value||0);
  const order=sort?.value||'newest';
  matchingCards=cards.filter(card=>{
   const title=card.dataset.title||'';
   const genres=(card.dataset.genres||'').split('|');
   return (!term||title.includes(term))
    &&(selectedGenre==='all'||genres.includes(selectedGenre))
    &&(selectedPlatform==='all'||(card.dataset.platforms||'').split('|').includes(selectedPlatform))
    &&(selectedYear==='all'||card.dataset.year===selectedYear)
    &&(minimum===0||(card.dataset.rated==='true'&&Number(card.dataset.score||0)>=minimum));
  });
  matchingCards.sort((a,b)=>{
   if(order==='highest'||order==='lowest'){
    const aRated=a.dataset.rated==='true',bRated=b.dataset.rated==='true';
    if(aRated!==bRated)return aRated?-1:1;
    if(aRated&&bRated)return order==='highest'?Number(b.dataset.score)-Number(a.dataset.score):Number(a.dataset.score)-Number(b.dataset.score);
   }
   return String(b.dataset.date).localeCompare(String(a.dataset.date));
  });
  matchingCards.forEach(card=>grid.append(card));
  if(resetPage)currentPage=1;
  renderPage();
 };
 [search,genre,platform,year,minScore,sort].forEach(control=>control?.addEventListener('input',()=>update(true)));
 [genre,platform,year,minScore,sort].forEach(control=>control?.addEventListener('change',()=>update(true)));
 window.addEventListener('popstate',()=>{currentPage=Math.max(1,Number(new URLSearchParams(location.search).get('page'))||1);renderPage();});
 update(false);
}
</script>>

<style>
.category-pagination{
 display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:6px;
 width:100%;max-width:760px;margin:38px auto 18px;padding:16px 0;
 border-top:1px solid var(--vc-border);border-bottom:1px solid var(--vc-border);
 background:transparent;direction:rtl
}
.category-pagination[hidden]{display:none}
.category-pagination button{
 position:relative;display:inline-flex;align-items:center;justify-content:center;
 min-width:42px;height:42px;padding:0 12px;
 border:1px solid transparent;border-radius:2px;
 background:transparent;color:var(--vc-text);
 font:inherit;font-size:13px;font-weight:850;line-height:1;
 cursor:pointer;
 transition:background .18s ease,border-color .18s ease,color .18s ease
}
.category-pagination button:not(:disabled):not(.is-active):hover{
 border-color:var(--vc-border);background:var(--vc-surface-muted);color:var(--vc-accent-deep)
}
.category-pagination button:focus-visible{outline:2px solid var(--vc-accent);outline-offset:3px}
.category-pagination button:disabled{
 color:var(--vc-muted);opacity:.42;cursor:not-allowed
}
.category-pagination button.is-active{
 border-color:var(--vc-logo-bg);background:var(--vc-logo-bg);color:var(--vc-on-dark);
 box-shadow:inset 0 3px 0 var(--vc-accent)
}
.category-pagination button.is-active:hover{background:var(--vc-logo-bg);color:var(--vc-on-dark)}
.category-pagination button:first-child,.category-pagination button:last-child{
 min-width:78px;padding-inline:15px;border-color:var(--vc-border);
 color:var(--vc-accent-deep);font-size:12px;font-weight:900
}
.category-pagination button:first-child:not(:disabled):hover,.category-pagination button:last-child:not(:disabled):hover{
 border-color:var(--vc-accent);background:var(--vc-accent);color:#fff
}
.category-page-dots{display:inline-flex;align-items:center;justify-content:center;min-width:20px;color:var(--vc-muted);font-size:13px;user-select:none}
.dark-mode .category-pagination{border-color:var(--vc-border)}
.dark-mode .category-pagination button:not(:disabled):not(.is-active):hover{background:var(--vc-surface-muted);border-color:var(--vc-border);color:var(--vc-accent)}
.dark-mode .category-pagination button.is-active{background:var(--vc-accent);border-color:var(--vc-accent);color:#fff;box-shadow:inset 0 3px 0 rgba(255,255,255,.28)}
.dark-mode .category-pagination button:first-child,.dark-mode .category-pagination button:last-child{color:var(--vc-accent)}
.category-review-item[hidden]{display:none!important}
@media(max-width:480px){
 .category-pagination{gap:3px;margin-top:28px;padding:12px 0}
 .category-pagination button{min-width:36px;height:40px;padding-inline:8px;font-size:12px}
 .category-pagination button:first-child,.category-pagination button:last-child{min-width:64px;padding-inline:8px;font-size:11px}
 .category-page-dots{min-width:14px}
}
@media(prefers-reduced-motion:reduce){.category-pagination button{transition:none}}
</style>
