---
import Base from '../../layouts/Base.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import { getCollection } from 'astro:content';
import { TYPE_LABEL, TYPE_PLURAL, type ReviewType } from '../../consts';
export function getStaticPaths(){return ['game','movie','series'].map(type=>({params:{type}}));}
const type=Astro.params.type as ReviewType;
const all=await getCollection('reviews',({data})=>data.type===type);
const reviews=all.sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title={TYPE_PLURAL[type]}>
<section class="wrap py-12">
<p class="eyebrow">VIBECRITIC / التصنيفات</p>
<div class="mt-5 flex flex-wrap items-end justify-between gap-4 border-b border-[#d9d3c7] pb-7">
<div><h1 class="text-5xl font-black tracking-tight">{TYPE_PLURAL[type]}</h1><p class="mt-3 text-sm text-[#777066]">قراءات ومراجعات {TYPE_PLURAL[type]}، دون حرق وبلا مجاملة.</p></div>
<span class="text-xs font-bold text-[#b34b30]">{reviews.length} مراجعة</span>
</div>
{reviews.length?<div class="review-grid mt-8">{reviews.map(review=><ReviewCard review={review}/>)}</div>:<div class="empty-state mt-8"><p class="text-4xl">✳</p><p class="mt-4 text-lg font-black">لا توجد مراجعات منشورة بعد</p><p class="mt-2 text-sm text-[#777066]">ستظهر مراجعات {TYPE_LABEL[type]} هنا عند نشرها.</p></div>}
</section>
</Base>
