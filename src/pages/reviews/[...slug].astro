---
import Base from '../../layouts/Base.astro';
import ScoreCard from '../../components/ScoreCard.astro';
import { getCollection, render } from 'astro:content';
import { TYPE_LABEL, fmtDate, url, optimizeImage, SITE_NAME } from '../../consts';
export async function getStaticPaths(){const reviews=await getCollection('reviews');return reviews.map(review=>({params:{slug:review.id},props:{review}}));}
const {review}=Astro.props;const {Content}=await render(review);const d=review.data;

const typeLabel = TYPE_LABEL[d.type];
const youtubeVideoId = /^[A-Za-z0-9_-]{11}$/.test(d.youtubeVideoId || '') ? d.youtubeVideoId : null;
const youtubeVideoTitle = d.youtubeVideoTitle || `المقطع الرسمي لـ ${d.title}`;
const typeKeyword = d.type === 'game' ? 'لعبة' : d.type === 'series' ? 'مسلسل' : 'فيلم';
const cleanKeyword = (value) => String(value || '').replace(/[<>"']/g, '').replace(/\s+/g, ' ').trim();
const reviewKeywords = [...new Set([
  d.title,
  d.originalTitle,
  typeKeyword + ' ' + d.title,
  'مراجعة ' + d.title,
  'تقييم ' + d.title,
  'قصة ' + d.title,
  'مراجعة ' + typeKeyword,
  'تقييم ' + typeKeyword,
  'مراجعة نقدية',
  'تحليل فني',
  ...(d.genres || []),
  ...(d.tags || []),
].map(cleanKeyword).filter(Boolean))].slice(0, 20);
const reviewDescription = d.title + ' — مراجعة ' + typeKeyword + ' وتحليل نقدي للقصة والعناصر الفنية. ' + d.summary + ' تقييم VibeCritic: ' + d.score + '/10.';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const schemaType = d.type === 'game' ? 'Game' : d.type === 'series' ? 'CreativeWorkSeries' : 'Movie';
const reviewStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  name: d.title + ' — مراجعة وتقييم',
  url: canonicalUrl,
  datePublished: d.date.toISOString().slice(0, 10),
  reviewBody: [d.summary, d.verdict, d.hook].filter(Boolean).join(' '),
  reviewRating: {
    '@type': 'Rating',
    ratingValue: d.score,
    bestRating: 10,
    worstRating: 0,
  },
  author: { '@type': 'Organization', name: SITE_NAME },
  itemReviewed: {
    '@type': schemaType,
    name: d.title,
    ...(d.originalTitle ? { alternateName: d.originalTitle } : {}),
    ...(d.genres?.length ? { genre: d.genres } : {}),
    ...(d.releaseDate ? { datePublished: d.releaseDate } : {}),
    ...(d.poster ? { image: optimizeImage(d.poster) } : {}),
  },
};

---
<Base title={`${d.title} — مراجعة وتقييم`} description={reviewDescription} keywords={reviewKeywords} structuredData={reviewStructuredData} image={optimizeImage(d.backdrop || d.poster, 'backdrop')} pageType="article" publishedAt={d.date.toISOString()}>
<article class="wrap article-page">
  <a href={url('')} class="article-back">← العودة إلى VibeCritic</a>
  <header class="article-header">
    <p class="eyebrow">VIBECRITIC / قراءة نقدية تحريرية</p>
    <div class="article-meta">
      <span class="article-category">{typeLabel}</span>
      <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
      {d.aiGenerated&&<span class="article-ai">تحليل مدعوم بالذكاء الاصطناعي</span>}
    </div>
    <h1>{d.title}</h1>
    <p class="article-deck">{d.headline}</p>
  </header>

  {d.backdrop&&<figure class="article-backdrop"><img src={optimizeImage(d.backdrop, 'backdrop')} alt={d.title} loading="eager" fetchpriority="high" decoding="async"/><figcaption>VibeCritic — قراءة نقدية بلا مجاملة</figcaption></figure>}

  <div class="article-layout">
    <div class="article-main">
      <section class="article-hook">
        <p class="eyebrow">المدخل النقدي</p>
        <p>{d.hook || d.headline}</p>
      </section>
      {youtubeVideoId && <section class="article-video" aria-labelledby="article-video-title">
        <div class="article-video-heading">
          <p class="eyebrow">من YouTube الرسمي</p>
          <h2 id="article-video-title">شاهد المقطع</h2>
        </div>
        <div class="article-video-frame">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${youtubeVideoId}`}
            title={youtubeVideoTitle}
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
        <p class="article-video-note">يُعرض المقطع عبر مشغل YouTube المضمّن؛ حقوق الفيديو وإتاحته تبقى لصاحب القناة وYouTube.</p>
      </section>}
      <section class="article-summary">
        <p class="eyebrow">عن العمل</p>
        <p>{d.summary}</p>
      </section>
      <div class="article-body prose"><Content/></div>
      <div class="article-verdict-grid">
        <section class="verdict-panel pros-panel">
          <h2><span>+</span> نقاط القوة</h2>
          <ul>{d.pros.map(x=><li>{x}</li>)}</ul>
        </section>
        <section class="verdict-panel cons-panel">
          <h2><span>−</span> نقاط الضعف</h2>
          {d.cons.length>0?<ul>{d.cons.map(x=><li>{x}</li>)}</ul>:<p>لم تتوفر تحفظات موثوقة كافية لإثبات نقاط ضعف محددة.</p>}
        </section>
      </div>
      <section class="article-final-verdict">
        <p class="eyebrow">الحكم النهائي</p>
        <h2>هل يستحق وقتك؟</h2>
        <p>{d.verdict || 'تتحدد قيمة هذا العمل بحسب مدى اهتمامك بنوعه وعناصره الفنية، مع مراعاة نقاط القوة والتحفظات المذكورة أعلاه.'}</p>
      </section>
      <p class="review-method-note">منهجية VibeCritic: هذا تقييم تحريري مبني على المعلومات المنشورة والبيانات المتاحة، وليس ادعاءً باختبار مباشر للعمل. الدرجة تقدير نقدي مستقل وليست تقييماً رسمياً.</p>
      <section class="article-comments" data-comments-section data-review-slug={review.id} aria-labelledby="comments-title">
        <div class="comments-heading">
          <div>
            <p class="eyebrow">COMMUNITY / DISCUSSION</p>
            <h2 id="comments-title">مساحة النقاش</h2>
            <p class="comments-intro">شارك رأيك في هذا العمل باحترام ووضوح.</p>
          </div>
          <span class="comments-count" data-comments-count>0 تعليق منشور</span>
        </div>
        <div class="comments-demo" data-demo-comments>
          <div class="comments-demo-label"><span aria-hidden="true">✦</span> أمثلة تجريبية — ليست تعليقات زوار حقيقيين</div>
          <article class="comment-card comment-demo-card">
            <div class="comment-avatar" aria-hidden="true">ت</div>
            <div class="comment-content">
              <div class="comment-meta"><strong>نموذج تجريبي 01</strong><span>مثال توضيحي</span></div>
              <p>أي عنصر في هذا العمل تعتقد أنه يستحق نقاشاً أعمق؟ هذه مساحة لبدء الحوار حول المراجعة.</p>
              <span class="comment-demo-tag">تعليق تجريبي</span>
            </div>
          </article>
          <article class="comment-card comment-demo-card">
            <div class="comment-avatar" aria-hidden="true">ت</div>
            <div class="comment-content">
              <div class="comment-meta"><strong>نموذج تجريبي 02</strong><span>مثال توضيحي</span></div>
              <p>يمكنك مشاركة قراءة مختلفة للعمل، أو الإشارة إلى نقطة اتفقت أو اختلفت معها في التقييم.</p>
              <span class="comment-demo-tag">تعليق تجريبي</span>
            </div>
          </article>
        </div>
        <div class="comments-list" data-comments-list aria-live="polite">
          <p class="comments-loading">جارٍ التحقق من التعليقات المنشورة…</p>
        </div>
        <form class="comments-form" data-comments-form>
          <div class="comments-form-heading">
            <h3>أضف تعليقك</h3>
            <p>ستتم مراجعة التعليق قبل ظهوره للزوار.</p>
          </div>
          <label for="comment-nickname">اسم مستعار</label>
          <input id="comment-nickname" name="nickname" type="text" maxlength="32" minlength="2" autocomplete="nickname" placeholder="كيف نُناديك؟" required />
          <label for="comment-body">تعليقك</label>
          <textarea id="comment-body" name="body" rows="4" maxlength="700" minlength="8" placeholder="اكتب رأيك حول هذا العمل…" required></textarea>
          <div class="comments-form-trap" aria-hidden="true">
            <label for="comment-website">اترك هذا الحقل فارغاً</label>
            <input id="comment-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="comments-form-footer">
            <span class="comments-form-status" data-comments-status role="status">التعليقات تخضع للمراجعة قبل النشر.</span>
            <button type="submit" class="comments-submit" data-comments-submit disabled>إرسال التعليق</button>
          </div>
        </form>
      </section>
      <a href={url('')} class="article-return">اكتشف مراجعات أخرى <span>←</span></a>
    </div>
    <aside class="article-aside" aria-label="ملخص ومعلومات العمل">
      {d.poster&&<img class="article-poster" src={optimizeImage(d.poster)} alt={d.title} loading="lazy" decoding="async" width="600" height="900"/>}
      <div class="article-score-wrap"><p class="eyebrow">تقييم VibeCritic</p><ScoreCard score={d.score}/><p class="article-score-note">من 10 — رأينا، والقرار لك.</p></div>
      {(d.releaseDate || d.creator || d.genres?.length) && <section class="article-facts" aria-label="معلومات العمل">
        <h2>بطاقة العمل</h2>
        <dl>
          {d.releaseDate && <div><dt>تاريخ الإصدار</dt><dd>{d.releaseDate}</dd></div>}
          {d.creator && <div><dt>الجهة</dt><dd>{d.creator}</dd></div>}
          {d.genres?.length > 0 && <div><dt>التصنيف</dt><dd>{d.genres.join('، ')}</dd></div>}
        </dl>
      </section>}
    </aside>
  </div>
</article>

<script>
document.querySelectorAll('[data-comments-section]').forEach((section) => {
  const slug = section.getAttribute('data-review-slug');
  const list = section.querySelector('[data-comments-list]');
  const count = section.querySelector('[data-comments-count]');
  const form = section.querySelector('[data-comments-form]');
  const submit = section.querySelector('[data-comments-submit]');
  const status = section.querySelector('[data-comments-status]');
  const endpoint = '/api/comments';

  const setStatus = (message, error = false) => {
    if (!status) return;
    status.textContent = message;
    status.classList.toggle('is-error', error);
  };

  const renderComments = (comments) => {
    if (!list || !count) return;
    list.replaceChildren();
    count.textContent = comments.length + (comments.length === 1 ? ' تعليق منشور' : ' تعليقات منشورة');
    if (!comments.length) {
      const empty = document.createElement('p');
      empty.className = 'comments-empty';
      empty.textContent = 'لا توجد تعليقات منشورة بعد. كن أول من يشارك رأيه.';
      list.append(empty);
      return;
    }
    comments.forEach((comment) => {
      const card = document.createElement('article');
      card.className = 'comment-card';
      const avatar = document.createElement('div');
      avatar.className = 'comment-avatar';
      avatar.setAttribute('aria-hidden', 'true');
      avatar.textContent = String(comment.nickname || '?').trim().charAt(0) || '?';
      const content = document.createElement('div');
      content.className = 'comment-content';
      const meta = document.createElement('div');
      meta.className = 'comment-meta';
      const name = document.createElement('strong');
      name.textContent = comment.nickname || 'زائر';
      const date = document.createElement('time');
      const parsed = new Date(comment.created_at);
      date.textContent = Number.isNaN(parsed.getTime()) ? '' : new Intl.DateTimeFormat('ar-DZ', {dateStyle:'medium'}).format(parsed);
      meta.append(name, date);
      const body = document.createElement('p');
      body.textContent = comment.body || '';
      content.append(meta, body);
      card.append(avatar, content);
      list.append(card);
    });
  };

  const loadComments = async () => {
    try {
      const response = await fetch(endpoint + '?slug=' + encodeURIComponent(slug), {headers:{'Accept':'application/json'}});
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'تعذر الاتصال بخدمة التعليقات.');
      renderComments(Array.isArray(data.comments) ? data.comments : []);
      if (submit) submit.disabled = false;
      setStatus('تعليقك سيظهر بعد مراجعته من إدارة الموقع.');
    } catch (error) {
      if (list) {
        list.replaceChildren();
        const note = document.createElement('p');
        note.className = 'comments-loading';
        note.textContent = 'التعليقات الحقيقية ستتاح بعد اكتمال إعداد الخدمة.';
        list.append(note);
      }
      if (submit) submit.disabled = true;
      setStatus('خدمة التعليقات قيد الإعداد؛ أمثلة العرض موسومة بوضوح بأنها تجريبية.');
    }
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity() || !submit) return;
    const fields = new FormData(form);
    submit.disabled = true;
    submit.textContent = 'جارٍ الإرسال…';
    setStatus('جارٍ إرسال تعليقك بأمان…');
    try {
      const response = await fetch(endpoint, {
        method:'POST',
        headers:{'content-type':'application/json','accept':'application/json'},
        body:JSON.stringify({
          slug,
          nickname:fields.get('nickname'),
          body:fields.get('body'),
          website:fields.get('website')
        })
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'تعذر إرسال التعليق.');
      form.reset();
      setStatus('وصل تعليقك بنجاح، وسيظهر بعد مراجعته. شكراً لمشاركتك!');
    } catch (error) {
      setStatus(error.message || 'حدث خطأ. حاول مرة أخرى.', true);
    } finally {
      submit.disabled = false;
      submit.textContent = 'إرسال التعليق';
    }
  });

  loadComments();
});
</script>

</Base>
