  .related-reviews-heading{margin-bottom:1.15rem}
  .related-reviews-heading h2{margin:.2rem 0 .4rem;color:var(--vc-text);font-size:clamp(1.15rem,2.5vw,1.45rem)}
  .related-reviews-heading>p:last-child{margin:0;color:var(--vc-muted);font-size:.9rem;line-height:1.7}
  .related-reviews-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.85rem}
  .related-review-card{display:grid;grid-template-columns:84px minmax(0,1fr);gap:.8rem;min-width:0;padding:.7rem;border:1px solid var(--vc-border,rgba(255,255,255,.1));border-radius:15px;background:rgba(0,0,0,.13);color:inherit;text-decoration:none;transition:border-color .18s ease,transform .18s ease,background .18s ease}
  .related-review-card:hover{transform:translateY(-3px);border-color:rgba(240,153,54,.55);background:rgba(240,153,54,.055)}
  .related-review-poster{position:relative;overflow:hidden;aspect-ratio:2/3;border-radius:9px;background:rgba(255,255,255,.06);display:grid;place-items:center;color:var(--vc-accent,#f09936)}
  .related-review-poster img{width:100%;height:100%;object-fit:cover}
  .related-review-type{position:absolute;right:.3rem;bottom:.3rem;padding:.18rem .4rem;border:1px solid rgba(255,255,255,.18);border-radius:6px;background:rgba(0,0,0,.78);color:#fff;font-size:.65rem;font-weight:750}
  .related-review-copy{display:flex;min-width:0;flex-direction:column;align-items:flex-start;gap:.35rem}
  .related-review-copy h3{display:-webkit-box;overflow:hidden;margin:0;color:var(--vc-text);font-size:.95rem;line-height:1.45;-webkit-line-clamp:2;-webkit-box-orient:vertical}
  .related-review-copy>p{display:-webkit-box;overflow:hidden;margin:0;color:var(--vc-muted);font-size:.78rem;line-height:1.6;-webkit-line-clamp:3;-webkit-box-orient:vertical}
  .related-review-meta{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:auto;padding-top:.25rem}
  .related-review-meta span{padding:.2rem .42rem;border-radius:6px;background:rgba(240,153,54,.1);color:var(--vc-accent,#f09936);font-size:.66rem;font-weight:700}
  .related-review-card:focus-visible{outline:2px solid var(--vc-accent,#f09936);outline-offset:3px}
  @media(max-width:900px){.related-reviews-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:560px){.related-reviews{margin:1.8rem 0;border-radius:16px}.related-reviews-grid{grid-template-columns:1fr;gap:.65rem}.related-review-card{grid-template-columns:76px minmax(0,1fr);padding:.6rem}.related-review-copy>p{-webkit-line-clamp:2}}
  @media(prefers-reduced-motion:reduce){.related-review-card{transition:none}.related-review-card:hover{transform:none}}
</style>
