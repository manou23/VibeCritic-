---
import Base from '../../layouts/Base.astro';
import ScoreCard from '../../components/ScoreCard.astro';
import { getCollection, render } from 'astro:content';
import { TYPE_LABEL, fmtDate } from '../../consts';
export async function getStaticPaths(){const reviews=await getCollection('reviews');return reviews.map(review=>({params:{slug:review.id},props:{review}}));}
const {review}=Astro.props;const {Content}=await render(review);const d=review.data;
---
<Base title={d.title} description={d.summary}>
<article class="container max-w-4xl py-10">
<a href="../../" class="text-sm text-violet-300 hover:text-violet-200">← العودة للرئيسية</a>
{d.backdrop&&<img src={d.backdrop} alt="" class="mt-6 max-h-80 w-full rounded-3xl object-cover"/>}
<div class="mt-8 flex flex-wrap items-center gap-3 text-sm text-zinc-400"><span class="rounded-full bg-violet-500/15 px-3 py-1 text-violet-300">{TYPE_LABEL[d.type]}</span><time>{fmtDate(d.date)}</time>{d.aiGenerated&&<span class="rounded-full border border-white/10 px-3 py-1">مراجعة مولّدة بمساعدة الذكاء الاصطناعي</span>}</div>
<h1 class="mt-5 text-3xl font-black leading-tight sm:text-5xl">{d.title}</h1><p class="mt-4 text-lg leading-8 text-zinc-400">{d.headline}</p>
<div class="mt-8 grid gap-5 sm:grid-cols-[1fr_220px]"><div><h2 class="mb-3 text-xl font-bold">الخلاصة</h2><p class="leading-8 text-zinc-300">{d.summary}</p></div><ScoreCard score={d.score}/></div>
<div class="prose prose-invert mt-10 max-w-none"><Content/></div>
<div class="mt-10 grid gap-4 sm:grid-cols-2"><section class="glass rounded-2xl p-5"><h2 class="text-lg font-bold text-emerald-400">نقاط القوة</h2><ul class="mt-3 list-disc space-y-2 pr-5 text-zinc-300">{d.pros.map(x=><li>{x}</li>)}</ul></section><section class="glass rounded-2xl p-5"><h2 class="text-lg font-bold text-rose-400">نقاط الضعف</h2><ul class="mt-3 list-disc space-y-2 pr-5 text-zinc-300">{d.cons.map(x=><li>{x}</li>)}</ul></section></div>
{d.sourceUrl&&<p class="mt-8 text-sm text-zinc-500">المصدر: <a class="text-violet-300 underline" href={d.sourceUrl} target="_blank" rel="noreferrer">عرض المصدر الأصلي</a></p>}
</article>
</Base>
