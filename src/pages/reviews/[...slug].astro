---
import Base from '../../layouts/Base.astro';
import ScoreCard from '../../components/ScoreCard.astro';
import { getCollection, render } from 'astro:content';
import { TYPE_LABEL, fmtDate, url, optimizeImage, SITE_NAME } from '../../consts';
export async function getStaticPaths(){const reviews=await getCollection('reviews');return reviews.map(review=>({params:{slug:review.id},props:{review}}));}
const {review}=Astro.props;const {Content}=await render(review);const d=review.data;

const typeLabel = TYPE_LABEL[d.type];
const youtubeVideoId = /^[A-Za-z0-9_-]{11}$/.test(d.youtubeVideoId || '') ? d.youtubeVideoId : null;
const youtubeVideoTitle = d.youtubeVideoTitle || `المقطع الرسمي لـ ${d.title}`;
const typeKeyword = d.type === 'game' ? 'لعبة' : d.type === 'series' ? 'مسلسل' : 'فيلم';
const cleanKeyword = (value) => String(value || '').replace(/[<>"']/g, '').replace(/\s+/g, ' ').trim();
const reviewKeywords = [...new Set([
  d.title,
  d.originalTitle,
  typeKeyword + ' ' + d.title,
  'مراجعة ' + d.title,
  'تقييم ' + d.title,
  'قصة ' + d.title,
  'مراجعة ' + typeKeyword,
  'تقييم ' + typeKeyword,
  'مراجعة نقدية',
  'تحليل فني',
  ...(d.genres || []),
  ...(d.tags || []),
].map(cleanKeyword).filter(Boolean))].slice(0, 20);
const reviewDescription = d.title + ' — مراجعة ' + typeKeyword + ' وتحليل نقدي للقصة والعناصر الفنية. ' + d.summary + ' تقييم VibeCritic: ' + d.score + '/10.';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const schemaType = d.type === 'game' ? 'Game' : d.type === 'series' ? 'CreativeWorkSeries' : 'Movie';
const reviewStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  name: d.title + ' — مراجعة وتقييم',
  url: canonicalUrl,
  datePublished: d.date.toISOString().slice(0, 10),
  reviewBody: [d.summary, d.verdict, d.hook].filter(Boolean).join(' '),
  reviewRating: {
    '@type': 'Rating',
    ratingValue: d.score,
    bestRating: 10,
    worstRating: 0,
  },
  author: { '@type': 'Organization', name: SITE_NAME },
  itemReviewed: {
    '@type': schemaType,
    name: d.title,
    ...(d.originalTitle ? { alternateName: d.originalTitle } : {}),
    ...(d.genres?.length ? { genre: d.genres } : {}),
    ...(d.releaseDate ? { datePublished: d.releaseDate } : {}),
    ...(d.poster ? { image: optimizeImage(d.poster) } : {}),
  },
};

---
<Base title={`${d.title} — مراجعة وتقييم`} description={reviewDescription} keywords={reviewKeywords} structuredData={reviewStructuredData} image={optimizeImage(d.backdrop || d.poster, 'backdrop')} pageType="article" publishedAt={d.date.toISOString()}>
<article class="wrap article-page">
  <a href={url('')} class="article-back">← العودة إلى VibeCritic</a>
  <header class="article-header">
    <p class="eyebrow">VIBECRITIC / قراءة نقدية تحريرية</p>
    <div class="article-meta">
      <span class="article-category">{typeLabel}</span>
      <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
      {d.aiGenerated&&<span class="article-ai">تحليل مدعوم بالذكاء الاصطناعي</span>}
    </div>
    <h1>{d.title}</h1>
    <p class="article-deck">{d.headline}</p>
  </header>

  {d.backdrop&&<figure class="article-backdrop"><img src={optimizeImage(d.backdrop, 'backdrop')} alt={d.title} loading="eager" fetchpriority="high" decoding="async"/><figcaption>VibeCritic — قراءة نقدية بلا مجاملة</figcaption></figure>}

  <div class="article-layout">
    <div class="article-main">
      <section class="article-hook">
        <p class="eyebrow">المدخل النقدي</p>
        <p>{d.hook || d.headline}</p>
      </section>
      {youtubeVideoId && <section class="article-video" aria-labelledby="article-video-title">
        <div class="article-video-heading">
          <p class="eyebrow">من YouTube الرسمي</p>
          <h2 id="article-video-title">شاهد المقطع</h2>
        </div>
        <div class="article-video-frame">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${youtubeVideoId}`}
            title={youtubeVideoTitle}
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
        <p class="article-video-note">يُعرض المقطع عبر مشغل YouTube المضمّن؛ حقوق الفيديو وإتاحته تبقى لصاحب القناة وYouTube.</p>
      </section>}
      <section class="article-summary">
        <p class="eyebrow">عن العمل</p>
        <p>{d.summary}</p>
      </section>
      <div class="article-body prose"><Content/></div>
      <div class="article-verdict-grid">
        <section class="verdict-panel pros-panel">
          <h2><span>+</span> نقاط القوة</h2>
          <ul>{d.pros.map(x=><li>{x}</li>)}</ul>
        </section>
        <section class="verdict-panel cons-panel">
          <h2><span>−</span> نقاط الضعف</h2>
          <ul>{d.cons.map(x=><li>{x}</li>)}</ul>
        </section>
      </div>
      <section class="article-final-verdict">
        <p class="eyebrow">الحكم النهائي</p>
        <h2>هل يستحق وقتك؟</h2>
        <p>{d.verdict || 'تتحدد قيمة هذا العمل بحسب مدى اهتمامك بنوعه وعناصره الفنية، مع مراعاة نقاط القوة والتحفظات المذكورة أعلاه.'}</p>
      </section>
      <p class="review-method-note">منهجية VibeCritic: هذا تقييم تحريري مبني على المعلومات المنشورة والبيانات المتاحة، وليس ادعاءً باختبار مباشر للعمل. الدرجة تقدير نقدي مستقل وليست تقييماً رسمياً.</p>
      <a href={url('')} class="article-return">اكتشف مراجعات أخرى <span>←</span></a>
    </div>
    <aside class="article-aside">
      {d.poster&&<img class="article-poster" src={optimizeImage(d.poster)} alt={d.title} loading="lazy" decoding="async"/>}
      <div class="article-score-wrap"><p class="eyebrow">تقييم VibeCritic</p><ScoreCard score={d.score}/><p class="article-score-note">من 10 — رأينا، والقرار لك.</p></div>
    </aside>
  </div>
</article>
</Base>
