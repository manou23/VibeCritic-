---
import Base from '../../layouts/Base.astro';
import ScoreCard from '../../components/ScoreCard.astro';
import ReviewShare from '../../components/ReviewShare.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import { getCollection, render } from 'astro:content';
import { TYPE_LABEL, fmtDate, url, optimizeImage, SITE_NAME } from '../../consts';
import { scoreBandFor } from '../../../scripts/scoring-rubric.mjs';
export async function getStaticPaths(){const reviews=await getCollection('reviews');return reviews.map(review=>({params:{slug:review.id},props:{review}}));}
const {review}=Astro.props;const {Content}=await render(review);const d=review.data;
const allReviews=await getCollection('reviews');
const normalizeSimilarity=value=>String(value||'').toLocaleLowerCase('ar').normalize('NFKD').replace(/\p{M}/gu,'').replace(/[أإآٱ]/g,'ا').replace(/ة/g,'ه').replace(/ى/g,'ي').replace(/[^\p{L}\p{N}\s]/gu,' ').trim().replace(/\s+/g,' ');
const genericSimilarityTags=new Set(['indie','adventure','action','casual','simulator','singleplayer','multiplayer','arcade','simulation','puzzle','strategy','platformer','rpg','مغامرة','اكشن','مستقل','محاكاة','الغاز','استراتيجية'].map(normalizeSimilarity));
const setOf=values=>new Set((values||[]).map(normalizeSimilarity).filter(value=>value&&!genericSimilarityTags.has(value)));
const currentTags=setOf(d.tags),currentGenres=setOf(d.genres),currentYear=Number(String(d.releaseDate||'').slice(0,4))||null;
const similarityFor=entry=>{
 const tags=setOf(entry.data.tags),genres=setOf(entry.data.genres);
 const tagHits=[...currentTags].filter(value=>tags.has(value)).length;
 const genreHits=[...currentGenres].filter(value=>genres.has(value)).length;
 const year=Number(String(entry.data.releaseDate||'').slice(0,4))||null;
 const yearDistance=currentYear&&year?Math.abs(currentYear-year):99;
 const yearMatch=yearDistance===0?1:yearDistance<=2?.5:0;
 const score=tagHits*5+genreHits*1.5+yearMatch;
 return {entry,score,tagHits,genreHits,yearMatch};
};
const similarReviews=allReviews.filter(entry=>entry.id!==review.id&&entry.data.type===d.type)
 .map(similarityFor).filter(item=>item.tagHits>0||item.genreHits>=2)
 .sort((a,b)=>b.score-a.score||b.tagHits-a.tagHits||b.genreHits-a.genreHits)
 .slice(0,3);
const latestReviewsByType=allReviews
 .filter(entry=>entry.id!==review.id&&entry.data.type===d.type)
 .sort((a,b)=>new Date(b.data.publishedAt??b.data.date).getTime()-new Date(a.data.publishedAt??a.data.date).getTime())
 .slice(0,3);
const recommendedReviews=similarReviews.length?similarReviews:latestReviewsByType.map(entry=>({entry,tagHits:0,genreHits:0}));

const typeLabel = TYPE_LABEL[d.type];
const isPreview = d.reviewMode === 'preview';
const isLimited = d.reviewMode === 'limited';
const isAudience = d.reviewMode === 'audience';
const isGtaLaunchReading = isLimited && d.sourceId === 'manual-game-gta-vi-2026';
const hasFinalRating = !isPreview && !isLimited && !isAudience;
const scoreBand = hasFinalRating ? scoreBandFor(d.score) : null;
const youtubeVideoId = /^[A-Za-z0-9_-]{11}$/.test(d.youtubeVideoId || '') ? d.youtubeVideoId : null;
const youtubeVideoTitle = d.youtubeVideoTitle || `المقطع الرسمي لـ ${d.title}`;
const externalVideoUrl = /^https:\/\/media\.rawg\.io\//.test(d.externalVideoUrl || '') ? d.externalVideoUrl : null;
const externalVideoTitle = d.externalVideoTitle || `مقطع فيديو لـ ${d.title}`;
const typeKeyword = d.type === 'game' ? 'لعبة' : d.type === 'series' ? 'مسلسل' : 'فيلم';
const cleanKeyword = (value) => String(value || '').replace(/[<>"']/g, '').replace(/\s+/g, ' ').trim();
const reviewKeywords = [...new Set([
  d.title,
  d.originalTitle,
  typeKeyword + ' ' + d.title,
  'مراجعة ' + d.title,
  'تقييم ' + d.title,
  'قصة ' + d.title,
  'مراجعة ' + typeKeyword,
  'تقييم ' + typeKeyword,
  'مراجعة نقدية',
  'تحليل فني',
  ...(d.genres || []),
  ...(d.tags || []),
].map(cleanKeyword).filter(Boolean))].slice(0, 20);
const reviewDescription = d.title + ' — ' + (isPreview ? 'قراءة استباقية لـ' : isAudience ? 'تقييم الجمهور لـ' : isGtaLaunchReading ? 'قراءة إطلاق أولية لـ' : isLimited ? 'قراءة محدودة الأدلة لـ' : 'مراجعة ') + typeKeyword + ' وتحليل نقدي للقصة والعناصر الفنية. ' + d.summary + (isPreview ? ' هذه قراءة قبل الإصدار ولا تتضمن تقييماً نهائياً.' : isAudience ? ' تقييم الجمهور في ' + d.sourceName + ': ' + Number(d.sourceRating).toFixed(1) + '/' + d.sourceRatingScale + ' استناداً إلى ' + d.sourceVoteCount + ' صوتاً.' : isGtaLaunchReading ? ' بدأ الإصدار، لكن الصفحة لا تمنح درجة نهائية قبل اختبار مستقل كافٍ.' : isLimited ? ' لا تمنح هذه الصفحة تقييماً نهائياً لأن الأدلة المنشورة غير كافية.' : ' تقييم VibeCritic: ' + d.score + '/10.');
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const schemaType = d.type === 'game' ? 'Game' : d.type === 'series' ? 'CreativeWorkSeries' : 'Movie';
const reviewStructuredData = {
  '@context': 'https://schema.org',
  '@type': hasFinalRating ? 'Review' : 'Article',
  name: d.title + (isPreview ? ' — قراءة استباقية' : isGtaLaunchReading ? ' — قراءة إطلاق أولية' : isLimited ? ' — قراءة محدودة الأدلة' : ' — مراجعة وتقييم'),
  url: canonicalUrl,
  datePublished: (d.publishedAt ?? d.date).toISOString(),
  reviewBody: [d.summary, isLimited ? 'لا تتوفر أدلة كافية لمنح تقييم نهائي.' : d.verdict, d.hook].filter(Boolean).join(' '),
  ...(hasFinalRating ? { reviewRating: {
    '@type': 'Rating',
    ratingValue: d.score,
    bestRating: 10,
    worstRating: 0,
  } } : {}),
  author: { '@type': 'Organization', name: SITE_NAME },
  ...((hasFinalRating || isAudience) ? { itemReviewed: {
    '@type': schemaType,
    name: d.title,
    ...(d.originalTitle ? { alternateName: d.originalTitle } : {}),
    ...(d.genres?.length ? { genre: d.genres } : {}),
    ...(d.releaseDate ? { datePublished: d.releaseDate } : {}),
    ...(d.poster ? { image: optimizeImage(d.poster) } : {}),
    ...(Number(d.sourceRating) > 0 && Number(d.sourceVoteCount) > 0 ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: d.sourceRating, bestRating: d.sourceRatingScale || 10, worstRating: 0, ratingCount: d.sourceVoteCount } } : {}),
  } } : {}),

};

---
<Base title={`${d.title} — ${isPreview ? 'قراءة استباقية' : isLimited ? 'قراءة محدودة الأدلة' : 'مراجعة وتقييم'}`} description={reviewDescription} keywords={reviewKeywords} structuredData={reviewStructuredData} image={optimizeImage(d.backdrop || d.poster, 'backdrop')} pageType="article" publishedAt={(d.publishedAt ?? d.date).toISOString()} articleSection={typeLabel}>
<ReadingProgress />
<article class="wrap article-page">
  <nav class="article-breadcrumbs" aria-label="مسار الصفحة"><a href={url('')}>الرئيسية</a><span aria-hidden="true">/</span><a href={url(`category/${d.type}/`)}>{TYPE_LABEL[d.type]}</a><span aria-hidden="true">/</span><span aria-current="page">{d.title}</span></nav>
  <a href={url('')} class="article-back">← العودة إلى VibeCritic</a>
  <header class="article-header">
    <p class="eyebrow">VIBECRITIC / {isAudience ? "تحليل تقييم الجمهور" : "قراءة نقدية تحريرية"}</p>
    <div class="article-meta">
      <span class="article-category">{typeLabel}</span>
      {d.releaseDate && <span class="article-date-item"><strong>الإصدار</strong><time datetime={new Date(`${d.releaseDate}T00:00:00Z`).toISOString()}>{fmtDate(new Date(`${d.releaseDate}T00:00:00Z`))}</time></span>}
      <span class="article-date-item article-published-date"><strong>نُشرت</strong><time datetime={(d.publishedAt ?? d.date).toISOString()}>{fmtDate(d.publishedAt ?? d.date)}</time></span>
      {d.aiGenerated&&<span class="article-ai">تحليل مدعوم بالذكاء الاصطناعي</span>}
      {!d.aiGenerated && d.editorialWorkflow === 'manual-assisted' && <span class="article-ai">مراجعة أُعدّت بمساعدة الذكاء الاصطناعي وخضعت للمراجعة التحريرية</span>}
      {isPreview && <span class="article-ai">قراءة استباقية — قبل الإصدار</span>}
      {isAudience && <span class="article-ai">تقييم الجمهور — {d.sourceName}</span>}
      {isLimited && <span class="article-ai">{isGtaLaunchReading ? 'قراءة الإطلاق — الدرجة النهائية لم تصدر بعد' : 'لا يوجد تقييم نهائي — الأدلة غير كافية'}</span>}
    </div>
    <h1>{d.title}</h1>
    {d.originalTitle && d.originalTitle !== d.title && <p class="article-original-title" lang="en" dir="auto">{d.originalTitle}</p>}
    <p class="article-deck">{d.headline}</p>
  </header>

  {(d.backdrop || d.poster)&&<figure class="article-backdrop"><img data-review-media-image data-fallback-src={d.poster && d.poster !== d.backdrop ? optimizeImage(d.poster) : undefined} src={optimizeImage(d.backdrop || d.poster, d.backdrop ? 'backdrop' : 'poster')} alt={d.title} loading="eager" fetchpriority="high" decoding="async"/><figcaption>VibeCritic — قراءة نقدية بلا مجاملة</figcaption></figure>}

  <div class="article-layout">
    <div class="article-main">
      <section class="article-hook">
        <p class="eyebrow">المدخل النقدي</p>
        <p>{d.hook || d.headline}</p>
      </section>
      {(youtubeVideoId || externalVideoUrl) && <section class="article-video" aria-labelledby="article-video-title">
        <div class="article-video-heading"><p class="eyebrow">{youtubeVideoId ? 'من YouTube الرسمي' : 'مقطع من بيانات RAWG'}</p><h2 id="article-video-title">شاهد المقطع</h2></div>
        <div class="article-video-frame">
          {youtubeVideoId ? <div data-youtube-facade data-video-id={youtubeVideoId} data-video-title={youtubeVideoTitle}>
            <button class="youtube-facade-button" type="button" aria-label="تشغيل المقطع">
              <img src={`https://i.ytimg.com/vi/${youtubeVideoId}/hqdefault.jpg`} data-fallback-src={optimizeImage(d.backdrop || d.poster || '', 'backdrop')} alt={`صورة معاينة فيديو ${d.title}`} loading="lazy" decoding="async" width="480" height="360"/>
              <span class="youtube-play-icon" aria-hidden="true">▶</span>
            </button>
          </div> : <video controls preload="none" playsinline poster={optimizeImage(d.backdrop || d.poster || '', 'backdrop')} aria-label={externalVideoTitle}>
            <source src={externalVideoUrl} type="video/mp4"/>
            متصفحك لا يدعم تشغيل الفيديو.
          </video>}
        </div>
        {youtubeVideoId && <p class="article-video-fallback"><a href={`https://www.youtube.com/watch?v=${youtubeVideoId}`} target="_blank" rel="noopener noreferrer">إذا لم يعمل المشغل، شاهد الفيديو مباشرة على YouTube ↗</a></p>}
        <p class="article-video-note">{youtubeVideoId ? 'لن يتم تحميل مشغل YouTube أو الاتصال به إلا عند النقر على التشغيل.' : 'يبدأ تحميل الفيديو عند تشغيله فقط.'}</p>
      </section>}
      <section class="article-summary">
        <p class="eyebrow">عن العمل</p>
        <p>{d.summary}</p>
      </section>
      <div class="article-body prose"><Content/></div>
      <div class="article-verdict-grid">
        <section class="verdict-panel pros-panel">
          <h2><span>+</span> {isPreview ? 'عناصر واعدة' : isLimited ? 'معلومات يمكن تأكيدها' : 'نقاط القوة'}</h2>
          <ul>{d.pros.map(x=><li>{x}</li>)}</ul>
        </section>
        <section class="verdict-panel cons-panel">
          <h2><span>−</span> {isPreview || isLimited ? 'معلومات وأسئلة غير محسومة' : 'نقاط الضعف'}</h2>
          {d.cons.length>0?<ul>{d.cons.map(x=><li>{x}</li>)}</ul>:<p>لم تتوفر تحفظات موثوقة كافية لإثبات نقاط ضعف محددة.</p>}
        </section>
      </div>
      <section class="article-final-verdict">
        <p class="eyebrow">{isPreview ? 'الخلاصة الاستباقية' : isLimited ? 'حدود المادة الحالية' : 'الحكم النهائي'}</p>
        <h2>{isPreview ? 'ما الذي ننتظره عند الإصدار؟' : isGtaLaunchReading ? 'ما الذي نعرفه بعد الإطلاق؟' : isLimited ? 'لماذا لا نمنحه درجة الآن؟' : 'هل يستحق وقتك؟'}</h2>
        <p>{isGtaLaunchReading ? 'بدأ الإطلاق العالمي بالفعل، لكن صدور اللعبة لا يساوي اكتمال مراجعتها. لا ننسب إلى VibeCritic تجربة لعب لم تُختبر وتُوثق، ولا نمنح درجة رقمية اعتماداً على العروض أو آراء مراجعين آخرين. سنحدّث الحكم عندما تتوفر أدلة مستقلة كافية عن الأداء والأنظمة والإيقاع والمحتوى.' : isLimited ? 'المعلومات المتاحة هنا لا تكفي للحكم على جودة التنفيذ الفعلي أو منح العمل درجة عادلة. لذلك أوقفنا التقييم الرقمي مؤقتاً بدلاً من تحويل الوصف المختصر أو التوقعات إلى حكم نقدي. ستعود الدرجة عندما تتوفر مراجعة موثقة وتحليل للعناصر الفنية.' : d.verdict || 'تتحدد قيمة هذا العمل بحسب مدى اهتمامك بنوعه وعناصره الفنية، مع مراعاة نقاط القوة والتحفظات المذكورة أعلاه.'}</p>
      </section>
      {(d.cast?.length || d.crew?.length) && <section class="article-facts" aria-label="طاقم العمل">
        <h2>طاقم العمل</h2>
        {d.cast?.length>0 && <p><strong>أبرز المشاركين:</strong> {d.cast.join('، ')}</p>}
        {d.crew?.length>0 && <p><strong>الإخراج / الإبداع:</strong> {d.crew.join('، ')}</p>}
      </section>}
      {d.type === 'game' ? ((d.platforms?.length || d.gameStores?.length) > 0 && <section class="article-facts" aria-label="منصات اللعب والمتاجر">
        <h2>أين تلعبه؟</h2>
        {d.platforms?.length > 0 && <p><strong>المنصات:</strong> {d.platforms.join('، ')}</p>}
        {d.gameStores?.some(store=>store.url) && <p class="game-store-links"><strong>المتاجر:</strong> {d.gameStores.filter(store=>store.url).map(store=><a href={store.url} target="_blank" rel="noopener noreferrer">{store.name}</a>)}</p>}
      </section>) : (((d.watchProviders?.length ?? 0) > 0 || Boolean(d.watchProviderUrl)) && <section class="article-facts" aria-label="أماكن المشاهدة">
        <h2>أين أشاهده؟</h2>
        {d.watchProviders?.length>0 && <p>المنصات المتاحة في الجزائر بحسب بيانات TMDB: {d.watchProviders.join('، ')}</p>}
        {d.watchProviderUrl && <a href={d.watchProviderUrl} target="_blank" rel="noopener noreferrer">تحقق من خيارات المشاهدة على TMDB ↗</a>}
      </section>)}
      {d.sourceUrl && <section class="article-facts" aria-label="مصدر بيانات العمل"><h2>مصدر البيانات</h2><p>بيانات العمل الأساسية مستندة إلى {d.sourceName || 'المصدر المدرج'}؛ وهي مرجع للمعلومات الوصفية وليست حكماً نقدياً مستقلاً.</p><a href={d.sourceUrl} target="_blank" rel="noopener noreferrer">عرض صفحة العمل في المصدر ↗</a></section>}
      {recommendedReviews.length>0 && <section class="related-reviews" aria-labelledby="related-reviews-title">
        <div class="related-reviews-heading">
          <p class="eyebrow">{similarReviews.length>0 ? 'قد يثير اهتمامك أيضاً' : 'واصل الاستكشاف'}</p>
          <h2 id="related-reviews-title">{similarReviews.length>0 ? 'مراجعات قريبة من هذا العمل' : 'أحدث مراجعات '+typeLabel}</h2>
          <p>{similarReviews.length>0 ? 'اخترنا هذه الأعمال اعتماداً على النوع والموضوعات المشتركة، لا على التقييم وحده.' : 'لم نعثر على تشابه موضوعي كافٍ؛ إليك أحدث المراجعات من الفئة نفسها لتواصل الاستكشاف.'}</p>
        </div>
        <div class="related-reviews-grid">
          {recommendedReviews.map(({entry,tagHits}) => <a class="related-review-card" href={url('reviews/'+entry.id+'/')}>
            <div class="related-review-poster">
              {entry.data.poster ? <img src={optimizeImage(entry.data.poster)} alt={entry.data.title} loading="lazy" decoding="async" width="342" height="513"/> : <span aria-hidden="true">✦</span>}
              <span class="related-review-type">{TYPE_LABEL[entry.data.type]}</span>
            </div>
            <div class="related-review-copy">
              <h3>{entry.data.title}</h3>
              <p>{entry.data.headline}</p>
              <div class="related-review-meta">
                <span>{entry.data.reviewMode === 'preview' ? 'قراءة استباقية' : entry.data.reviewMode === 'limited' ? 'قيد التقييم' : entry.data.score.toFixed(1) + ' / 10'}</span>
                <span>{similarReviews.length>0 ? (tagHits>0 ? 'موضوعات مشتركة' : 'تصنيفات متقاربة') : 'أحدث مراجعة'}</span>
              </div>
            </div>
          </a>)}
        </div>
      </section>}
      <p class="review-method-note">{isPreview ? 'منهجية VibeCritic: هذه قراءة استباقية تفصل المعلومات الرسمية عن التوقعات، ولا تمنح العمل تقييماً نهائياً قبل صدوره.' : isLimited ? 'منهجية VibeCritic: لا نعرض درجة عندما تكون الأدلة المتاحة غير كافية. هذه الصفحة مادة تعريفية محدودة وليست حكماً نقدياً نهائياً.' : 'منهجية VibeCritic: هذا تحليل نقدي مبني على المعلومات المنشورة والبيانات المتاحة، وليس ادعاءً باختبار مباشر للعمل. التقييم تقدير تحريري مستقل وليس تقييماً رسمياً.'}</p>
      <section class="article-facts article-feedback" aria-labelledby="review-feedback-title">
        <h2 id="review-feedback-title">هل أفادتك هذه المراجعة؟</h2>
        <p>شاركنا رأيك السريع؛ اختيارك يُحفظ على هذا الجهاز فقط.</p>
        <div class="review-feedback-actions">
          <button type="button" data-review-vote="yes" aria-pressed="false" aria-label="أعجبتني هذه المراجعة"><span aria-hidden="true">👍</span> أعجبتني</button>
          <button type="button" data-review-vote="no" aria-pressed="false" aria-label="لم تعجبني هذه المراجعة"><span aria-hidden="true">👎</span> لم تعجبني</button>
        </div>
        <p class="review-feedback-status" data-review-feedback-status role="status" aria-live="polite">لن نعرض أرقاماً مضللة؛ هذا التصويت محلي ولا يمثل مجموع آراء الزوار.</p>
      </section>
      <a href={url('')} class="article-return">اكتشف مراجعات أخرى <span>←</span></a>
    </div>
    <aside class="article-aside" aria-label="ملخص ومعلومات العمل">
      {d.poster&&<img data-review-media-image data-fallback-src={d.backdrop && d.backdrop !== d.poster ? optimizeImage(d.backdrop, 'backdrop') : undefined} class="article-poster" src={optimizeImage(d.poster)} alt={d.title} loading="lazy" decoding="async" width="600" height="900"/>}
      <div class="article-score-wrap"><p class="eyebrow">{hasFinalRating ? 'تقييم VibeCritic' : isAudience ? 'تقييم الجمهور' : 'حالة التقييم'}</p>{isAudience ? <><ScoreCard score={d.audienceScore ?? (Number(d.sourceRating) / Number(d.sourceRatingScale) * 10)} label={`تقييم الجمهور — ${d.sourceName || 'المصدر'}`}/><p class="article-score-note">متوسط المستخدمين: {Number(d.sourceRating).toFixed(1)}/{d.sourceRatingScale} · {Number(d.sourceVoteCount).toLocaleString('ar')} صوتاً{d.sourceRatingCheckedAt ? ` · جُمعت البيانات ${fmtDate(new Date(d.sourceRatingCheckedAt))}` : ""}. هذا ليس تقييماً تحريرياً من VibeCritic.</p></> : isPreview ? <p class="article-score-note">لا توجد درجة نهائية قبل الإصدار؛ هذه قراءة استباقية لما نعرفه وما ننتظره من العمل.</p> : isLimited ? <p class="article-score-note">لا نعرض درجة حالياً؛ المعلومات المتاحة لا تسمح بحكم نقدي موثوق. ستُراجع الصفحة عند توفر أدلة كافية.</p> : <><ScoreCard score={d.score} label="تقييم VibeCritic"/><p class="article-score-note">{scoreBand?.label || "تقييم تحريري مستقل"} · من 10 — رأينا، والقرار لك.</p></>}
        {hasFinalRating && (d.storyScore !== undefined || d.visualsScore !== undefined || d.soundScore !== undefined || d.pacingScore !== undefined) && <div class="score-breakdown" aria-label="الدرجات الفرعية">
          {([{label:'القصة',value:d.storyScore},{label:'الصورة',value:d.visualsScore},{label:'الصوت',value:d.soundScore},{label:'الإيقاع',value:d.pacingScore}]).filter(item=>Number.isFinite(item.value)).map(item=><div class="score-breakdown-row"><div><span>{item.label}</span><strong>{Number(item.value).toFixed(1)}/10</strong></div><span class="score-breakdown-track"><i style={`--score-fill:${Number(item.value)*10}%`}></i></span></div>)}
        </div>}
        {hasFinalRating && Number(d.sourceRating) > 0 && <p class="article-score-note">تقييم {d.sourceName || 'المصدر'}: {Number(d.sourceRating).toFixed(1)}/{d.sourceRatingScale || 10}{Number(d.sourceVoteCount) > 0 ? ` · ${d.sourceVoteCount} تقييم` : ''}</p>}
        {hasFinalRating && Number(d.metacriticScore) > 0 && <p class="article-score-note">Metacritic: {Number(d.metacriticScore).toFixed(0)}/100</p>}</div>
      {(d.releaseDate || d.creator || d.genres?.length) && <section class="article-facts" aria-label="معلومات العمل">
        <h2>بطاقة العمل</h2>
        <dl>
          {d.releaseDate && <div><dt>تاريخ الإصدار</dt><dd>{d.releaseDate}</dd></div>}
          {d.creator && <div><dt>الجهة</dt><dd>{d.creator}</dd></div>}
          {d.genres?.length > 0 && <div><dt>التصنيف</dt><dd>{d.genres.join('، ')}</dd></div>}
        </dl>
      </section>}
    </aside>
  </div>

  <ReviewShare title={d.title} shareUrl={canonicalUrl} />
</article>
</Base>

<script>
const voteButtons=[...document.querySelectorAll<HTMLButtonElement>('[data-review-vote]')];
const voteStatus=document.querySelector<HTMLElement>('[data-review-feedback-status]');
const voteKey='vc-review-feedback:'+"REVIEW_SLUG_PLACEHOLDER";
const currentVoteKey=voteKey.replace('REVIEW_SLUG_PLACEHOLDER',location.pathname);
const paintVote=(value:string|null)=>{
 voteButtons.forEach(button=>{
  const active=button.dataset.reviewVote===value;
  button.setAttribute('aria-pressed',String(active));
  button.classList.toggle('is-selected',active);
 });
 if(voteStatus)voteStatus.textContent=value?'شكراً لمشاركتك؛ تم حفظ اختيارك على هذا الجهاز.':'لن نعرض أرقاماً مضللة؛ هذا التصويت محلي ولا يمثل مجموع آراء الزوار.';
};
let savedVote:string|null=null;
try{savedVote=localStorage.getItem(currentVoteKey);}catch{}
paintVote(savedVote);
voteButtons.forEach(button=>button.addEventListener('click',()=>{
 const value=button.dataset.reviewVote||'';
 if(value!=='yes'&&value!=='no')return;
 try{localStorage.setItem(currentVoteKey,value);}catch{}
 paintVote(value);
}));
document.querySelectorAll<HTMLImageElement>('[data-review-media-image][data-fallback-src], .youtube-facade-button img[data-fallback-src]').forEach((img)=>{
 img.addEventListener('error',()=>{
  const fallback=img.dataset.fallbackSrc;
  if(fallback&&img.src!==fallback)img.src=fallback;
 },{once:true});
});
document.querySelectorAll<HTMLElement>('[data-youtube-facade]').forEach((facade)=>{
 const button=facade.querySelector<HTMLButtonElement>('.youtube-facade-button');
 button?.addEventListener('click',()=>{
  const id=facade.dataset.videoId;
  if(!id)return;
  const frame=document.createElement('iframe');
  frame.src='https://www.youtube-nocookie.com/embed/'+encodeURIComponent(id)+'?autoplay=1';
  frame.title=facade.dataset.videoTitle||"مقطع YouTube";
  frame.loading='eager';
  frame.referrerPolicy='strict-origin-when-cross-origin';
  frame.allow='accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share';
  frame.allowFullscreen=true;
  facade.replaceChildren(frame);
 },{once:true});
});
</script>

