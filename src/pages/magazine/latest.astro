---
import Base from '../../layouts/Base.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import { getCollection } from 'astro:content';
const latest=(await getCollection('reviews')).sort((a,b)=>(b.data.publishedAt??b.data.date).valueOf()-(a.data.publishedAt??a.data.date).valueOf());
---
<Base title="أحدث المراجعات" description="تابع أحدث مراجعات VibeCritic للألعاب والأفلام والمسلسلات حسب وقت النشر.">
<section class="wrap magazine-page-hero"><p class="catalog-eyebrow">LATEST / VIBECRITIC</p><h1>أحدث المراجعات</h1><p>كل ما نُشر حديثاً في VibeCritic، مرتباً حسب تاريخ النشر الفعلي حتى تصل إلى الجديد أولاً.</p></section>
<section class="wrap catalog-section"><div class="catalog-heading"><div><p class="catalog-eyebrow">NEWEST FIRST</p><h2>آخر الإضافات</h2><p>الترتيب حسب وقت النشر، لا حسب تاريخ إصدار العمل.</p></div><span class="catalog-total">{latest.length} مراجعة</span></div>
{latest.length?<div class="editorial-grid">{latest.map(review=><ReviewCard review={review}/>)}</div>:<div class="catalog-empty">لا توجد مراجعات منشورة بعد.</div>}
</section>
<style>
.magazine-page-hero{padding:2.5rem 0 1rem}.magazine-page-hero h1{font-size:clamp(2rem,5vw,3.5rem);margin:.35rem 0}.magazine-page-hero>p:last-child{max-width:760px;color:var(--vc-muted);line-height:1.9}
.editorial-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr));gap:1.2rem}
</style>
</Base>