---
import { TYPE_LABEL, url, fmtDate } from '../consts';
const { review } = Astro.props;
const data = review.data;
const href = url(`reviews/${review.id}/`);
---
<a href={href} class="review-card glass group overflow-hidden rounded-2xl">
<div class="relative overflow-hidden">
{data.poster ? <img src={data.poster} alt={data.title} loading="lazy" class="poster w-full transition duration-500 group-hover:scale-105"/> : <div class="poster flex items-center justify-center text-5xl text-violet-300">✦</div>}
<span class="absolute right-3 top-3 rounded-full bg-black/70 px-3 py-1 text-xs text-white">{TYPE_LABEL[data.type]}</span>
<span class="absolute bottom-3 left-3 rounded-lg bg-violet-600 px-2 py-1 text-sm font-bold text-white">{data.score.toFixed(1)}/10</span>
</div>
<div class="p-4"><h3 class="line-clamp-1 font-bold text-white">{data.title}</h3><p class="mt-2 line-clamp-2 text-sm leading-6 text-zinc-400">{data.headline}</p><p class="mt-3 text-xs text-zinc-500">{fmtDate(data.date)}</p></div>
</a>
