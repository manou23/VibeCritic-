---
import { TYPE_LABEL, url, fmtDate, optimizeImage, responsivePosterSrcSet } from '../consts';
const { review } = Astro.props;
const data = review.data;
const displayDate = data.releaseDate ? new Date(`${data.releaseDate}T00:00:00Z`) : data.date;
const href = url(`reviews/${review.id}/`);
---
<a href={href} class="review-card group" aria-label={`${TYPE_LABEL[data.type]}: ${data.title}${data.reviewMode === 'preview' ? ' — قراءة استباقية قبل الإصدار' : data.reviewMode === 'limited' ? ' — قراءة محدودة الأدلة بلا تقييم نهائي' : ' — التقييم ' + data.score.toFixed(1) + ' من 10'}`}>
<div class="review-poster-wrap">
{data.poster ? <img src={optimizeImage(data.poster)} srcset={responsivePosterSrcSet(data.poster)||undefined} sizes="(max-width: 640px) 42vw, (max-width: 1024px) 22vw, 220px" alt={data.title} loading="lazy" decoding="async" class="review-poster" width="600" height="900"/> : <div class="review-poster grid place-items-center text-5xl text-[#e45c38]">✦</div>}
<span class="review-type">{TYPE_LABEL[data.type]}</span>
{data.reviewMode === 'preview' ? <span class="review-score">استباقية</span> : data.reviewMode === 'limited' ? <span class="review-score">قيد التقييم</span> : <span class="review-score">{data.score.toFixed(1)} <small>/10</small></span>}
</div>
<div class="review-content">
<h3 class="review-title">{data.title}</h3>
<p class="review-headline">{data.headline}</p>
<time class="review-date" datetime={displayDate.toISOString()}>{fmtDate(displayDate)}</time>
</div>
</a>
