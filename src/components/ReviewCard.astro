---
import { TYPE_LABEL, url, fmtDate, optimizeImage } from '../consts';
const { review } = Astro.props;
const data = review.data;
const href = url(`reviews/${review.id}/`);
---
<a href={href} class="review-card group vc-review-card" aria-label={`${TYPE_LABEL[data.type]}: ${data.title}${data.reviewMode === 'preview' ? ' — قراءة استباقية قبل الإصدار' : data.reviewMode === 'limited' ? ' — قراءة محدودة الأدلة بلا تقييم نهائي' : ' — التقييم ' + data.score.toFixed(1) + ' من 10'}`}>
 <div class="review-poster-wrap">
  {data.poster ? <img src={optimizeImage(data.poster)} alt={data.title} loading="lazy" decoding="async" class="review-poster" width="600" height="900"/> : <div class="review-poster grid place-items-center text-5xl">✳</div>}
  <span class="review-type">{TYPE_LABEL[data.type]}</span>
  <span class="review-score">{data.reviewMode === 'preview' ? 'قريباً' : data.reviewMode === 'limited' ? 'محدودة' : <>{data.score.toFixed(1)}<small>/10</small></>}</span>
  <span class="vc-card-open" aria-hidden="true">↗</span>
 </div>
 <div class="review-content">
  <div class="review-card-overline"><span>VC / {data.type==='game'?'PLAY':data.type==='series'?'WATCH':'CINEMA'}</span><time datetime={data.date.toISOString()}>{fmtDate(data.date)}</time></div>
  <h3 class="review-title">{data.title}</h3>
  <p class="review-headline">{data.headline}</p>
 </div>
</a>